      if (dd > R || dd < 0.01) continue;
      const k = 1 - dd / R;
      o.vel.x += dx / dd * 16 * k; o.vel.z += dz / dd * 16 * k; o.vel.y = 8 * k + 3;
      o.onGround = false; o.knockT = 0.7;
    }
    G.shake = Math.max(G.shake, G.player && G.player.pos.distanceTo(p) < 25 ? 0.6 : 0);
  },
};

// ---- powers.js ----
'use strict';
// ===== Boss powers: finish Doctor Doom, Iron Man or Thanos and you become them =====
// Doom (Arcane Gauntlets): bolts on click, R Unstable Bolt, G Ground Pound
// Iron Man (Combat Kit): repulsors on click, R Unibeam, G micro-missiles, hold Space in the air to fly
// Thanos (Infinity Gauntlet): R cycles the six stones, click uses the selected one, G snaps (once a match)
// Adam Smasher: arm cannon, R swaps to the hand laser. Kits stack: beat several bosses and press 6
// to cycle between them; passives (flight, self-repair, auto-aim, Time Stone recording) stay on.
const POWER_DEFS = {
  doom: { short: 'Doom', name: 'Doctor Doom', outfit: 'doom', size: 1.25, weapon: 'arcane', hp: 500, shield: 100, speed: 1.35, cdR: 6, cdG: 9 },
  ironman: { short: 'Iron Man', name: 'Iron Man', outfit: 'ironman', size: 1.1, weapon: 'repulsor', hp: 450, shield: 100, speed: 1.45, cdR: 9, cdG: 8 },
  thanos: { short: 'Thanos', name: 'Thanos', outfit: 'thanos', size: 1.6, weapon: 'gauntlet', hp: 650, shield: 100, speed: 1.2, cdR: 0, cdG: 0 },
  lebron: { short: 'LeBron', name: 'LeBron James', outfit: 'lebron', size: 1.25, weapon: 'ball_lebron', hp: 600, shield: 100, speed: 1.5, cdR: 0, cdG: 7 },
  adam: { short: 'Adam', name: 'Adam Smasher', outfit: 'adam', size: 1.5, weapon: 'armcannon', hp: 500, shield: 100, speed: 1.9, cdR: 0, cdG: 0 },
};
ultronize.powersReady = true; // (boss.js loads first: POWER_DEFS only exists from here on)
if (Date.now() >= ULTRON_EVENT) ultronize(); // after the live event Thanos's kit belongs to Infinity Ultron
const STONES = [
  { id: 'power', name: 'Power Stone', color: '#b04aff', cd: 2.5 },
  { id: 'space', name: 'Space Stone', color: '#3d7bff', cd: 4 },
  { id: 'reality', name: 'Reality Stone', color: '#ff3b3b', cd: 18 },
  { id: 'soul', name: 'Soul Stone', color: '#ff9a1f', cd: 0 },
  { id: 'time', name: 'Time Stone', color: '#2fd46b', cd: 22 },
  { id: 'mind', name: 'Mind Stone', color: '#ffd84a', cd: 22 },
];

const POWERS = {
  el: null,

  // turn k into the boss they just beat
  grant(k, id, remote) {
    const P = POWER_DEFS[id];
    if (!remote) { NET.onGrant(k, id); if (NET.client && k.isPlayer) NET.ev({ t: 'gr', n: k.nid, id }); }
    if (!k.pw) k.pw = { kits: [], cd: {}, stone: 0, stoneCd: {}, fuel: 3, pound: false, beamT: 0, beamTick: 0, hist: [], histT: 0, snapped: false };
    const pw = k.pw;
    if (!pw.kits.includes(id)) pw.kits.push(id);
    k.power = id;
    if (id === 'thanos' && BOSS_TYPES.thanos.ultron) k.aimbot = true; // Infinity Ultron's Gauntlet aims itself
    if (id === 'adam') { k.isSmasher = true; k.dmgMult = Math.max(k.dmgMult || 1, 1.25); }
    // stacked bosses: fastest speed, best health plus 100 per extra kit, full shield
    k.speedMult = Math.max(...pw.kits.map(x => POWER_DEFS[x].speed));
    k.dmgMult = Math.max(k.dmgMult || 1, 1.15);
    k.maxHp = Math.max(...pw.kits.map(x => POWER_DEFS[x].hp)) + 100 * (pw.kits.length - 1);
    k.hp = k.maxHp; k.shield = Math.max(k.shield, P.shield);
    BOSS.giveBody(k, k.forceOutfit || P.outfit, k.forceSize || P.size);
    CHARS.attachModel(k);
    k.model.root.visible = true;
    k.slots[5] = { kind: 'weapon', id: P.weapon, rarity: 5, mag: 9999, special: true };
    CHARS.equip(k, 5);
    if (k.isPlayer) {
      k.paid = k.paid || {}; const pay = !k.paid[id]; k.paid[id] = true; // dropping and re-grabbing doesn't pay again
      if (pay) { PROFILE.data.coins += 500; PROFILE.save(); }
      const stack = pw.kits.length > 1 ? ` · ${pw.kits.length} bosses stacked: press 6 to switch` : '';
      const how = id === 'adam' ? '500+ HP that heals itself · auto-aim · R swaps arm cannon / hand laser' : id === 'doom' ? 'Click: arcane bolts · R: Unstable Bolt · G: Ground Pound · Y: call Doombots'
        : id === 'ironman' ? 'Click: repulsors · R: Unibeam · G: micro-missiles · hold Space in the air to fly'
          : id === 'lebron' ? 'Click: throw basketballs · G: Slam Dunk · Space in the air: double jump'
            : 'R: switch stone · Click: use it · G: SNAP (once)' + (k.aimbot ? ' · AIMBOT' : '');
      if (!k.ultronForm) HUD.banner('YOU ARE ' + P.name.toUpperCase(), (pay ? '+500 Lunch Money · ' : '') + how + stack);
      SFX.play('victory', 0.6);
    } else HUD.killfeedText(`<b>${esc(k.name)}</b> became <b>${P.name}</b>`);
  },

  // drop a boss power on purpose (T while holding it): the kit leaves, the body goes back once none are left
  revoke(k, id, remote) {
    const pw = k.pw; if (!pw || !pw.kits.includes(id)) return;
    if (!remote) { if (NET.host) NET.broadcast({ t: 'revoke', n: k.nid, id }); if (NET.client && k.isPlayer) NET.ev({ t: 'rv', n: k.nid, id }); }
    pw.kits.splice(pw.kits.indexOf(id), 1);
    if (id === 'adam') k.isSmasher = false;
    if (id === 'thanos') k.aimbot = false;
    if (pw.kits.length) {
      k.speedMult = Math.max(...pw.kits.map(x => POWER_DEFS[x].speed));
      k.maxHp = Math.max(...pw.kits.map(x => POWER_DEFS[x].hp)) + 100 * (pw.kits.length - 1); k.hp = Math.min(k.hp, k.maxHp);
      this.switchKit(k, pw.kits[0]);
      return;
    }
    k.pw = null; k.power = null; k.isSmasher = false; k.aimbot = false; k.dmgMult = 1; k.speedMult = 1;
    k.maxHp = 100; k.hp = Math.min(k.hp, 100); k.slots[5] = null;
    k.size = 1; k.height = 1.85; k.radius = 0.45;
    if (k.model) CHARS.removeModel(k);
    CHARS.buildModel(k, k.colors0, { hi: k.isPlayer });
    CHARS.attachModel(k); k.model.root.visible = true; k.heldKey = '';
    CHARS.equip(k, -1);
    if (k.isPlayer) this.reset();
  },

  callBots(c) {
    for (const b of BOTS.list) if (b.owner === c && b.alive) CHARS.damage(b, 999, null);
    BOTS.summonDoombots(c);
  },

  // ---------- player input (called from PC.update) ----------
  // returns true when it used the click itself (so the normal weapon doesn't also fire)
  input(c, P, K) {
    const pw = c.pw;
    if (!pw) return false;
    // 6 while already holding your kit cycles through every boss you've stacked
    if (P.has('Digit6')) {
      P.delete('Digit6');
      if (c.sel === 5 && !c.buildType && pw.kits.length > 1) this.switchKit(c, pw.kits[(pw.kits.indexOf(c.power) + 1) % pw.kits.length]);
      else CHARS.equip(c, 5);
    }
    const id = c.power, cd = pw.cd[id] || (pw.cd[id] = { R: 0, G: 0 });
    const holding = c.sel === 5 && !c.buildType;
    if (P.has('KeyR') && holding) {
      P.delete('KeyR');
      if (id === 'thanos') { pw.stone = (pw.stone + 1) % STONES.length; SFX.play('click', 0.6); HUD.toast(STONES[pw.stone].name); }
      else if (id === 'adam') { const s = c.slots[5]; s.id = s.id === 'armcannon' ? 'laser' : 'armcannon'; c.heldKey = ''; SFX.play('reload', 0.5); HUD.toast(WEAPONS[s.id].name); }
      else if (cd.R <= 0) { cd.R = POWER_DEFS[id].cdR; id === 'doom' ? this.unstableBolt(c) : this.unibeam(c); }
    }
    // Y as Doom: call 3 Doombots (once every 45 s, the old ones are recalled)
    if (P.has('KeyY') && id === 'doom') {
      P.delete('KeyY');
      if (NET.inMatch) HUD.toast('Doombots only work in solo matches for now');
      else if (G.time < (pw.botsT || 0)) HUD.toast('Doombots ready in ' + Math.ceil(pw.botsT - G.time) + 's');
      else { pw.botsT = G.time + 45; SFX.play('cannon', 0.6); HUD.toast('Doombots, to me!'); this.callBots(c); }
    }
    if (P.has('KeyG')) {
      if (id === 'doom' && cd.G <= 0 && c.onGround) { cd.G = POWER_DEFS.doom.cdG; this.groundPound(c); }
      else if (id === 'ironman' && cd.G <= 0) { cd.G = POWER_DEFS.ironman.cdG; this.missiles(c); }
      else if (id === 'thanos') this.snap(c);
      else if (id === 'lebron' && cd.G <= 0) { cd.G = POWER_DEFS.lebron.cdG; this.slamDunk(c); }
    }
    // Iron Man's thrusters work with any kit once you've beaten him
    if (pw.kits.includes('ironman') && K.Space && !c.onGround && pw.fuel > 0) { c.vel.y = Math.min(9, c.vel.y + (GRAVITY + 16) * (1 / 60)); pw.fuel -= 1 / 60; c.flying = true; }
    // LeBron: double jump, and the click throws a basketball
    if (pw.kits.includes('lebron') && P.has('Space') && !c.onGround && !pw.dj) { P.delete('Space'); pw.dj = true; c.vel.y = 11; SFX.play('swing', 0.5); }
    if (id === 'lebron' && holding && INPUT.lmb) { if (c.fireCd <= 0) { c.fireCd = 0.45; this.throwBall(c); } return true; }
    // Thanos: the click uses the selected stone
    if (id === 'thanos' && holding && INPUT.lmb) {
      const st = STONES[pw.stone];
      if (st.id === 'soul') { this.soulDrain(c); return true; }
      if (!INPUT.lmbPressed || (pw.stoneCd[st.id] || 0) > G.time) return true;
      pw.stoneCd[st.id] = G.time + st.cd;
      this[st.id + 'Stone'](c);
      return true;
    }
    return false;
  },

  // ---------- every frame for everyone with powers ----------
  update(c, dt) {
    const pw = c.pw;
    if (!pw || !c.alive) return;
    for (const k in pw.cd) { pw.cd[k].R -= dt; pw.cd[k].G -= dt; }
    if (c.onGround) pw.dj = false;
    if (c.onGround) { pw.fuel = Math.min(3, pw.fuel + dt * 0.8); c.flying = false; }
    // Ground Pound lands
    if (pw.pound && c.onGround && pw.poundT < G.time) {
      pw.pound = false;
      const p = new THREE.Vector3(c.pos.x, c.pos.y + 0.5, c.pos.z);
      FX.explodeAt(p, c, 70, 9, 220);
      for (const o of G.chars) {
        if (o === c || !o.alive || o.state !== 'ground') continue;
        const dx = o.pos.x - c.pos.x, dz = o.pos.z - c.pos.z, dd = Math.hypot(dx, dz);
        if (dd > 10 || dd < 0.01) continue;
        const k = 1 - dd / 10; o.vel.x += dx / dd * 18 * k; o.vel.z += dz / dd * 18 * k; o.vel.y = 9 * k + 3; o.onGround = false; o.knockT = 0.7;
      }
      if (c.isPlayer) G.shake = Math.max(G.shake, 0.5);
    }
    // Unibeam keeps firing while it lasts
    if (pw.beamT > 0) {
      pw.beamT -= dt; pw.beamTick -= dt;
      if (pw.beamTick <= 0) { pw.beamTick = 0.06; this.beam(c, this.aimDir(c), 14, 0xffffff, 'Unibeam'); }
    }
    // Time Stone history: where you were and how healthy, sampled every 0.25 s for 5 s
    if (pw.kits.includes('thanos')) {
      pw.histT -= dt;
      if (pw.histT <= 0) { pw.histT = 0.25; pw.hist.push({ t: G.time, x: c.pos.x, y: c.pos.y, z: c.pos.z, hp: c.hp, sh: c.shield }); while (pw.hist.length && pw.hist[0].t < G.time - 5) pw.hist.shift(); }
    }
    if (c.isPlayer) this.drawHud(c);
  },

  // swap to another stacked boss: its weapon, its abilities and its look
  switchKit(c, id) {
    const P = POWER_DEFS[id];
    c.power = id;
    c.slots[5] = { kind: 'weapon', id: P.weapon, rarity: 5, mag: 9999, special: true };
    BOSS.giveBody(c, c.forceOutfit || P.outfit, c.forceSize || P.size);
    CHARS.attachModel(c);
    c.model.root.visible = true;
    c.heldKey = '';
    SFX.play('shield', 0.5);
    if (c.isPlayer) HUD.toast(c.ultronForm ? (id === 'thanos' ? 'Infinity Gauntlet' : 'Ultron’s arsenal') : P.name);
  },

  // ---------- helpers ----------
  aimDir(c) {
    if (c.isPlayer) {
      const o = CHARS.muzzle(c, new THREE.Vector3()), d = PC.aimPoint.clone().sub(o).normalize();
      return c.isSmasher || c.aimbot ? PC.autoAim(c, o, d) : d; // Adam Smasher's auto-aim works for the Infinity Stones too
    }
    return new THREE.Vector3(-Math.sin(c.yaw) * Math.cos(c.pitch), Math.sin(c.pitch), -Math.cos(c.yaw) * Math.cos(c.pitch));
  },
  // instant beam: damages the first thing it hits; returns the damage dealt to a character
  beam(c, dir, dmg, color, name) {
    const o = CHARS.muzzle(c, new THREE.Vector3());
    const hit = PHYS.raycast(o, dir, 260, { ignore: c });
    const end = hit ? hit.point : o.clone().addScaledVector(dir, 260);
    FX.tracer(o, end, color, true);
    if (!hit) return 0;
    if (hit.kind === 'char') { CHARS.damage(hit.char, dmg * (c.dmgMult || 1), c, { weapon: name }); FX.impact(hit.point, 'char'); return dmg; }
    if (hit.kind === 'solid') WORLD.hitSolid(hit.solid, dmg * 2, c, false);
    FX.impact(hit.point, hit.kind);
    return 0;
  },
  blast(c, dir, color, rocketId = 'rocket') {
    const o = CHARS.muzzle(c, new THREE.Vector3());
    FX.rocket(c, o.addScaledVector(dir, 1.2), dir, { id: rocketId, rarity: 4, color });
    SFX.play('rocket', 0.8, c.isPlayer ? null : c.pos);
  },

  // ---------- Doom ----------
  unstableBolt(c) { this.blast(c, this.aimDir(c), 0x3dff6e); },
  groundPound(c) { c.vel.y = 15; c.onGround = false; c.pw.pound = true; c.pw.poundT = G.time + 0.2; SFX.play('cannon', 0.6, c.isPlayer ? null : c.pos); },

  // ---------- Iron Man ----------
  unibeam(c) { c.pw.beamT = 1.5; c.pw.beamTick = 0; SFX.play('laser', 0.9, c.isPlayer ? null : c.pos); },
  missiles(c) {
    const foes = G.chars.filter(o => o !== c && o.alive && o.state !== 'bus' && (!c.team || o.team !== c.team) && o.pos.distanceTo(c.pos) < 120 && BOTS.canSee(c, o).see)
      .sort((a, b) => a.pos.distanceTo(c.pos) - b.pos.distanceTo(c.pos)).slice(0, 4);
    const targets = foes.length ? foes : [null];
    for (let i = 0; i < 6; i++) {
      const t = targets[i % targets.length];
      const o = CHARS.muzzle(c, new THREE.Vector3());
      const dir = t ? new THREE.Vector3(t.pos.x - o.x, t.pos.y + 1 - o.y, t.pos.z - o.z).normalize() : this.aimDir(c);
      CHARS.jitter(dir, 0.05, dir);
      setTimeout(() => { if (c.alive) FX.rocket(c, CHARS.muzzle(c, new THREE.Vector3()).addScaledVector(dir, 1.2), dir, { id: 'quad', rarity: 4, color: 0xffb02e }); }, i * 90);
    }
    SFX.play('rocket', 0.9, c.isPlayer ? null : c.pos);
  },

  // ---------- LeBron ----------
  // a basketball lobbed in an arc onto whatever you're aiming at
  throwBall(c) {
    const o = CHARS.muzzle(c, new THREE.Vector3()), t = c.isPlayer ? PC.aimPoint.clone() : o.clone().addScaledVector(this.aimDir(c), 30);
    const flat = Math.hypot(t.x - o.x, t.z - o.z), T = Math.max(0.35, Math.min(1.6, flat / 38));
    const v = new THREE.Vector3((t.x - o.x) / T, (t.y - o.y) / T + 0.5 * 22 * T, (t.z - o.z) / T);
    FX.orb(c, o.addScaledVector(v.clone().normalize(), 0.8), v, { ball: true, size: 0.26, dmg: 38, gravity: 22, life: 4, name: 'basketball' });
    c.swingT = 0.32; SFX.play('swing', 0.7, c.isPlayer ? null : c.pos);
  },
  // Slam Dunk: leap at what you're aiming at (up to 22 m) and hammer the ground where you land
  slamDunk(c) {
    const t = c.isPlayer ? PC.aimPoint : c.pos, dx = t.x - c.pos.x, dz = t.z - c.pos.z, L = Math.min(22, Math.hypot(dx, dz)) || 1, n = Math.hypot(dx, dz) || 1;
    c.vel.x = dx / n * L / 1.1; c.vel.z = dz / n * L / 1.1; c.vel.y = 13; c.onGround = false;
    c.pw.pound = true; c.pw.poundT = G.time + 0.25; c.pw.dunkUntil = G.time + 1.1;
    c.swingT = 0.32; SFX.play('cannon', 0.6, c.isPlayer ? null : c.pos);
  },

  // ---------- Thanos ----------
  powerStone(c) { this.blast(c, this.aimDir(c), 0xb04aff); },
  spaceStone(c) {
    const p = c.isPlayer ? PC.aimPoint : c.pos;
    const from = c.pos.clone(), dir = p.clone().sub(from); dir.y = 0;
    const L = Math.min(60, dir.length()); if (L < 2) return;
    dir.normalize();
    const x = from.x + dir.x * (L - 1.5), z = from.z + dir.z * (L - 1.5);
    FX.sparkle(new THREE.Vector3(from.x, from.y + 1, from.z), 0x3d7bff);
    c.pos.set(x, Math.max(WORLD.heightAt(x, z), p.y) + 0.3, z); c.vel.set(0, 0, 0);
    FX.sparkle(new THREE.Vector3(x, c.pos.y + 1, z), 0x3d7bff);
    SFX.play('shield', 0.6);
  },
  realityStone(c) { c.invisUntil = G.time + 6; FX.sparkle(new THREE.Vector3(c.pos.x, c.pos.y + 1, c.pos.z), 0xff3b3b); HUD.toast('Invisible for 6 seconds'); },
  soulDrain(c) {
    if (c.fireCd > 0) return;
    c.fireCd = 0.09;
    const dealt = this.beam(c, this.aimDir(c), 9, 0xff9a1f, 'Soul Stone');
    if (dealt) c.hp = Math.min(c.maxHp, c.hp + dealt * 0.6);
  },
  timeStone(c) {
    const h = c.pw.hist[0];
    if (!h) return;
    FX.sparkle(new THREE.Vector3(c.pos.x, c.pos.y + 1, c.pos.z), 0x2fd46b);
    c.pos.set(h.x, h.y, h.z); c.vel.set(0, 0, 0);
    c.hp = Math.max(c.hp, h.hp); c.shield = Math.max(c.shield, h.sh);
    FX.sparkle(new THREE.Vector3(h.x, h.y + 1, h.z), 0x2fd46b);
    HUD.toast('Rewound 5 seconds');
  },
  mindStone(c) {
    c.mindUntil = G.time + 8;
    // everyone close by forgets you and picks a fight with each other
    for (const o of G.chars) {
      if (o === c || !o.alive || o.isPlayer || !o.ai || o.pos.distanceTo(c.pos) > 45) continue;
      let other = null, od = 1e9;
      for (const q of G.chars) { if (q === o || q === c || !q.alive || q.isBoss) continue; const d = q.pos.distanceTo(o.pos); if (d < od) { od = d; other = q; } }
      o.ai.target = other; o.ai.reactT = 0;
    }
    FX.sparkle(new THREE.Vector3(c.pos.x, c.pos.y + 1.5, c.pos.z), 0xffd84a);
    HUD.toast('Nearby enemies turn on each other');
  },
  snap(c) {
    if (c.pw && c.pw.noSnap) { if (c.isPlayer) HUD.toast('The snap doesn’t work here'); return; }
    if (!c.isPlayer || c.pw.snapped) { if (c.isPlayer) HUD.toast('You already snapped'); return; }
    c.pw.snapped = true;
    const others = G.chars.filter(o => o !== c && o.alive && !o.isBoss && o.state !== 'bus');
    const n = Math.floor(others.length / 2);
    shuffle(others);
    HUD.banner('PERFECTLY BALANCED', `${n} players turned to dust`);
    G.shake = Math.max(G.shake, 0.8);
    SFX.play('storm', 1);
    others.slice(0, n).forEach((o, i) => setTimeout(() => {
      if (!o.alive) return;
      FX.sparkle(new THREE.Vector3(o.pos.x, o.pos.y + 1, o.pos.z), 0x9a7b5a);
      CHARS.damage(o, 99999, c, { direct: true, weapon: 'the Snap' });
    }, 400 + i * 60));
  },

  // ---------- HUD line above the hotbar ----------
  drawHud(c) {
    if (!this.el) { this.el = document.createElement('div'); this.el.id = 'powerhud'; document.getElementById('hud').appendChild(this.el); }
    const pw = c.pw, id = c.power, cd = (v) => v > 0 ? Math.ceil(v) + 's' : 'ready', k = pw.cd[id] || { R: 0, G: 0 };
    let html;
    if (id === 'thanos') {
      const st = STONES[pw.stone], left = (pw.stoneCd[st.id] || 0) - G.time;
      html = `<b style="color:${st.color}">${st.name}</b> ${st.cd ? cd(left) : ''}${c.aimbot ? ' · <b style="color:#ff4a5e">AIMBOT</b>' : ''} · <kbd>R</kbd> next stone · <kbd>G</kbd> Snap ${pw.snapped ? 'used' : 'ready'}`
        + `<span class="stones">${STONES.map((s, i) => `<i style="background:${s.color};opacity:${i === pw.stone ? 1 : 0.35}"></i>`).join('')}</span>`;
    } else if (id === 'doom') html = `<b style="color:#3dff6e">Doctor Doom</b> · <kbd>R</kbd> Unstable Bolt ${cd(k.R)} · <kbd>G</kbd> Ground Pound ${cd(k.G)} · <kbd>Y</kbd> Doombots ${NET.inMatch ? 'solo only' : cd((pw.botsT || 0) - G.time)}`;
    else if (id === 'adam') html = `<b style="color:#ff4a5e">${c.ultronForm ? 'Infinity Ultron' : 'Adam Smasher'}</b> · <kbd>R</kbd> ${c.slots[5].id === 'laser' ? 'arm cannon' : 'hand laser'} · self-repair · auto-aim`;
    else if (id === 'lebron') html = `<b style="color:#ffc72c">LeBron James</b> · Click: basketballs · <kbd>G</kbd> Slam Dunk ${cd(k.G)} · double jump`;
    else html = `<b style="color:#ffb02e">Iron Man</b> · <kbd>R</kbd> Unibeam ${cd(k.R)} · <kbd>G</kbd> Missiles ${cd(k.G)}`;
    if (pw.kits.includes('ironman')) html += ` · Fuel <span class="fuel"><i style="width:${pw.fuel / 3 * 100}%"></i></span>`;
    html += ` · <span style="color:#ff8a8a">${pw.kits.length >= 3 ? 'live on the map' : pw.kits.length === 2 ? 'pinged every 5 s' : 'pinged every 10 s'}</span>`;
    if (pw.kits.length > 1) html += ` · <kbd>6</kbd> ${pw.kits.map(x => x === id ? '<b>' + POWER_DEFS[x].short + '</b>' : POWER_DEFS[x].short).join(' / ')}`;
    if (this._last !== html) { this.el.innerHTML = html; this._last = html; }
  },
  reset() { if (this.el) { this.el.remove(); this.el = null; this._last = ''; } },
};

// ---- starwars.js ----
'use strict';
// ===== Season 2 Star Wars gear: Fortnite's own lightsabers (hilts, sounds, icons) and Force Push / Pull =====
// The hilts come from dist/props (sw_saber_*), the sounds and hotbar renders from dist/sw-gear.js.
// Lightsaber: click for a 3-hit combo (the third swing is a heavy one), each swing lunges at someone close in
// front of you and cuts through builds; hold right-click to block, which turns shots from the front back
// at the shooter for a fifth of the damage. Force Push throws everyone in a cone in front of you back;
// Force Pull yanks the one player you aim at over to you. Both are on a cooldown instead of ammo.
const SABER_COLOR = { saber_blue: 0x2f8bff, saber_green: 0x2cff5a, saber_red: 0xff2020 };
const SW = {
  buffers: {}, loading: false, hum: null,
  // which way the saber sits in the hand: hand space, found by eye on the Fortnite rigs (blade along +y of the saber)
  GRIP: { x: 0.18, y: 0, z: 0, pos: [0, -0.02, -0.02] },

  // ---------- sounds ----------
  load() {
    if (this.loading || typeof SW_AUDIO === 'undefined' || !SFX.ctx) return;
    this.loading = true;
    for (const k in SW_AUDIO) {
      const b = atob(SW_AUDIO[k].split(',')[1]), u = new Uint8Array(b.length);
      for (let i = 0; i < b.length; i++) u[i] = b.charCodeAt(i);
      SFX.ctx.decodeAudioData(u.buffer).then((buf) => { this.buffers[k] = buf; }).catch(() => {});
    }
  },
  play(name, vol = 1, pos = null, loop = false) {
    this.load();
    const buf = this.buffers[name];
    if (!buf) return null;
    const p = SFX.place(vol, pos);
    if (!p) return null;
    const src = SFX.ctx.createBufferSource(); src.buffer = buf; src.loop = loop;
    const o = SFX._out(p.vol, p.pan); src.connect(o); src.start();
    return { src, out: o };
  },
  // the player's own saber hums while it's out
  // (it also stops by itself once nothing has asked for it for a moment: you died, the match ended, the tab is hidden)
  humTick(c, on) {
    if (on) this.humSeen = performance.now();
    if (on && !this.hum && SFX.ctx) {
      this.hum = this.play('saber_hum', 0.08, null, true); // a low background hum: the swings and hits are the loud part
      if (this.hum) this.humWatch = setInterval(() => { if (performance.now() - this.humSeen > 300) this.humTick(null, false); }, 250);
    }
    if (!on && this.hum) { try { this.hum.src.stop(); } catch (e) { /* already stopped */ } this.hum = null; clearInterval(this.humWatch); }
  },

  // ---------- the lightsaber model ----------
  saberMesh(id) {
    const g = new THREE.Group(), col = SABER_COLOR[id] || SABER_COLOR.saber_blue, prop = 'sw_' + id;
    if (PROPS.has(prop)) {
      const h = PROPS.scenes[prop].clone();
      h.traverse((o) => { if (o.isMesh) { o.castShadow = false; o.material = o.material.clone(); o.material.color.setScalar(1.25); } });
      g.add(h);
    } else {
      const h = new THREE.Mesh(new THREE.CylinderGeometry(0.022, 0.026, 0.3, 10), new THREE.MeshLambertMaterial({ color: 0x9aa0a8 }));
      h.position.y = 0.15; g.add(h);
    }
    // the blade: a white-hot core inside two glowing shells of the saber's color (it grows out when switched on)
    const blade = new THREE.Group(), L = 1.05;
    const layer = (r, color, opacity) => {
      const m = new THREE.Mesh(new THREE.CylinderGeometry(r, r, L, 10, 1, true), new THREE.MeshBasicMaterial({ color, transparent: true, opacity, blending: THREE.AdditiveBlending, depthWrite: false }));
      m.position.y = L / 2; blade.add(m);
      const tip = new THREE.Mesh(new THREE.SphereGeometry(r, 10, 6, 0, TAU, 0, Math.PI / 2), m.material); tip.position.y = L; blade.add(tip);
      return m;
    };
    layer(0.016, 0xffffff, 1); layer(0.032, col, 0.75); layer(0.06, col, 0.22);
    blade.position.y = 0.29; blade.scale.y = 0.01;
    g.add(blade);
    g.userData = { real: true, saber: true, blade, color: col };
    return g;
  },
  // put a freshly made saber in the hand and switch it on
  grip(c, m) {
    const G0 = this.GRIP;
    m.held.rotation.set(G0.x, G0.y, G0.z); m.held.position.set(...G0.pos); m.held.scale.setScalar(1);
    if (c.isPlayer || (SFX.listener && c.pos.distanceTo(SFX.listener) < 40)) this.play('saber_on', c.isPlayer ? 0.5 : 0.6, c.isPlayer ? null : c.pos);
  },
  // every frame for every character: the blade grows out, and the player's saber hums
  tick(c, dt) {
    const m = c.model, h = m && m.held, on = !!(h && h.userData.saber && h.parent);
    if (on) {
      const b = h.userData.blade; if (b.scale.y < 1) b.scale.y = Math.min(1, b.scale.y + dt * 6);
      // the blade tips forward through each cut (the arms carry it across), and leans forward on guard
      const k = c.swingT > 0 ? 1 - c.swingT / 0.32 : 0;
      const tip = c.swingT > 0 ? (c.combo === 2 ? lerp(-0.5, 2.3, k) : Math.sin(k * Math.PI) * 1.3) : c.ads ? 0.6 : 0;
      h.rotation.x = this.GRIP.x + tip;
    }
    if (c.isPlayer) {
      if (!on && c._saberOn && SFX.ctx) this.play('saber_off', 0.45);
      c._saberOn = on;
      this.humTick(c, on && c.alive && G.inMatch() && !G.paused && !document.hidden);
    }
  },

  // ---------- lightsaber combat ----------
  swing(c, dir, item, W) {
    c.combo = G.time - (c.comboT || -9) < 0.95 ? ((c.combo || 0) + 1) % 3 : 0;
    c.comboT = G.time;
    const heavy = c.combo === 2;
    c.fireCd = heavy ? 0.6 : 0.34; c.swingT = 0.32;
    const fwd = new THREE.Vector3(dir.x, 0, dir.z);
    if (fwd.lengthSq() < 1e-6) fwd.set(-Math.sin(c.yaw), 0, -Math.cos(c.yaw));
    fwd.normalize();
    const eye = new THREE.Vector3(c.pos.x, c.pos.y + 1.2 * (c.size || 1), c.pos.z);
    // lunge at the closest player in front of you (on the ground, within a few steps)
    let lungeTo = null, best = 7.5;
    for (const o of G.chars) {
      if (o === c || !o.alive || o.state === 'bus' || o.dormant) continue;
      const dx = o.pos.x - c.pos.x, dz = o.pos.z - c.pos.z, d = Math.hypot(dx, dz);
      if (d < best && d > 1.6 && Math.abs(o.pos.y - c.pos.y) < 2.5 && (dx * fwd.x + dz * fwd.z) / d > 0.8) { best = d; lungeTo = o; }
    }
    if (lungeTo && c.onGround) { const k = Math.min(15, (best - 1.4) * 5); c.vel.x = fwd.x * k; c.vel.z = fwd.z * k; c.knockT = 0.14; }
    // everyone inside the arc of the swing (up to three), as long as no wall is in the way
    const reach = W.range + (lungeTo ? 1 : 0), hitList = [];
    for (const o of G.chars) {
      if (o === c || !o.alive || o.state === 'bus' || o.dormant) continue;
      const to = _v2.set(o.pos.x - eye.x, o.pos.y + 1 * (o.size || 1) - eye.y, o.pos.z - eye.z), d = to.length();
      if (d > reach + 0.4 * (o.size || 1) || d < 0.01) continue;
      if ((to.x * fwd.x + to.z * fwd.z) / Math.max(0.01, Math.hypot(to.x, to.z)) < 0.45) continue;
      const wall = PHYS.raycast(eye, to.clone().normalize(), d, { ignore: c });
      if (wall && wall.kind === 'solid' && wall.t < d - 0.6) continue;
      hitList.push({ o, d });
    }
    hitList.sort((a, b) => a.d - b.d);
    for (const { o } of hitList.slice(0, 3)) {
      const dmg = W.dmg[Math.min(item.rarity, W.dmg.length - 1)] * (heavy ? 1.5 : 1) * (c.dmgMult || 1);
      CHARS.damage(o, dmg, c, { weapon: W.name, melee: true });
      FX.burst(new THREE.Vector3(o.pos.x, o.pos.y + 1.1 * (o.size || 1), o.pos.z), SABER_COLOR[item.id], 10, 6, 0.35, 0.07, 6, true);
    }
    // it cuts through builds and walls in front of you
    const hit = PHYS.raycast(eye, dir, W.range, { ignore: c });
    if (hit && hit.kind === 'solid') {
      WORLD.hitSolid(hit.solid, heavy ? 260 : 160, c, false);
      FX.burst(hit.point, 0xffd9a0, 8, 7, 0.4, 0.06, 18, true);
      if (c.isPlayer && hit.solid.destructible && hit.solid.maxHp) HUD.structHp(hit.solid);
    }
    const near = c.isPlayer ? null : c.pos;
    if (hitList.length || (hit && hit.kind === 'solid')) this.play(Math.random() < 0.5 ? 'saber_hit1' : 'saber_hit2', 0.55, near);
    else this.play(heavy ? 'saber_swing3' : c.combo ? 'saber_swing2' : 'saber_swing1', 0.6, near);
    if (c.isPlayer && hitList.length) G.shake = Math.max(G.shake, heavy ? 0.25 : 0.1);
    return true;
  },
  // holding right-click with a saber out blocks hits from the front (not explosions, the storm or falls):
  // the shot bounces back toward the shooter and only a fifth of it gets through
  block(c, attacker, amount, opts) {
    if (!c.ads || !attacker || attacker === c || opts.storm || opts.fall || opts.explosive || opts.direct) return amount;
    const it = CHARS.currentItem(c), W = it && WEAPONS[it.id];
    if (!W || !W.saber || c.buildType) return amount;
    const dx = attacker.pos.x - c.pos.x, dz = attacker.pos.z - c.pos.z, d = Math.hypot(dx, dz) || 1;
    if ((-dx * Math.sin(c.yaw) - dz * Math.cos(c.yaw)) / d < 0.3) return amount; // not in front of you (characters face -z at yaw 0)
    const p = new THREE.Vector3(c.pos.x - Math.sin(c.yaw) * 0.6, c.pos.y + 1.3 * (c.size || 1), c.pos.z - Math.cos(c.yaw) * 0.6);
    FX.burst(p, SABER_COLOR[it.id], 6, 5, 0.25, 0.06, 6, true);
    if (!opts.melee) FX.tracer(p, new THREE.Vector3(attacker.pos.x, attacker.pos.y + 1.3, attacker.pos.z), SABER_COLOR[it.id], true);
    if (Math.random() < 0.5) this.play(Math.random() < 0.5 ? 'saber_hit1' : 'saber_hit2', c.isPlayer ? 0.35 : 0.5, c.isPlayer ? null : c.pos);
    return amount * 0.2;
  },
  // arms: both hands on the hilt, blade up (the left hand comes in under the right one); each swing of the
  // combo is a different cut. (side: which way z turns an arm in toward the middle on this rig)
  arms(c, m, sw) {
    const k = c.swingT > 0 ? 1 - c.swingT / 0.32 : 0, e = Math.sin(k * Math.PI), side = m.v1 ? 1 : -1, tilt = c.pitch * 0.3;
    let x = 0.9 + tilt, z = -0.5;
    if (c.ads) { x = 1.3; z = -0.75; } // guard: saber held across in front
    else if (c.swingT > 0) {
      if (c.combo === 0) { x = 1.2 + e * 0.3 + tilt; z = lerp(0.45, -1.1, k); } // right to left
      else if (c.combo === 1) { x = 1.2 + e * 0.3 + tilt; z = lerp(-1.1, 0.45, k); } // back left to right
      else { x = lerp(2.7, 0.6, k * k); z = -0.5; } // overhead chop
    }
    m.armR.rotation.x = x; m.armR.rotation.z = z * side;
    m.armL.rotation.x = x - 0.05; m.armL.rotation.z = (z + 0.95) * side;
  },

  // ---------- the Force ----------
  force(c, dir, item, W) {
    if (G.time < (item.readyAt || 0)) { if (c.isPlayer && INPUT.lmbPressed) { SFX.play('empty', 0.5); HUD.toast(W.name + ' recharging'); } return false; }
    c.fireCd = 0.5; c.swingT = 0.32; c.forceT = G.time;
    const fwd = new THREE.Vector3(dir.x, 0, dir.z);
    if (fwd.lengthSq() < 1e-6) fwd.set(-Math.sin(c.yaw), 0, -Math.cos(c.yaw));
    fwd.normalize();
    const eye = new THREE.Vector3(c.pos.x, c.pos.y + 1.3 * (c.size || 1), c.pos.z);
    const near = c.isPlayer ? null : c.pos;
    const seen = (o, d) => { const to = new THREE.Vector3(o.pos.x, o.pos.y + 1, o.pos.z).sub(eye); const w = PHYS.raycast(eye, to.normalize(), d, { ignore: c }); return !(w && w.kind === 'solid' && w.t < d - 0.8); };
    if (W.force === 'push') {
      const R = 13;
      for (const o of G.chars) {
        if (o === c || !o.alive || o.state === 'bus' || o.dormant || o.vehicle) continue;
        const dx = o.pos.x - c.pos.x, dz = o.pos.z - c.pos.z, d = Math.hypot(dx, dz);
        if (d > R || d < 0.01 || Math.abs(o.pos.y - c.pos.y) > 6 || (dx * fwd.x + dz * fwd.z) / d < 0.7 || !seen(o, d)) continue;
        const k = 1 - d / R * 0.5;
        if (!o.isBoss) { o.vel.x = fwd.x * 26 * k; o.vel.z = fwd.z * 26 * k; o.vel.y = 9 * k + 2; o.onGround = false; o.knockT = 0.8; if (o.state === 'glide') o.state = 'fall'; }
        CHARS.damage(o, W.dmg[0] * (c.dmgMult || 1), c, { weapon: W.name });
      }
      // builds in the cone get blown apart
      const box = PHYS.query(c.pos.x - R, c.pos.z - R, c.pos.x + R, c.pos.z + R, PHYS._arr2);
      for (const s of box.slice()) {
        if (!s.alive || !s.destructible || s.kind === 'prop') continue;
        const sx = (s.x0 + s.x1) / 2 - c.pos.x, sz = (s.z0 + s.z1) / 2 - c.pos.z, d = Math.hypot(sx, sz);
        if (d < R * 0.75 && d > 0.01 && (sx * fwd.x + sz * fwd.z) / d > 0.7 && (s.y1 > c.pos.y - 1 && s.y0 < c.pos.y + 6)) WORLD.hitSolid(s, 220, c, false);
      }
      this.wave(eye, fwd);
      this.play('force_push', 0.7, near);
      if (c.isPlayer) G.shake = Math.max(G.shake, 0.35);
    } else {
      // Force Pull: the one player closest to your aim within 30 m
      let best = null, bs = 0.96;
      for (const o of G.chars) {
        if (o === c || !o.alive || o.state === 'bus' || o.dormant || o.vehicle || o.isBoss) continue;
        const to = _v2.set(o.pos.x, o.pos.y + 1, o.pos.z).sub(eye), d = to.length();
        if (d > 30 || d < 2) continue;
        const a = to.dot(dir) / d;
        if (a > bs && seen(o, d)) { bs = a; best = o; }
      }
      if (!best) { item.readyAt = G.time + 1; this.play('force_charge', 0.4, near); if (c.isPlayer) HUD.toast('Nobody to pull: aim at a player'); return true; }
      const dx = c.pos.x - best.pos.x, dz = c.pos.z - best.pos.z, d = Math.hypot(dx, dz);
      const v = Math.min(24, d * 1.1);
      best.vel.x = dx / d * v; best.vel.z = dz / d * v; best.vel.y = 8 + d * 0.12; best.onGround = false; best.knockT = 0.9;
      CHARS.damage(best, W.dmg[0] * (c.dmgMult || 1), c, { weapon: W.name });
      const tp = new THREE.Vector3(best.pos.x, best.pos.y + 1.1, best.pos.z);
      FX.tracer(eye, tp, 0x9fd8ff, true); FX.burst(tp, 0x9fd8ff, 14, 4, 0.6, 0.09, -1, true);
      this.play('force_pull', 0.7, near);
    }
    item.readyAt = G.time + W.cooldown;
    return true;
  },
  // a ripple of air rushing out of your hand
  wave(p, fwd) {
    for (let i = 0; i < 3; i++) {
      const m = new THREE.Mesh(new THREE.TorusGeometry(0.8 + i * 0.5, 0.12, 6, 24), new THREE.MeshBasicMaterial({ color: 0xbfe6ff, transparent: true, opacity: 0.55, blending: THREE.AdditiveBlending, depthWrite: false }));
      m.position.copy(p).addScaledVector(fwd, 1 + i * 0.6); m.lookAt(m.position.clone().add(fwd));
      GFX.scene.add(m);
      FX.parts.push({ obj: m, vel: fwd.clone().multiplyScalar(18 + i * 4), life: 0.45, max: 0.45, grav: 0, shrink: false, grow: 2.2 });
    }
    for (let i = 0; i < 18; i++) FX.burst(p.clone().addScaledVector(fwd, 1.5 + Math.random() * 5).add(new THREE.Vector3(rand(-1.5, 1.5), rand(-1, 1), rand(-1.5, 1.5))), 0xd8f0ff, 1, 8, 0.4, 0.1, 0, true);
  },
  forceArms(c, m, sw) {
    const k = c.forceT && G.time - c.forceT < 0.45 ? 1 - (G.time - c.forceT) / 0.45 : 0, side = m.v1 ? -1 : 1;
    m.armR.rotation.x = Math.PI / 2 + c.pitch * 0.8 + k * 0.2; m.armR.rotation.z = side * -0.1; // palm out at what you aim at
    m.armL.rotation.x = k > 0 ? Math.PI / 2 + c.pitch * 0.8 : -sw * 0.8; m.armL.rotation.z = k > 0 ? side * 0.1 : 0;
  },
  // what a Force power looks like lying on the ground: a swirling blue orb
  forceOrb(id) {
    const g = new THREE.Group(), col = id === 'force_pull' ? 0x8f7bff : 0x6fc8ff;
    g.add(new THREE.Mesh(new THREE.SphereGeometry(0.2, 16, 12), new THREE.MeshBasicMaterial({ color: 0xffffff })));
    g.add(new THREE.Mesh(new THREE.SphereGeometry(0.3, 16, 12), new THREE.MeshBasicMaterial({ color: col, transparent: true, opacity: 0.45, blending: THREE.AdditiveBlending, depthWrite: false })));
    for (let i = 0; i < 2; i++) { const r = new THREE.Mesh(new THREE.TorusGeometry(0.4, 0.025, 6, 28), new THREE.MeshBasicMaterial({ color: col })); r.rotation.set(Math.PI / 2 + i * 0.9, i * 0.6, 0); g.add(r); }
    return g;
  },
  // hotbar label: seconds until the Force power is back
  cooldownLeft(item) { return Math.max(0, Math.ceil((item.readyAt || 0) - G.time)); },
};

// ---- zephara.js ----
'use strict';
// ===== Season 2: Zephara, the pink planet the evac ships jumped to =====
// Rose-pink ground, maroon highlands and white salt flats under a violet sky crossed by huge golden rings.
// The Marvel landmarks stayed behind on the old island; what crashed here with everyone is Star Wars
// wreckage: a chunk of the Death Star half-buried in a crater, a Star Destroyer nose-down in the dirt and
// an Imperial outpost. WORLD asks ZEPH for each of these while it builds a Season 2 map (WORLD.zeph).
const ZEPH_NAMES = ['Rosefall', 'Goldring Gardens', 'Saltshine Flats', 'Maroon Mesa', 'Petal Point', 'Blush Bay', 'Halo Hollow', 'Crimson Crossing',
  'Starfall Springs', 'Ringlight Ranch', 'Sunset Spires', 'Coral Commons', 'Duskbloom', 'Pinkstone Plaza', 'Comet Cove', 'Nebula Nook', 'Twin Sun Terrace', 'Glimmer Grove'];
const ZEPH = {
  DS_R: 64, // the Death Star chunk's radius (m)

  // ---------- named locations ----------
  plan(small) {
    if (small) return [{ type: 'outpost', name: 'Imperial Outpost', r: 55 }, { type: 'town' }, { type: 'towers' }, { type: 'school' }];
    return [
      { type: 'deathstar', name: 'Death Star Crater', r: 100 },
      { type: 'destroyer', name: 'Crashed Destroyer', r: 92 },
      { type: 'outpost', name: 'Imperial Outpost', r: 62 },
      { type: 'towers' }, { type: 'town' }, { type: 'school' }, { type: 'farm' }, { type: 'town' }, { type: 'towers' }, { type: 'town' },
      { type: 'farm' }, { type: 'town' }, { type: 'towers' }, { type: 'school' }, { type: 'town' }, { type: 'farm' }, { type: 'town' },
    ];
  },
  // (bosses still pick lairs by side, so the towns take turns being "hero" and "villain")
  names() { return shuffle(ZEPH_NAMES.slice(), WRNG); },

  // ---------- terrain ----------
  // white salt flats: wide, dead-level pans in the lowlands
  salt(x, z) { return smoothstep(0.18, 0.3, WORLD.noise.fbm(x * 0.0026 - 300, z * 0.0026 + 210, 3)); },
  height(x, z, h) {
    const s = this.salt(x, z);
    return s > 0 && h > 2 && h < 22 ? lerp(h, 3.2, s * (1 - smoothstep(14, 22, h))) : h;
  },
  // the Death Star chunk is a dome in the heightmap too, just inside the model, so it can be climbed
  lift(p, x, z, h) {
    if (p.type !== 'deathstar') return h;
    const d = dist2D(x, z, p.x, p.z), R = this.DS_R, cy = p.y - R * 0.42;
    return d < R ? Math.max(h, cy + Math.sqrt(R * R - d * d) - 1.2) : h;
  },
  terrainColor(x, z, h, ny, out) {
    const N = WORLD.noise, n = N.noise(x * 0.05, z * 0.05) * 0.5 + 0.5, big = N.noise(x * 0.008 + 31, z * 0.008 - 17) * 0.5 + 0.5;
    let r, g, b;
    if (h < 0.4) { r = 0.7; g = 0.5; b = 0.58; } // wet shore
    else if (h < 2.2) { r = 0.95; g = 0.82; b = 0.8; } // pale pink sand
    else {
      // rose meadows, deeper pink patches and peachy ones
      r = lerp(0.84, 0.9, n); g = lerp(0.5, 0.58, n); b = lerp(0.6, 0.66, n);
      if (big > 0.62) { const t = smoothstep(0.62, 0.8, big); r = lerp(r, 0.95, t); g = lerp(g, 0.66, t); b = lerp(b, 0.58, t); }
