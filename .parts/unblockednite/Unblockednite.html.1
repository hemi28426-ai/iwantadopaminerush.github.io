  },
  heroPlan(c, special, color) {
    const m = this.pick(c, [['circle', 2], ['combo', 3], [special, 3]]);
    if (m === 'circle') return [this.circle(c, 0.8 + this.rnd() * 0.8, 8), this.face(c, 0.2)];
    if (m === 'combo') return [this.charge(c, 1.6, 12), this.punch(c, 'R'), this.punch(c, 'L'), this.punch(c, 'R', true), this.roll(c, this.rnd() < 0.5 ? 1 : -1)];
    if (m === 'laser') return [this.face(c, 0.3, 'raise'), this.laser(c, 1.2, color, true)];
