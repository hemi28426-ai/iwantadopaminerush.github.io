        const r = WORLD.randomLandPoint(p.x, p.z, p.r * 0.75);
        if (WORLD.nearBuilding(r.x, r.z, 5)) continue;
        PROPS.place(id, r.x, WORLD.heightAt(r.x, r.z), r.z, wri(0, 3)); break;
      }
    }
    for (let i = 0; i < 3; i++) { const r = WORLD.randomLandPoint(p.x, p.z, p.r * 0.8); if (!WORLD.nearBuilding(r.x, r.z, 3)) ITEMS.spawnFloorLoot(r.x, WORLD.heightAt(r.x, r.z), r.z); }
