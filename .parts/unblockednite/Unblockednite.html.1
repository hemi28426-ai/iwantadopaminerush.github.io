      const d = this.away(f, c); this.slide(c, f.pos.x + d.x * 2.5, f.pos.z + d.z * 2.5, 12, dt); c.fly = c.flyTo = Math.sin(Math.PI * k) * 7; this.turnTo(c, f.pos.x, f.pos.z, dt, 10);
    }, exit: () => { c.fly = c.flyTo = 0; this.boom(new THREE.Vector3(c.pos.x, 0.3, c.pos.z), 5, 1.6); this.sfx('cannon', 1); if (this.dist(c, f) < 7) this.stagger(f, c, 11, true); } }, this.face(c, 0.4, 'hit')];
  },
  ultronPlan(c) {
