    if (opts.chars !== false) {
      for (const c of G.chars) {
        if (!c.alive || c.dormant || c === opts.ignore || c.state === 'bus') continue;
        const ddx = c.pos.x - ox, ddz = c.pos.z - oz;
        const along = ddx * dx + ddz * dz;
        if (along < -2 || along > best + 2) continue;
        const r = this.rayChar(c, ox, oy, oz, dx, dy, dz, best);
        if (r && r.t < best) { best = r.t; hit = { kind: 'char', char: c, head: r.head }; }
      }
    }
    if (!hit) return null;
    hit.t = best;
    hit.point = new THREE.Vector3(ox + dx * best, oy + dy * best, oz + dz * best);
    return hit;
  },
};

// ---- world.js ----
'use strict';
const ZERO_M4 = new THREE.Matrix4().makeScale(0, 0, 0);
// ===== Island generation: terrain, water, sky, trees, rocks, named locations =====
const SQ2 = Math.SQRT2;
const GEO = {};
function makeGeometries() {
  GEO.wallAlongX = new THREE.BoxGeometry(4, 4, 0.3);
  GEO.wallAlongZ = new THREE.BoxGeometry(0.3, 4, 4);
  GEO.floor = new THREE.BoxGeometry(4, 0.3, 4);
  GEO.ramp = new THREE.BoxGeometry(4 * SQ2, 0.3, 4);
  GEO.cone = new THREE.ConeGeometry(2 * SQ2, 2, 4, 1); GEO.cone.rotateY(Math.PI / 4);
