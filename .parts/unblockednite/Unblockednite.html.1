};

// ---- events.js ----
'use strict';
// ===== Match variety =====
// EXPOSE: like Fortnite's medallions, anyone carrying boss powers shows up on everyone's map. One kit
//   pings a rough area every 10 s; two kits every 5 s and closer; three or more, almost live. Bots
//   nearby start hunting them.
// EVENTS: after the first storm circle closes, 2-3 random events happen at random times: supply drops,
//   a Doom airship crash with a Mythic vault, an elite bot squad, a storm surge, a hidden Mythic chest.
//   The plan comes from the match seed, so every player in a party gets the same events.

const EXPOSE = {
  marks: [], // { c, x, z, r, color, t }
  t: 0,
  reset() { this.marks = []; this.t = 0; },
  update(dt) {
    this.t -= dt;
    for (const c of G.chars) {
      if (!c.pw || !c.alive || c.state === 'dead') { if (c.reveal) c.reveal = null; continue; }
      const k = c.pw.kits.length, every = k >= 3 ? 2 : k === 2 ? 5 : 10, fuzz = k >= 3 ? 4 : k === 2 ? 16 : 35;
      if (!c.reveal || G.time - c.reveal.t > every) {
        const a = Math.random() * TAU, d = Math.random() * fuzz;
        c.reveal = { x: c.pos.x + Math.cos(a) * d, z: c.pos.z + Math.sin(a) * d, r: fuzz + 8, t: G.time, color: POWER_COLORS[c.power] || '#ffd84a' };
        // the host's bots go after whoever is lit up
        if (!NET.client) this.sendHunters(c, k);
      }
    }
  },
  sendHunters(c, k) {
    // a capped pack: 5 hunters for one kit, +2 for each extra kit
    let n = BOTS.list.filter(b => b.ai && b.ai.hunt && b.ai.hunt.c === c && b.alive).length;
    const cap = 5 + 2 * (k - 1);
    for (const b of BOTS.list) {
      if (n >= cap) break;
      if (!b.alive || b.dormant || b.henchman || b === c || !b.ai || (c.team && b.team === c.team)) continue;
      if (b.ai.target || b.pos.distanceTo(c.pos) > 260) continue;
      if (Math.random() < Math.min(0.55, 0.12 * k)) { b.ai.hunt = { c, until: G.time + 30 }; n++; }
    }
  },
  // map pings (minimap and big map), pulsing circles around where each power holder was seen
  draw(g, toPx, scale) {
    for (const c of G.chars) {
      const r = c.reveal;
      if (!r || c === G.player) continue;
      const [x, y] = toPx(r.x, r.z), pulse = 0.5 + 0.5 * Math.sin(G.time * 5);
      g.save();
      g.strokeStyle = r.color; g.lineWidth = 2; g.globalAlpha = 0.5 + 0.4 * pulse;
      g.beginPath(); g.arc(x, y, Math.max(6, r.r * scale), 0, TAU); g.stroke();
      g.fillStyle = r.color; g.globalAlpha = 0.18; g.fill();
      g.globalAlpha = 1; g.fillStyle = r.color; g.beginPath(); g.arc(x, y, 3, 0, TAU); g.fill();
      g.restore();
    }
  },
};
const POWER_COLORS = { doom: '#3dff6e', ironman: '#ffb02e', thanos: '#b04aff', adam: '#ff4a5e' };

const EVENTS = {
  plan: [], marks: [], drops: [], seed: 0,

  // build the match's event list (inside the seeded setup, so every peer gets the same one)
  make(seed) {
    this.seed = seed; this.plan = []; this.marks = []; this.drops = []; this.timers = [];
    // Reload is chaos: events start while the bus is still flying and keep coming every 10-20 s
    // for the whole match (storm surges capped at 2 so the storm doesn't end it in a minute)
    if (G.arena) return; // arena fights are just the fight
    if (G.reload) {
      const kinds = ['supply', 'supply', 'crash', 'elite', 'mythic', 'meteor', 'meteor', 'lootrain', 'lootrain', 'surge'];
      let t = 6, surges = 0, i = 0;
      while (t < 300) {
        let kind = kinds[Math.floor(Math.random() * kinds.length)];
        if (kind === 'surge' && ++surges > 2) kind = 'meteor';
        this.plan.push({ kind, after: t, done: false, i: i++ });
        t += rand(10, 20);
      }
      return;
    }
    const pool = ['supply', 'supply', 'crash', 'elite', 'surge', 'mythic'];
    const n = Math.random() < 0.5 ? 2 : 3;
    let t = 0;
    for (let i = 0; i < n; i++) {
      const kind = pool.splice(Math.floor(Math.random() * pool.length), 1)[0];
      t += rand(35, 110);
      this.plan.push({ kind, after: t, done: false, i });
    }
  },
  // events wait for the first storm circle to close; times count from then
  update(dt) {
    ITEMS.quiet = true;
    try { this.step(dt); } finally { ITEMS.quiet = false; }
  },
  step(dt) {
    if ((G.reload || STORM.phase >= 1) && this.start === undefined) this.start = G.time;
    if (this.start === undefined) return;
    for (const e of this.plan) if (!e.done && G.time - this.start >= e.after) { e.done = true; this.fire(e); }
    for (let i = this.timers.length - 1; i >= 0; i--) if (G.time >= this.timers[i].at) { const tm = this.timers.splice(i, 1)[0]; tm.fn(); }
    for (let i = this.drops.length - 1; i >= 0; i--) {
      const d = this.drops[i];
      d.obj.position.y = Math.max(d.y, d.obj.position.y - dt * d.speed);
      if (d.spin) d.obj.rotation.y += dt * 0.6;
      if (d.obj.position.y <= d.y + 0.01) { this.drops.splice(i, 1); d.land(); }
    }
    for (let i = this.marks.length - 1; i >= 0; i--) if (this.marks[i].until < G.time) this.marks.splice(i, 1);
  },
  reset() { this.plan = []; this.marks = []; this.drops = []; this.timers = []; this.start = undefined; },
  // the same random numbers on every peer for this event
  rng(e) { return mulberry32((this.seed + 7919 * (e.i + 1)) >>> 0); },
  // a dry, open spot inside the next safe zone
  spot(R, r0 = 0) {
    const Z = STORM.next.r > 30 ? STORM.next : STORM.cur;
    for (let t = 0; t < 80; t++) {
      const a = R() * TAU, d = r0 + Math.sqrt(R()) * Math.max(10, Z.r * 0.8 - r0);
      const x = Z.x + Math.cos(a) * d, z = Z.z + Math.sin(a) * d, h = WORLD.heightAt(x, z);
      if (h > 2 && h < 45 && !WORLD.nearBuilding(x, z, 4) && !PHYS.blockedAt(x, z, h, 2)) return { x, y: h, z };
    }
    return { x: Z.x, y: WORLD.heightAt(Z.x, Z.z), z: Z.z };
  },
  mark(x, z, label, color, secs) { this.marks.push({ x, z, label, color, until: G.time + secs }); },
  announce(title, sub) { HUD.banner(title, sub); SFX.play('horn', 0.5); },
  fire(e) { this['ev_' + e.kind](e, this.rng(e)); },

  // ---- supply drop: a crate floats down under a balloon; the chest inside has top loot ----
  ev_supply(e, R) {
    const p = this.spot(R), g = new THREE.Group();
    const crate = new THREE.Mesh(GEO.box, new THREE.MeshLambertMaterial({ color: 0x2f7bd6, emissive: 0x0a1f40 })); crate.scale.set(1.6, 1.2, 1.6); crate.position.y = 0.6; g.add(crate);
    const band = new THREE.Mesh(GEO.box, new THREE.MeshLambertMaterial({ color: 0xffd84a })); band.scale.set(1.7, 0.2, 1.7); band.position.y = 0.6; g.add(band);
    const balloon = new THREE.Mesh(new THREE.SphereGeometry(1.6, 14, 10), new THREE.MeshLambertMaterial({ color: 0xff4a5e })); balloon.position.y = 5.2; balloon.userData.ownGeo = true; g.add(balloon);
    g.position.set(p.x, p.y + 110, p.z);
    WORLD.group.add(g);
    this.announce('SUPPLY DROP INCOMING', 'Top-tier loot is falling into the safe zone. It is marked on your map.');
    this.mark(p.x, p.z, 'Supply Drop', '#3d9bff', 70);
    const loot = [ITEMS.makeWeapon(pick(['ar', 'smg', 'shotgun'], R), 4), ITEMS.makeWeapon(pick(['sniper', 'handcannon', 'minigun', 'quad'], R), 4), ITEMS.makeCons('big', 2), ITEMS.makeCons('mini', 3), { kind: 'mats', type: 'brick', count: 100 }, { kind: 'ammo', type: 'medium', count: 60 }];
    this.drops.push({ obj: g, y: p.y, speed: 7, spin: true, land: () => {
      WORLD.group.remove(g);
      const ch = ITEMS.addChest(p.x, p.y, p.z, R() * TAU);
      ch.loot = loot; ITEMS.makeGold(ch);
      FX.sparkle(new THREE.Vector3(p.x, p.y + 1, p.z), 0x3d9bff);
    } });
  },

  // ---- one of Doom's airships comes down; the wreck holds a Mythic vault ----
  ev_crash(e, R) {
    const p = this.spot(R, 30);
    const ship = WORLD.airships && WORLD.airships.find((s) => !s.crashing);
    this.announce("DOOM'S AIRSHIP IS GOING DOWN", 'The wreck holds a vault with a Mythic weapon. Get there first.');
    this.mark(p.x, p.z, 'Airship Crash', '#3dff6e', 90);
    const land = () => {
      FX.explodeAt(new THREE.Vector3(p.x, p.y + 1, p.z), null, 0, 12, 400);
      FX.explosion(new THREE.Vector3(p.x, p.y + 2, p.z), 8);
      const ch1 = ITEMS.addChest(p.x + 2, p.y, p.z, 0), ch2 = ITEMS.addChest(p.x - 2, p.y, p.z + 1, Math.PI);
      ch1.loot = [ITEMS.makeWeapon(pick(['ar', 'shotgun', 'smg'], R), 4), ITEMS.makeCons('big', 2), { kind: 'ammo', type: 'shells', count: 20 }];
      ch2.loot = [ITEMS.makeWeapon(pick(['sniper', 'handcannon', 'quad'], R), 4), ITEMS.makeCons('medkit', 1), { kind: 'mats', type: 'metal', count: 80 }];
      ch1.base.material = ch1.lidM.material = ch2.base.material = ch2.lidM.material = MATS.vaultChest;
      ITEMS.spawnPickup({ kind: 'weapon', id: 'arcane', rarity: 5, mag: 9999 }, p.x, p.y + 0.5, p.z - 2, false);
      // smoking wreck
      const wreck = new THREE.Mesh(GEO.round, MATS.airship); wreck.scale.set(2.4, 1.6, 7); wreck.position.set(p.x, p.y + 1, p.z + 6); wreck.rotation.set(0.3, R() * TAU, 0.4);
      WORLD.group.add(wreck);
    };
    if (ship) {
      ship.crashing = true;
      const obj = ship.g; WORLD.airships.splice(WORLD.airships.indexOf(ship), 1);
      obj.position.set(p.x, p.y + 120, p.z);
      this.drops.push({ obj, y: p.y, speed: 22, land: () => { WORLD.group.remove(obj); land(); } });
    } else land();
  },

  // ---- an elite squad of sweaty bots hunts the nearest players ----
  ev_elite(e, R) {
    const p = this.spot(R);
    const pool = BOTS.list.filter((b) => b.alive && !b.dormant && !b.henchman && b.state === 'ground').sort((a, b) => a.nid - b.nid);
    const squad = [];
    while (squad.length < 4 && pool.length) squad.push(pool.splice(Math.floor(R() * pool.length), 1)[0]);
    if (!squad.length) return;
    this.announce('AN ELITE SQUAD HAS DROPPED IN', 'Four sweaty bots with Legendary loot are hunting the closest players.');
    this.mark(p.x, p.z, 'Elite Squad', '#ff8a3d', 45);
    for (const b of squad) {
      b.name = '★ ' + b.name.replace(/^★ /, '');
      if (NET.client) continue; // the host runs bots
      const q = WORLD.randomLandPoint(p.x, p.z, 8);
      b.pos.set(q.x, WORLD.heightAt(q.x, q.z) + 0.5, q.z); b.vel.set(0, 0, 0);
      b.slots[0] = ITEMS.makeWeapon(pick(['ar', 'smg']), 4); b.slots[1] = ITEMS.makeWeapon('shotgun', 4); b.sel = 0;
      b.shield = 100; b.hp = 100; b.mats.brick = 200;
      b.skill.aimErr *= 0.55; b.skill.react *= 0.6; b.skill.build = 0.9; b.skill.sight *= 1.3;
      const humans = G.chars.filter((h) => h.human && h.alive && (!b.team || h.team !== b.team));
      const near = humans.sort((x, y) => x.pos.distanceTo(b.pos) - y.pos.distanceTo(b.pos))[0];
      if (near) b.ai.hunt = { c: near, until: G.time + 120 };
    }
  },

  // ---- the storm surges: the next circle starts closing right away and hurts more ----
  ev_surge() {
    this.announce('STORM SURGE', 'The storm is closing early and hits harder. Move!');
    if (NET.client) return;
    if (STORM.state === 'wait') STORM.timer = Math.min(STORM.timer, 8);
    STORM.dps += 2;
  },

  // ---- a hidden golden chest somewhere with a Mythic inside (no announcement, just a light) ----
  ev_mythic(e, R) {
    const p = this.spot(R);
    const ch = ITEMS.addChest(p.x, p.y, p.z, R() * TAU);
    ch.loot = [{ kind: 'weapon', id: pick(['repulsor', 'gauntlet'], R), rarity: 5, mag: 9999 }, ITEMS.makeCons('big', 1)];
    ch.base.material = ch.lidM.material = MATS.vaultChest;
    const beam = new THREE.Mesh(new THREE.CylinderGeometry(0.5, 0.5, 120, 10, 1, true), new THREE.MeshBasicMaterial({ color: 0xffd84a, transparent: true, opacity: 0.35, side: THREE.DoubleSide, depthWrite: false }));
    beam.position.set(p.x, p.y + 60, p.z); beam.userData.ownGeo = true;
    WORLD.group.add(beam);
    ch.beam = beam;
    HUD.toast('Something golden is glowing on the island...');
  },

  // ---- (Reload) meteor shower: burning rocks rain on a marked zone for ~15 s ----
  ev_meteor(e, R) {
    const p = this.spot(R);
    this.announce('METEOR SHOWER', 'Rocks are raining down on the marked zone. Get out or get cover!');
    this.mark(p.x, p.z, 'Meteors', '#ff5a2b', 22);
    if (!this._metGeo) { this._metGeo = new THREE.IcosahedronGeometry(1.1, 0); this._metMat = new THREE.MeshLambertMaterial({ color: 0x5a2b1a, emissive: 0xff5a00, emissiveIntensity: 0.9 }); }
    for (let k = 0; k < 26; k++) {
      const a = R() * TAU, d = Math.sqrt(R()) * 24, x = p.x + Math.cos(a) * d, z = p.z + Math.sin(a) * d;
      this.timers.push({ at: G.time + 3 + k * 0.55, fn: () => {
        const y = WORLD.heightAt(x, z), m = new THREE.Mesh(this._metGeo, this._metMat);
        m.position.set(x, y + 90, z); WORLD.group.add(m);
        this.drops.push({ obj: m, y, speed: 70, land: () => {
          WORLD.group.remove(m);
          FX.explodeAt(new THREE.Vector3(x, y + 0.8, z), null, NET.client ? 0 : 38, 5.5, 160);
        } });
      } });
    }
  },
  // ---- (Reload) loot rain: a burst of Epic and Legendary guns and heals falls on one spot ----
  ev_lootrain(e, R) {
    const p = this.spot(R);
    this.announce('LOOT RAIN', 'Epic and Legendary loot is falling from the sky at the marked spot!');
    this.mark(p.x, p.z, 'Loot Rain', '#ffd84a', 40);
    const guns = ['ar', 'shotgun', 'smg', 'sniper', 'handcannon', 'minigun', 'quad', 'rocket'];
    for (let k = 0; k < 14; k++) {
      const a = R() * TAU, d = R() * 6, x = p.x + Math.cos(a) * d, z = p.z + Math.sin(a) * d;
      const item = k % 4 === 3 ? ITEMS.makeCons(pick(['big', 'mini', 'medkit'], R)) : ITEMS.makeWeapon(pick(guns, R), R() < 0.55 ? 4 : 3);
      this.timers.push({ at: G.time + k * 0.25, fn: () => ITEMS.spawnPickup(item, x, WORLD.heightAt(x, z) + 30, z, true) });
    }
  },

  // event markers on the maps
  draw(g, toPx) {
    for (const m of this.marks) {
      const [x, y] = toPx(m.x, m.z);
      g.save();
      g.fillStyle = m.color; g.strokeStyle = '#fff'; g.lineWidth = 2;
      g.beginPath(); g.moveTo(x, y - 9); g.lineTo(x + 7, y); g.lineTo(x, y + 9); g.lineTo(x - 7, y); g.closePath(); g.fill(); g.stroke();
      g.restore();
    }
  },
};

// ---- net.js ----
'use strict';
// ===== Multiplayer: peer-to-peer parties over WebRTC (PeerJS) =====
// The host's browser runs the world (bots, bosses, storm) and sends a snapshot ~15x a second.
// Every player simulates their own movement and sends it to the host, who relays it to the others.
// Clients detect their own hits and send them to the host, who applies the damage.
// Party codes are 4 letters; the PeerJS public server only introduces the browsers to each other.
const NET_PREFIX = 'unblockednite-v1-';
const NET_RATE = 1 / 15;

// Math.random swapped for a seeded generator while every peer builds the same match
// three.js draws its object UUIDs from Math.random too, and how many objects get made depends on what's
// already cached in that browser. Those calls get an unseeded number so they can't shift the match's
// random stream (otherwise a friend's island could come out slightly different).
function withSeed(seed, fn) {
  const real = Math.random, rnd = mulberry32(seed >>> 0), lim = Error.stackTraceLimit;
  Math.random = function () {
    Error.stackTraceLimit = 2;
    const st = new Error().stack || '';
    Error.stackTraceLimit = lim;
    return st.indexOf('/three') >= 0 ? real() : rnd();
  };
  try { return fn(); } finally { Math.random = real; Error.stackTraceLimit = lim; }
}

const NET = {
  peer: null, role: null, code: '', conns: [], conn: null,
  roster: [], me: null, status: '', inMatch: false, sendT: 0,
  byNid: [], outHits: [], outShots: [],
  get host() { return this.role === 'host' && this.inMatch; },
  get client() { return this.role === 'client' && this.inMatch; },
  get party() { return !!this.role; },

  // ---------- party ----------
  myInfo() { const d = PROFILE.data; return { name: PROFILE.displayName(), outfit: d.outfit, level: d.level, crowned: !!d.crowned }; },
  available() { return typeof Peer !== 'undefined'; },
  // your outfit / name changed in the lobby
  sendInfo() {
    if (this.role === 'client' && this.conn && this.conn.open) this.conn.send({ t: 'info', info: this.myInfo() });
    else if (this.role === 'host') { const me = this.roster[0]; if (me) { Object.assign(me, this.myInfo()); this.sendRoster(); LOBBY.onParty(); } }
  },
  create(cb) {
    if (!this.available()) return cb && cb('Multiplayer needs an internet connection (PeerJS did not load).');
    this.leave();
    const tryCode = (tries) => {
      const A = 'ABCDEFGHJKLMNPQRSTUVWXYZ';
      const code = Array.from({ length: 4 }, () => A[Math.floor(Math.random() * A.length)]).join('');
      const p = new Peer(NET_PREFIX + code, { debug: 0 });
      p.on('open', () => {
        this.peer = p; this.role = 'host'; this.code = code; this.me = p.id;
        this.roster = [Object.assign({ pid: p.id }, this.myInfo())];
        this.status = 'Party ready: share the code';
        p.on('connection', (c) => this.onJoin(c));
        LOBBY.onParty(); cb && cb(null);
      });
      p.on('error', (e) => {
        if (e.type === 'unavailable-id' && tries < 5) { p.destroy(); tryCode(tries + 1); return; }
        if (this.peer === p) this.fail(e); else cb && cb(this.errText(e));
      });
      p.on('disconnected', () => { if (this.peer === p && !p.destroyed) p.reconnect(); });
    };
    tryCode(0);
  },
  join(code, cb) {
    if (!this.available()) return cb && cb('Multiplayer needs an internet connection (PeerJS did not load).');
    code = String(code || '').toUpperCase().replace(/[^A-Z]/g, '');
    if (code.length !== 4) return cb && cb('Party codes are 4 letters.');
    this.leave();
    const p = new Peer({ debug: 0 });
    p.on('open', () => {
      const c = p.connect(NET_PREFIX + code, { reliable: true });
      const timeout = setTimeout(() => { if (this.role !== 'client') { cb && cb('Could not reach that party. Check the code (and that the host is in the lobby).'); this.leave(); } }, 12000);
      c.on('open', () => {
        clearTimeout(timeout);
        this.peer = p; this.conn = c; this.role = 'client'; this.code = code; this.me = p.id;
        c.send({ t: 'hello', info: this.myInfo() });
        this.status = 'Joined: waiting for the host to start';
        cb && cb(null);
      });
      c.on('data', (m) => this.onClientMsg(m));
      c.on('close', () => { if (this.conn === c) { this.dropped('The host left the party.'); } });
      c.on('error', () => {});
    });
    p.on('error', (e) => { if (this.role !== 'client') cb && cb(this.errText(e)); else this.fail(e); });
  },
  leave() {
    try { if (this.conn) this.conn.close(); } catch (e) { /* closed */ }
    for (const c of this.conns) { try { c.close(); } catch (e) { /* closed */ } }
    try { if (this.peer) this.peer.destroy(); } catch (e) { /* gone */ }
    this.peer = null; this.conn = null; this.conns = []; this.role = null; this.code = ''; this.roster = []; this.inMatch = false;
    if (typeof LOBBY !== 'undefined' && LOBBY.el.lobby) LOBBY.onParty();
  },
  errText(e) {
    return e.type === 'peer-unavailable' ? 'No party with that code (the host must be in the lobby).'
      : e.type === 'network' || e.type === 'server-error' || e.type === 'socket-error' ? 'Could not reach the matchmaking server. Check your internet.'
        : e.type === 'browser-incompatible' ? 'This browser cannot do peer-to-peer.' : 'Connection problem (' + e.type + ').';
  },
  fail(e) { this.dropped(this.errText(e)); },
  dropped(msg) {
    const wasMatch = this.inMatch;
    this.leave();
    if (typeof HUD !== 'undefined' && wasMatch) HUD.toast(msg);
    if (typeof LOBBY !== 'undefined') LOBBY.toast(msg);
  },

  // host: someone connected
  onJoin(c) {
    c.on('data', (m) => this.onHostMsg(c, m));
    c.on('close', () => this.onLeft(c));
    c.on('error', () => {});
  },
  onLeft(c) {
    this.conns = this.conns.filter((x) => x !== c);
    const who = this.roster.find((r) => r.pid === c.peer);
    this.roster = this.roster.filter((r) => r.pid !== c.peer);
    this.sendRoster(); LOBBY.onParty();
    if (who) { (this.inMatch ? HUD : LOBBY).toast(who.name + ' left the party'); }
    // in a match their character just stands there; finish them off so the game can end
    if (this.inMatch) { const ch = G.chars.find((x) => x.peerId === c.peer && x.alive); if (ch) CHARS.damage(ch, 99999, null, { direct: true }); }
  },
  sendRoster() { for (const c of this.conns) c.send({ t: 'roster', list: this.roster }); },
  broadcast(m, except) { for (const c of this.conns) if (c !== except && c.open) c.send(m); },

  // ---------- gameplay events (builds, broken walls, chests, loot) ----------
  // the sender has already applied it; the host relays it to everyone else
  ev(m) {
    if (HANG.on) return HANG.send(m);
    if (!this.inMatch) return;
    if (this.role === 'host') this.broadcast(m);
    else if (this.conn && this.conn.open) this.conn.send(m);
  },
  applyEvent(m) {
    if (m.t === 'bp') BUILD.placeRemote(m);
    else if (m.t === 'sd') { const s = PHYS.byKey.get(m.k); if (s && s.alive) { s._remote = true; WORLD.destroySolid(s); } }
    else if (m.t === 'co') { const ch = ITEMS.chests[m.i]; if (ch) ITEMS.openChest(ch, null, true); }
    else if (m.t === 'ps') { if (!ITEMS.pickups.some(p => p.id === m.id)) { const p = ITEMS.spawnPickup(m.it, m.p[0], m.p[1], m.p[2], !!m.pop, m.id); if (m.v) p.vel.set(m.v[0], m.v[1], m.v[2]); } }
    else if (m.t === 'pr') { const p = ITEMS.pickups.find(q => q.id === m.id); if (p) ITEMS.removePickup(p, true); }
    else if (m.t === 'rv') { const ch = this.byNid[m.n]; if (ch) POWERS.revoke(ch, m.id, true); }
    else if (m.t === 'gr') { const ch = this.byNid[m.n]; if (ch) POWERS.grant(ch, m.id, true); }
  },
  EVENTS: ['bp', 'sd', 'co', 'ps', 'pr', 'gr', 'rv'],
  // party chat (works in the lobby and in a match)
  chat(text) {
    text = String(text || '').trim().slice(0, 140);
    if (HANG.on) { if (text) HANG.chat(text); return; }
    if (!text || !this.role) return;
    const m = { t: 'chat', n: PROFILE.displayName(), m: text };
    CHAT.add(m.n, m.m, true);
    if (this.role === 'host') this.broadcast(m);
    else if (this.conn && this.conn.open) this.conn.send(m);
  },

  // ---------- messages ----------
  onHostMsg(c, m) {
    if (m.t === 'chat') { CHAT.add(m.n, m.m); this.broadcast(m, c); return; }
    if (m.t === 'hello') {
      if (this.inMatch) { c.send({ t: 'busy' }); setTimeout(() => c.close(), 500); return; }
      if (this.roster.length >= 8) { c.send({ t: 'full' }); setTimeout(() => c.close(), 500); return; }
      if (!this.conns.includes(c)) this.conns.push(c);
      this.roster = this.roster.filter((r) => r.pid !== c.peer).concat([Object.assign({ pid: c.peer }, m.info)]);
      this.sendRoster(); LOBBY.onParty(); LOBBY.toast(m.info.name + ' joined your party');
    } else if (m.t === 'info') {
      const r = this.roster.find((x) => x.pid === c.peer); if (r) { Object.assign(r, m.info); this.sendRoster(); LOBBY.onParty(); }
    } else if (!this.inMatch) return;
    else if (this.EVENTS.includes(m.t)) { this.applyEvent(m); this.broadcast(m, c); }
    else if (m.t === 's') {
      const ch = G.chars.find((x) => x.peerId === c.peer);
      if (ch) this.applyRemote(ch, m);
      if (m.sh && m.sh.length) for (const s of m.sh) FX.tracer(new THREE.Vector3(s[0], s[1], s[2]), new THREE.Vector3(s[3], s[4], s[5]), s[6], !!s[7]);
      if (m.sh && m.sh.length) this.outShots.push(...m.sh);
    } else if (m.t === 'hit') {
      const att = G.chars.find((x) => x.peerId === c.peer), tgt = this.byNid[m.n];
      if (att && tgt) CHARS.damage(tgt, m.a, m.self ? null : att, { head: m.h, weapon: m.w, direct: !!m.d, fall: !!m.fall, net: true });
    } else if (m.t === 'reboot') {
      REBOOT.revive(m.n, m.v);
    } else if (m.t === 'set') {
      const ch = G.chars.find((x) => x.peerId === c.peer);
      if (ch && ch.alive) { ch.hp = Math.min(ch.maxHp || 100, m.hp); ch.shield = Math.min(ch.maxShield || 100, m.sh); }
    }
  },
  onClientMsg(m) {
    if (m.t === 'chat') { CHAT.add(m.n, m.m); return; }
    if (m.t === 'roster') { this.roster = m.list; LOBBY.onParty(); }
    else if (m.t === 'busy') this.dropped('That party is already in a match. Try again when they are back in the lobby.');
    else if (m.t === 'full') this.dropped('That party is full.');
    else if (m.t === 'start') { this.roster = m.roster; startMatch({ seed: m.seed, mode: m.mode, diff: m.diff, bots: m.bots, zb: m.zb, arena: m.arena }); }
    else if (!this.inMatch) return;
    else if (this.EVENTS.includes(m.t)) this.applyEvent(m);
    else if (m.t === 'w') this.applyWorld(m);
    else if (m.t === 'tolobby') { HUD.toast('The host went back to the lobby'); setTimeout(() => { if (this.inMatch) { toLobby(); LOBBY.toast('The host ended the match'); } }, 1200); }
    else if (m.t === 'elim') {
      const v = this.byNid[m.v], k = m.k >= 0 ? this.byNid[m.k] : null;
      if (v && v.alive) CHARS.eliminate(v, k, m.w);
    } else if (m.t === 'revoke') { const ch = this.byNid[m.n]; if (ch) POWERS.revoke(ch, m.id, true);
    } else if (m.t === 'grant') { const ch = this.byNid[m.n]; if (ch) POWERS.grant(ch, m.id); }
    else if (m.t === 'revive') { const ch = this.byNid[m.n]; if (ch && !ch.alive) REBOOT.bringBack(ch, REBOOT.vans[m.v]); }
  },

  // ---------- match ----------
  // host: start everyone on the same seed
  startParty() {
    const mode = PROFILE.data.mode;
    const M = MODES[mode] || MODES.solo;
    const seed = (Math.random() * 1e9) | 0;
    const msg = { t: 'start', seed, mode, diff: M.diff(), bots: Math.max(1, M.bots() - (this.roster.length - 1)), zb: !!PROFILE.data.zeroBuild, arena: M.arena ? ARENA.cfg() : null, roster: this.roster };
    this.broadcast(msg);
    startMatch({ seed, mode, diff: msg.diff, bots: msg.bots, zb: msg.zb, arena: msg.arena });
  },
  // called by startMatch once every character exists (same order on every peer)
  begin() {
    this.inMatch = true; this.sendT = 0; this.outHits = []; this.outShots = [];
    this.byNid = G.chars.slice();
    G.chars.forEach((c, i) => { c.nid = i; });
  },
  end() { this.inMatch = false; },

  // remote players are puppets: no physics or AI, they follow the latest state they sent
  applyRemote(c, m) {
    c.netTo = c.netTo || new THREE.Vector3();
    c.netTo.set(m.p[0], m.p[1], m.p[2]);
    c.vel.set(m.v[0], m.v[1], m.v[2]);
    c.netYaw = m.yw; c.pitch = m.pt;
    if (m.st && c.state !== 'dead' && c.alive) {
      if (c.state === 'bus' && m.st !== 'bus') c.pos.copy(c.netTo);
      c.state = m.st;
    }
    this.applyItem(c, m.it);
    c.buildType = m.b ? 'wall' : null;
    if (m.e && (!c.emote || c.emote.id !== m.e)) { c.emote = { id: m.e, t: 0 }; if (c.model) c.model.anim = null; }
    else if (!m.e && c.emote) c.emote = null;
    c.onGround = !!m.g;
    c.netVeh = m.vh === undefined ? -1 : m.vh;
    c.netSeen = G.time;
  },
  applyItem(c, it) {
    if (!it) { c.sel = -1; return; }
    const id = it.slice(0, -1), r = +it.slice(-1);
    if (!WEAPONS[id] && !CONSUMABLES[id]) return;
    const item = WEAPONS[id] ? { kind: 'weapon', id, rarity: r, mag: 9999, special: true } : { kind: 'cons', id, count: 1 };
    const cur = c.slots[0];
    if (!cur || cur.id !== id || cur.rarity !== item.rarity) c.slots[0] = item;
    c.sel = 0;
  },
  puppetStep(c, dt) {
    if (!c.netTo) return;
    if (c.state === 'bus') { c.pos.copy(BUS.pos); return; }
    const k = Math.min(1, dt * 12);
    if (c.pos.distanceToSquared(c.netTo) > 400) c.pos.copy(c.netTo); else c.pos.lerp(c.netTo, k);
    if (c.netYaw !== undefined) c.yaw = c.yaw + wrapAngle(c.netYaw - c.yaw) * k;
    // driving: their car follows them and they're hidden inside it
    if (c.netVeh >= 0) { VEH.follow(c, c.netVeh); if (c.model) c.model.root.visible = false; }
    else if (c.vehicle) { c.vehicle.driver = null; c.vehicle = null; }
    if (c.isSmasher && c.hp < c.maxHp && G.time - c.lastHitTime > 3 && this.host) c.hp = Math.min(c.maxHp, c.hp + 25 * dt);
  },

  // ---------- per-frame send ----------
  update(dt) {
    if (!this.inMatch) return;
    this.sendT -= dt;
    if (this.sendT > 0) return;
    this.sendT = NET_RATE;
    if (this.role === 'host') this.sendWorld();
    else this.sendSelf();
  },
  itemCode(c) {
    if (c.buildType) return '';
    const it = CHARS.currentItem(c);
    if (!it || it.id === 'pickaxe') return '';
    return it.id + (it.rarity || 0);
  },
  sendSelf() {
    const c = G.player;
    if (!c || !this.conn || !this.conn.open) return;
    const r = (v) => Math.round(v * 100) / 100;
    this.conn.send({ t: 's', p: [r(c.pos.x), r(c.pos.y), r(c.pos.z)], v: [r(c.vel.x), r(c.vel.y), r(c.vel.z)], yw: r(c.yaw), pt: r(c.pitch), st: c.state, g: c.onGround ? 1 : 0, vh: c.vehicle ? c.vehicle.id : -1, it: this.itemCode(c), b: c.buildType ? 1 : 0, e: c.emote ? c.emote.id : 0, sh: this.outShots.splice(0) });
  },
  // host: everyone's position, health and what they hold, plus the storm
  sendWorld() {
    if (!this.conns.length) return;
    const r = (v) => Math.round(v * 100) / 100, out = [];
    const r1 = (v) => Math.round(v * 10) / 10;
    for (const c of this.byNid) {
      if (!c) continue;
      // eliminated players are sent a few more times, then dropped from the snapshot
      if (!c.alive) { c.netDeadSent = (c.netDeadSent || 0) + 1; if (c.netDeadSent > 5) continue; }
      out.push([c.nid, r1(c.pos.x), r1(c.pos.y), r1(c.pos.z), r(c.yaw), r(c.pitch), c.state, Math.round(c.hp), Math.round(c.shield), this.itemCode(c), c.alive ? 1 : 0, c.emote ? c.emote.id : 0, c.maxHp || 100, c.onGround ? 1 : 0, r1(c.vel.x), r1(c.vel.z), c.vehicle ? c.vehicle.id : -1]);
    }
    const S = STORM, st = [S.cur.x, S.cur.z, S.cur.r, S.next.x, S.next.z, S.next.r, S.phase, S.state, r(S.timer), S.dps];
    const msg = { t: 'w', c: out, s: st, sh: this.outShots.splice(0) };
    for (const conn of this.conns) if (conn.open) conn.send(msg);
  },
  // client: copy the host's world (except your own movement)
  applyWorld(m) {
    const me = G.player;
    for (const a of m.c) {
      const c = this.byNid[a[0]];
      if (!c) continue;
      if (c === me) {
        // the host is in charge of your health
        if (c.alive) { c.hp = a[7]; c.shield = a[8]; c.maxHp = a[12]; }
        continue;
      }
      c.netTo = c.netTo || new THREE.Vector3();
      c.netTo.set(a[1], a[2], a[3]); c.netYaw = a[4]; c.pitch = a[5];
      if (c.alive && c.state !== 'dead') { if (c.state === 'bus' && a[6] !== 'bus') c.pos.copy(c.netTo); c.state = a[6]; }
      c.hp = a[7]; c.shield = a[8]; c.maxHp = a[12]; c.onGround = !!a[13];
      c.vel.set(a[14], c.vel.y, a[15]);
      c.netVeh = a[16] === undefined ? -1 : a[16];
      this.applyItem(c, a[9]);
      const e = a[11];
      if (e && (!c.emote || c.emote.id !== e)) { c.emote = { id: e, t: 0 }; if (c.model) c.model.anim = null; }
      else if (!e && c.emote) c.emote = null;
    }
    const s = m.s, S = STORM;
    S.cur.x = s[0]; S.cur.z = s[1]; S.cur.r = s[2]; S.next.x = s[3]; S.next.z = s[4]; S.next.r = s[5]; S.phase = s[6]; S.state = s[7]; S.timer = s[8]; S.dps = s[9];
    if (m.sh) for (const t of m.sh) FX.tracer(new THREE.Vector3(t[0], t[1], t[2]), new THREE.Vector3(t[3], t[4], t[5]), t[6], !!t[7]);
  },

  // ---------- hooks used by the rest of the game ----------
  // a client's game never applies damage itself: its own hits go to the host, everything else is ignored
  clientDamage(c, amount, attacker, opts) {
    if (opts.net) return false;
    if (attacker === G.player || (c === G.player && !attacker && (opts.fall || opts.explosive))) {
      if (this.conn && this.conn.open) this.conn.send({ t: 'hit', n: c.nid, a: Math.round(amount), h: !!opts.head, w: opts.weapon || '', d: !!opts.direct, fall: !!opts.fall, self: c === G.player && !attacker });
      if (attacker === G.player && c !== G.player && c.alive) {
        FX.dmgNumber(_v1.set(c.pos.x, c.pos.y + 2.1, c.pos.z), Math.round(amount), opts.head ? 'head' : c.shield > 0 ? 'shield' : 'hp');
        HUD.hitMarker(opts.head);
        if (!opts.pellets || Math.random() < 0.34) SFX.play(opts.head ? 'headshot' : 'hit', 0.5);
      }
    }
    return true;
  },
  // host: tell everyone who went down
  onElim(c, killer, weapon) { if (this.host) this.broadcast({ t: 'elim', v: c.nid, k: killer && killer.nid !== undefined ? killer.nid : -1, w: weapon || '' }); },
  onGrant(c, id) { if (this.host) this.broadcast({ t: 'grant', n: c.nid, id }); },
  // shots fired by you (and on the host, by everyone) so the others see the tracer
  onShot(c, o, e, color, laser) {
    if (HANG.on) { if (c === G.player) HANG.shot(o, e, color, laser); return; }
    if (!this.inMatch) return;
    if (this.role === 'client' && c !== G.player) return;
    if (this.outShots.length > 40) return;
    const r = (v) => Math.round(v * 10) / 10;
    this.outShots.push([r(o.x), r(o.y), r(o.z), r(e.x), r(e.y), r(e.z), color, laser ? 1 : 0]);
  },
  // a client healed itself: the host keeps the score
  sendReboot(nid, van) { if (this.conn && this.conn.open) this.conn.send({ t: 'reboot', n: nid, v: van }); },
  onHeal(c) { if (this.client && c === G.player && this.conn && this.conn.open) this.conn.send({ t: 'set', hp: Math.round(c.hp), sh: Math.round(c.shield) }); },
};

// ---- party chat box (bottom left, in the lobby and in matches). Enter opens it, Enter sends, Esc closes ----
const CHAT = {
  log: [],
  el() { return { box: document.getElementById('chat'), list: document.getElementById('chat-list'), input: document.getElementById('chat-in') }; },
  add(name, text, mine) {
    this.log.push({ name, text, mine, t: performance.now() });
    if (this.log.length > 40) this.log.shift();
    this.render();
    if (!mine) SFX.play('click', 0.4);
  },
  render() {
    const E = this.el(); if (!E.list) return;
    E.box.hidden = !NET.role;
    E.list.innerHTML = this.log.slice(-8).map((l) => `<div class="cl${l.mine ? ' me' : ''}" data-t="${l.t}"><b>${esc(l.name)}:</b> ${esc(l.text)}</div>`).join('');
  },
  open() {
    const E = this.el(); if (!E.input || (!NET.role && !HANG.on)) return;
    if (document.pointerLockElement) document.exitPointerLock();
    E.box.classList.add('typing'); E.input.hidden = false; E.input.value = ''; E.input.focus();
  },
  close() { const E = this.el(); if (!E.input) return; E.input.blur(); E.input.hidden = true; E.box.classList.remove('typing'); },
  init() {
    const E = this.el(); if (!E.input) return;
    E.input.addEventListener('keydown', (e) => {
      e.stopPropagation();
      if (e.key === 'Enter') { NET.chat(E.input.value); this.close(); }
      else if (e.key === 'Escape') this.close();
    });
    window.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' || !NET.role || document.activeElement === E.input) return;
      if (document.activeElement && document.activeElement.tagName === 'INPUT') return;
      e.preventDefault(); this.open();
    });
    // old lines fade out
    setInterval(() => { const now = performance.now(); document.querySelectorAll('#chat-list .cl').forEach((d) => d.classList.toggle('old', now - +d.dataset.t > 12000)); }, 1000);
  },
};

// ---- board.js ----
'use strict';
// ===== Win leaderboard (Supabase, the site's shared accounts) =====
// Signing in uses the same accounts and saved login as Shoot & Open (shooter_players, the
// 'shooter_creds' localStorage entry), so if you're signed in on the site you're signed in here.
// A win is sent once per match through unf_record_win, which checks the password hash server-side
// (see leaderboard-setup.sql). Only a couple of small requests per match: no realtime traffic.
const BOARD = {
  URL: 'https://zznsfdcpondfnacherxv.supabase.co',
  KEY: 'sb_publishable_P6Xw_9hNrt-1_sKE7SsN7w_nN7eum3I',
  CREDS: 'shooter_creds',
  rows: null, err: '',

  headers() { return { apikey: this.KEY, Authorization: 'Bearer ' + this.KEY, 'Content-Type': 'application/json' }; },
  creds() { try { const c = JSON.parse(localStorage.getItem(this.CREDS) || 'null'); return c && c.u && c.p ? c : null; } catch (_) { return null; } },
  user() { const c = this.creds(); return c ? c.u : ''; },
  async hash(u, p) {
    const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(p + '::shooter::' + u.toLowerCase()));
    return Array.from(new Uint8Array(buf)).map((b) => b.toString(16).padStart(2, '0')).join('');
  },
  async signIn(u, p) {
    u = (u || '').trim();
    if (!u || !p) return 'Enter your username and password';
    try {
      const h = await this.hash(u, p);
      const r = await fetch(`${this.URL}/rest/v1/shooter_players?select=username&username=eq.${encodeURIComponent(u)}&password_hash=eq.${h}`, { headers: this.headers() });
      const rows = await r.json();
      if (!Array.isArray(rows) || !rows.length) return 'Wrong username or password';
      localStorage.setItem(this.CREDS, JSON.stringify({ u: rows[0].username, p }));
      PROFILE.dukeUnlock();
      return '';
    } catch (e) { return 'Could not reach the leaderboard'; }
  },
  signOut() { try { localStorage.removeItem(this.CREDS); } catch (_) {} },
  // the monthly skin vote
  async votes() { try { const r = await fetch(`${this.URL}/rest/v1/rpc/unf_vote_results`, { method: 'POST', headers: this.headers(), body: '{}' }); const j = await r.json(); return Array.isArray(j) ? j : []; } catch (e) { return []; } },
  async vote(choice) { try { await ACCOUNT.rpc('unf_vote', { p_choice: choice }); return ''; } catch (e) { return 'Could not vote'; } },
  // called once when you win a match
  async recordWin(elims) {
    const c = this.creds();
    if (!c) return;
    try {
      await fetch(`${this.URL}/rest/v1/rpc/unf_record_win`, { method: 'POST', headers: this.headers(), body: JSON.stringify({ p_user: c.u, p_hash: await this.hash(c.u, c.p), p_elims: elims | 0, p_cb: this.chromebook() }) });
    } catch (_) {}
  },
  chromebook() { return /CrOS/.test(navigator.userAgent); },
  // tab: 'wins' (all), 'cb_wins' (won on a Chromebook) or 'home_wins' (won on any other computer)
  async top(tab = 'wins') {
    try {
      const col = ['wins', 'cb_wins', 'home_wins'].includes(tab) ? tab : 'wins';
      const r = await fetch(`${this.URL}/rest/v1/unf_wins?select=username,wins,best_elims,cb_wins,home_wins&order=${col}.desc,updated_at.asc&limit=50` + (col !== 'wins' ? `&${col}=gt.0` : ''), { headers: this.headers() });
      const rows = await r.json();
      if (!Array.isArray(rows)) { this.err = 'The leaderboard is not set up yet'; return []; }
      this.err = ''; this.rows = rows;
      return rows;
    } catch (e) { this.err = 'Could not reach the leaderboard'; return []; }
  },
};

// ---- account.js ----
'use strict';
// ===== Accounts: sign in (or sign up) before playing, and cloud saves =====
// Uses the site's accounts (shooter_players, same login as Shoot & Open and the leaderboard). Your
// Unblockednite progress (coins, skins, emotes, level, stats) is saved to your account a couple of seconds
// after anything changes, and when you close the tab; signing in on another computer loads it.
// If the server can't be reached you can still play offline (saved on this browser only).
const ACCOUNT = {
  timer: 0, pending: false, offline: false,

  // ---------- the gate (shown before the game loads) ----------
  gate() {
    if (BOARD.creds()) return this.pull().then(() => {});
    return new Promise((done) => {
      const el = document.createElement('div');
      el.id = 'acct-gate';
      el.style.cssText = 'position:fixed;inset:0;z-index:100000;display:grid;place-items:center;background:radial-gradient(ellipse at 50% 20%,#1b3a8a,#070d22 70%);font:15px system-ui;color:#e8efff';
      el.innerHTML = `<div style="width:min(380px,92vw);background:#101a3a;border:1px solid #ffffff1a;border-radius:16px;padding:22px;display:grid;gap:10px">
        <h2 style="margin:0;font:900 28px system-ui;letter-spacing:.02em">UNBLOCKED<span style="color:#ffd84a">NITE</span></h2>
        <p style="margin:0 0 4px;color:#9fb4dd">Sign in to play. Your skins, coins and wins save to your account, on any computer.</p>
        <input id="acct-u" placeholder="Username" autocomplete="username" maxlength="20" style="padding:10px;border-radius:8px;border:1px solid #ffffff22;background:#0008;color:inherit;font:inherit">
        <input id="acct-p" type="password" placeholder="Password" autocomplete="current-password" style="padding:10px;border-radius:8px;border:1px solid #ffffff22;background:#0008;color:inherit;font:inherit">
        <div style="display:flex;gap:8px"><button id="acct-in" type="button" style="flex:1;padding:11px;border:0;border-radius:8px;background:#ffd84a;color:#1b1b1b;font:800 15px system-ui;cursor:pointer">Sign in</button>
        <button id="acct-up" type="button" style="flex:1;padding:11px;border:1px solid #ffd84a;border-radius:8px;background:transparent;color:#ffd84a;font:800 15px system-ui;cursor:pointer">Create account</button></div>
        <div id="acct-err" style="min-height:18px;color:#ff6b6b;font-size:13px"></div>
        <button id="acct-off" type="button" style="background:none;border:0;color:#9fb4dd;font:12px system-ui;text-decoration:underline;cursor:pointer;justify-self:center">Can't connect? Play offline (progress stays on this browser)</button>
      </div>`;
      document.body.appendChild(el);
      const $ = (id) => document.getElementById(id), err = (t) => { $('acct-err').textContent = t; };
      const finish = async () => { await this.pull(); el.remove(); done(); };
      $('acct-in').onclick = async () => { err(''); const e = await BOARD.signIn($('acct-u').value, $('acct-p').value); if (e) err(e); else finish(); };
      $('acct-up').onclick = async () => { err(''); const e = await this.signUp($('acct-u').value, $('acct-p').value); if (e) err(e); else finish(); };
      $('acct-p').onkeydown = (e) => { if (e.key === 'Enter') $('acct-in').click(); };
      $('acct-off').onclick = () => { this.offline = true; el.remove(); done(); };
    });
  },
  async signUp(u, p) {
    u = (u || '').trim();
    if (!/^[A-Za-z0-9_.]{3,20}$/.test(u)) return 'Usernames are 3-20 letters, numbers, _ or .';
    if (!p || p.length < 4) return 'Pick a password of at least 4 characters';
    try {
      const r = await fetch(`${BOARD.URL}/rest/v1/shooter_players`, { method: 'POST', headers: Object.assign({ Prefer: 'return=minimal' }, BOARD.headers()), body: JSON.stringify({ username: u, password_hash: await BOARD.hash(u, p) }) });
      if (r.status === 409) return 'That username is taken';
      if (!r.ok) return 'Could not create the account (' + r.status + ')';
      localStorage.setItem(BOARD.CREDS, JSON.stringify({ u, p }));
      PROFILE.dukeUnlock();
      this.push(true); // the new account starts with this browser's progress
      return '';
    } catch (e) { return 'Could not reach the server'; }
  },

  // ---------- cloud saves ----------
  async rpc(fn, args, keepalive) {
    const c = BOARD.creds(); if (!c) return null;
    const r = await fetch(`${BOARD.URL}/rest/v1/rpc/${fn}`, { method: 'POST', keepalive: !!keepalive, headers: BOARD.headers(), body: JSON.stringify(Object.assign({ p_user: c.u, p_hash: await BOARD.hash(c.u, c.p) }, args)) });
    if (!r.ok) throw new Error('HTTP ' + r.status);
    const t = await r.text(); return t ? JSON.parse(t) : null;
  },
  // on sign-in / start: take whichever save is newer (this browser's or your account's)
  async pull() {
    try {
      const cloud = await this.rpc('unf_load', {});
      const local = PROFILE.data || {};
      if (cloud) {
        // never lose anything: start from the newer copy (a brand-new browser profile never counts as newer),
        // then keep every skin, emote and tool either copy has, and the best stats
        const cloudNewer = PROFILE.fresh || (cloud.savedAt || 0) >= (local.savedAt || 0);
        const a = cloudNewer ? cloud : local, b = cloudNewer ? local : cloud, m = Object.assign({}, a);
        const union = (k) => { const s = [...(a[k] || []), ...(b[k] || [])]; if (s.length) m[k] = [...new Set(s)]; };
        union('owned'); union('emotes'); union('tools');
        if (!PROFILE.fresh) {
          m.level = Math.max(a.level || 1, b.level || 1);
          m.stats = Object.assign({}, b.stats || {}, a.stats || {});
          for (const k in (b.stats || {})) if (typeof b.stats[k] === 'number') m.stats[k] = Math.max(m.stats[k] || 0, b.stats[k]);
        }
        m.savedAt = Date.now();
        try { localStorage.setItem('unblockednite_profile', JSON.stringify(m)); } catch (e) { /* storage unavailable */ }
        PROFILE.load();
      }
      this.push(true);
    } catch (e) { /* offline: keep this browser's copy */ }
  },
  // called by PROFILE.save: send it a moment later (several changes in a row go as one request)
  queue() {
    if (this.offline || !BOARD.creds()) return;
    this.pending = true;
    clearTimeout(this.timer);
    this.timer = setTimeout(() => this.push(), 2000);
  },
  async push(now, keepalive) {
    clearTimeout(this.timer);
    if (!BOARD.creds() || this.offline) return;
    this.pending = false;
    try { await this.rpc('unf_save', { p_data: PROFILE.data }, keepalive); } catch (e) { this.pending = true; }
  },
};
// closing or hiding the tab sends anything not saved yet
document.addEventListener('visibilitychange', () => { if (document.hidden && ACCOUNT.pending) ACCOUNT.push(true, true); });
window.addEventListener('pagehide', () => { if (ACCOUNT.pending) ACCOUNT.push(true, true); });

