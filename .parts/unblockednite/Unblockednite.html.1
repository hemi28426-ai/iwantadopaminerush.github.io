    if (WORLD.heightAt(c.pos.x, c.pos.z) < 1.5 || c.inWater) { u.target = null; u.wanderTo = null; BOTS.moveTo(c, u.home.x, u.home.z, dt); return; }
    if (!t || !t.alive) {
