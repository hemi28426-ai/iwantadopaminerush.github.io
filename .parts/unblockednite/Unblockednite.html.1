    this.at = new THREE.Vector3(0, 0, 0);
    this.t = 0; this.on = true; this.phase = 0; this.lastPick = {}; this.done = {}; this.boarded = null;
    const actor = (outfit, size, x, z, name, planner) => {
      const c = CHARS.create({ name, colors: BOSS.outfitOf(outfit) });
      BOSS.giveBody(c, outfit, size); c.state = 'ground'; c.onGround = true; c.alive = true;
      c.slots[0] = { kind: 'weapon', id: 'beam_thanos', rarity: 5, mag: 9999, special: true }; c.sel = 0; c.isBoss = true;
      c.armT = 0; c.armMode = null; c.cineArms = (m, sw) => this.arms(c, m, sw); c.plan = []; c.fly = 0; c.flyTo = 0; c.cineAnim = { key: 'idle', rate: 1 };
      c.pos.set(x, 0, z); c.planner = planner; c.simSize = size; c.away = true; c.fullDetail = true;
