'use strict';
// ===== Synthesized sound effects (WebAudio, no files needed) =====
const SFX = {
  ctx: null, master: null, noiseBuf: null,
  listener: null, listenerRight: null,
  init() {
    if (this.ctx) { if (this.ctx.state === 'suspended') this.ctx.resume(); return; }
    try {
      const AC = window.AudioContext || window.webkitAudioContext;
      this.ctx = new AC();
      this.master = this.ctx.createGain();
      this.master.gain.value = SETTINGS.volume;
      this.master.connect(this.ctx.destination);
      const len = this.ctx.sampleRate * 1.5;
      this.noiseBuf = this.ctx.createBuffer(1, len, this.ctx.sampleRate);
      const d = this.noiseBuf.getChannelData(0);
      for (let i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;
      this.listener = new THREE.Vector3();
      this.listenerRight = new THREE.Vector3(1, 0, 0);
    } catch (e) { this.ctx = null; }
  },
  setVolume(v) { if (this.master) this.master.gain.value = v; },

  // ---- primitives ----
  _out(vol, pan) {
    const g = this.ctx.createGain();
    g.gain.value = vol;
    if (pan !== 0 && this.ctx.createStereoPanner) {
      const p = this.ctx.createStereoPanner();
      p.pan.value = pan; g.connect(p); p.connect(this.master);
    } else g.connect(this.master);
    return g;
  },
  _noise(out, dur, type, f0, f1, vol, delay = 0) {
    const c = this.ctx, t = c.currentTime + delay;
    const src = c.createBufferSource(); src.buffer = this.noiseBuf;
    const f = c.createBiquadFilter(); f.type = type; f.frequency.setValueAtTime(f0, t);
    if (f1 !== f0) f.frequency.exponentialRampToValueAtTime(Math.max(20, f1), t + dur);
    const g = c.createGain(); g.gain.setValueAtTime(vol, t); g.gain.exponentialRampToValueAtTime(0.001, t + dur);
    src.connect(f); f.connect(g); g.connect(out);
    src.start(t, Math.random() * 0.5); src.stop(t + dur + 0.05);
  },
  _tone(out, dur, wave, f0, f1, vol, delay = 0) {
    const c = this.ctx, t = c.currentTime + delay;
    const o = c.createOscillator(); o.type = wave; o.frequency.setValueAtTime(f0, t);
    if (f1 !== f0) o.frequency.exponentialRampToValueAtTime(Math.max(20, f1), t + dur);
    const g = c.createGain(); g.gain.setValueAtTime(0.0001, t);
    g.gain.exponentialRampToValueAtTime(vol, t + 0.008);
    g.gain.exponentialRampToValueAtTime(0.001, t + dur);
    o.connect(g); g.connect(out); o.start(t); o.stop(t + dur + 0.05);
  },

  // volume and stereo pan of a sound at pos (null: your own sound), or null when it's too far to hear
  place(vol, pos, maxD = 260) {
    if (!this.ctx || this.ctx.state !== 'running') return null;
    let pan = 0;
    if (pos) {
      const dx = pos.x - this.listener.x, dy = pos.y - this.listener.y, dz = pos.z - this.listener.z;
      const d = Math.sqrt(dx * dx + dy * dy + dz * dz);
      if (d > maxD) return null;
      vol *= Math.pow(1 - d / maxD, 2) * (1 / (1 + d / 30));
      if (vol < 0.01) return null;
      if (d > 0.5) pan = clamp((dx * this.listenerRight.x + dz * this.listenerRight.z) / d, -1, 1) * 0.8;
    }
    return { vol, pan };
  },
  play(name, vol = 1, pos = null) {
    const p = this.place(vol, pos, (name === 'sniper' || name === 'explode') ? 500 : 260);
    if (!p) return;
    const o = this._out(p.vol, p.pan);
    switch (name) {
      case 'ar': this._noise(o, 0.13, 'lowpass', 3200, 600, 0.55); this._tone(o, 0.09, 'triangle', 150, 50, 0.5); break;
      case 'smg': this._noise(o, 0.07, 'bandpass', 2200, 900, 0.5); this._tone(o, 0.05, 'square', 220, 90, 0.15); break;
      case 'pistol': this._noise(o, 0.1, 'lowpass', 3500, 700, 0.45); this._tone(o, 0.08, 'triangle', 260, 90, 0.4); break;
      case 'shotgun': this._noise(o, 0.38, 'lowpass', 1600, 200, 0.95); this._tone(o, 0.25, 'sine', 95, 35, 0.9); break;
      case 'sniper': this._noise(o, 0.6, 'lowpass', 5000, 250, 0.8); this._tone(o, 0.05, 'sawtooth', 1800, 300, 0.25); this._tone(o, 0.4, 'sine', 80, 30, 0.9); break;
      case 'laser': this._tone(o, 0.07, 'sawtooth', 1800, 900, 0.12); this._tone(o, 0.05, 'sine', 2600, 2400, 0.08); break;
      case 'cannon': this._noise(o, 0.3, 'lowpass', 3800, 300, 0.8); this._tone(o, 0.22, 'sine', 120, 40, 0.8); break;
      case 'rocket': this._noise(o, 0.7, 'bandpass', 300, 2500, 0.6); this._tone(o, 0.3, 'sawtooth', 120, 60, 0.2); break;
      case 'explode': this._noise(o, 1.2, 'lowpass', 900, 60, 1.0); this._tone(o, 0.8, 'sine', 70, 22, 1.0); break;
      case 'pickaxe': this._tone(o, 0.09, 'square', 320, 110, 0.25); this._noise(o, 0.06, 'highpass', 2500, 2500, 0.3); break;
      case 'swing': this._noise(o, 0.15, 'bandpass', 600, 1800, 0.18); break;
      case 'hit': this._tone(o, 0.06, 'sine', 950, 1300, 0.35); break;
      case 'headshot': this._tone(o, 0.09, 'sine', 1500, 2200, 0.4); this._tone(o, 0.12, 'triangle', 2400, 2600, 0.2, 0.03); break;
      case 'shieldhit': this._tone(o, 0.1, 'triangle', 700, 500, 0.35); this._noise(o, 0.08, 'highpass', 4000, 4000, 0.15); break;
      case 'shieldbreak': this._noise(o, 0.35, 'highpass', 3000, 6000, 0.5); this._tone(o, 0.3, 'triangle', 900, 200, 0.4); break;
      case 'hurt': this._tone(o, 0.15, 'sawtooth', 220, 110, 0.25); break;
      case 'build': this._tone(o, 0.07, 'triangle', 240, 360, 0.3); this._noise(o, 0.05, 'bandpass', 1200, 1200, 0.15); break;
      case 'destroy': this._noise(o, 0.3, 'lowpass', 1400, 200, 0.6); this._tone(o, 0.15, 'square', 140, 60, 0.15); break;
      case 'chest': [660, 880, 1100, 1320, 1760].forEach((f, i) => this._tone(o, 0.25, 'sine', f, f, 0.2, i * 0.06)); break;
      case 'pickup': this._tone(o, 0.09, 'sine', 520, 980, 0.3); break;
      case 'reload': this._noise(o, 0.04, 'highpass', 3000, 3000, 0.3); this._noise(o, 0.05, 'highpass', 2000, 2000, 0.35, 0.18); break;
      case 'empty': this._tone(o, 0.03, 'square', 1200, 1200, 0.1); break;
      case 'elim': [523, 659, 784].forEach((f, i) => this._tone(o, 0.35, 'triangle', f, f, 0.25, i * 0.05)); break;
      case 'heal': this._tone(o, 0.35, 'sine', 400, 900, 0.25); this._tone(o, 0.35, 'sine', 600, 1200, 0.15, 0.1); break;
      case 'shield': this._tone(o, 0.4, 'triangle', 500, 1500, 0.22); break;
      case 'storm': this._noise(o, 0.5, 'lowpass', 300, 150, 0.35); this._tone(o, 0.3, 'sawtooth', 70, 50, 0.15); break;
      case 'glide': this._noise(o, 0.9, 'lowpass', 500, 900, 0.25); break;
      case 'horn': this._tone(o, 0.35, 'sawtooth', 330, 330, 0.18); this._tone(o, 0.45, 'sawtooth', 262, 262, 0.18, 0.35); break;
      case 'click': this._tone(o, 0.04, 'sine', 800, 600, 0.2); break;
      case 'engine': this._tone(o, 0.2, 'sawtooth', 70 + vol * 160, 60 + vol * 150, 0.08); break;
      case 'victory': [523, 659, 784, 1046, 784, 1046, 1318].forEach((f, i) => this._tone(o, 0.4, 'triangle', f, f, 0.3, i * 0.12)); break;
      case 'death': [392, 330, 262, 196].forEach((f, i) => this._tone(o, 0.4, 'triangle', f, f * 0.95, 0.3, i * 0.16)); break;
      case 'stormwarn': this._tone(o, 0.6, 'sine', 300, 600, 0.25); this._tone(o, 0.6, 'sine', 300, 600, 0.25, 0.7); break;
    }
  },
};

// ---- textures.js ----
'use strict';
// ===== Procedural canvas textures + shared materials =====
const TEX = {};
const MATS = {};

function canvasTex(size, draw) {
  const c = document.createElement('canvas');
  c.width = c.height = size;
  const g = c.getContext('2d');
  draw(g, size);
  const t = new THREE.CanvasTexture(c);
  t.wrapS = t.wrapT = THREE.RepeatWrapping;
  t.anisotropy = 4;
  return t;
}

function makeTextures() {
  TEX.wood = canvasTex(128, (g, s) => {
    g.fillStyle = '#b07a43'; g.fillRect(0, 0, s, s);
    for (let i = 0; i < 4; i++) {
      const y = i * 32;
      g.fillStyle = ['#b9824a', '#a8723c', '#c08a50', '#a26d3a'][i];
      g.fillRect(0, y + 1, s, 30);
      g.strokeStyle = 'rgba(70,40,15,0.35)'; g.lineWidth = 1;
      for (let k = 0; k < 6; k++) {
        g.beginPath(); const yy = y + 4 + k * 4.5 + Math.random() * 2;
        g.moveTo(0, yy); g.bezierCurveTo(40, yy + 2, 80, yy - 2, s, yy + 1); g.stroke();
      }
      g.fillStyle = '#5a3615'; g.fillRect(0, y, s, 2);
      g.fillStyle = '#4a2c10'; g.beginPath(); g.arc(8, y + 16, 2, 0, TAU); g.arc(s - 8, y + 16, 2, 0, TAU); g.fill();
    }
  });
  // ground detail: soft light/dark speckles and little blade strokes (multiplied with the terrain colors)
  TEX.grass = canvasTex(256, (g, s) => {
    g.fillStyle = '#e6e6e6'; g.fillRect(0, 0, s, s);
    for (let i = 0; i < 2600; i++) {
      const v = 190 + Math.floor(Math.random() * 65);
      g.fillStyle = `rgb(${v},${v},${v})`;
      const x = Math.random() * s, y = Math.random() * s;
      g.fillRect(x, y, 1 + Math.random() * 2, 2 + Math.random() * 4);
    }
    for (let i = 0; i < 260; i++) { g.fillStyle = 'rgba(255,255,255,0.35)'; g.fillRect(Math.random() * s, Math.random() * s, 1, 3); }
  });
  TEX.grass.wrapS = TEX.grass.wrapT = THREE.RepeatWrapping;
  TEX.brick = canvasTex(128, (g, s) => {
    g.fillStyle = '#cfc6b8'; g.fillRect(0, 0, s, s);
    const bh = 16, bw = 32;
    for (let r = 0; r < s / bh; r++) {
      const off = (r % 2) * bw / 2;
      for (let c = -1; c < s / bw + 1; c++) {
        const shade = 150 + Math.random() * 40;
        g.fillStyle = `rgb(${shade + 30},${shade * 0.45},${shade * 0.32})`;
        g.fillRect(c * bw + off + 1.5, r * bh + 1.5, bw - 3, bh - 3);
      }
    }
  });
  TEX.metal = canvasTex(128, (g, s) => {
    const grd = g.createLinearGradient(0, 0, s, s);
    grd.addColorStop(0, '#9aa3ad'); grd.addColorStop(1, '#7d8792');
    g.fillStyle = grd; g.fillRect(0, 0, s, s);
    g.strokeStyle = '#5b636c'; g.lineWidth = 3; g.strokeRect(2, 2, s - 4, s - 4);
    g.beginPath(); g.moveTo(s / 2, 0); g.lineTo(s / 2, s); g.stroke();
    g.fillStyle = '#4c535b';
    for (const [x, y] of [[8, 8], [s - 8, 8], [8, s - 8], [s - 8, s - 8], [s / 2 - 6, 8], [s / 2 + 6, s - 8]]) { g.beginPath(); g.arc(x, y, 2.5, 0, TAU); g.fill(); }
    g.strokeStyle = 'rgba(255,255,255,0.08)'; g.lineWidth = 1;
    for (let i = 0; i < 40; i++) { const y = Math.random() * s; g.beginPath(); g.moveTo(0, y); g.lineTo(s, y + 2); g.stroke(); }
  });
  TEX.siding = canvasTex(128, (g, s) => {
    g.fillStyle = '#ffffff'; g.fillRect(0, 0, s, s);
    for (let i = 0; i < 8; i++) {
      const y = i * 16;
      const grd = g.createLinearGradient(0, y, 0, y + 16);
      grd.addColorStop(0, '#ffffff'); grd.addColorStop(1, '#d9d9d9');
      g.fillStyle = grd; g.fillRect(0, y, s, 16);
      g.fillStyle = '#b5b5b5'; g.fillRect(0, y + 15, s, 1);
    }
  });
  TEX.roof = canvasTex(128, (g, s) => {
    g.fillStyle = '#ffffff'; g.fillRect(0, 0, s, s);
    for (let r = 0; r < 8; r++) for (let c = 0; c < 9; c++) {
      const v = 200 + Math.random() * 55;
      g.fillStyle = `rgb(${v},${v},${v})`;
      g.fillRect(c * 16 - (r % 2) * 8 + 1, r * 16 + 1, 14, 14);
    }
  });
  TEX.chest = canvasTex(64, (g, s) => {
    g.fillStyle = '#c98b2e'; g.fillRect(0, 0, s, s);
    g.fillStyle = '#e8b54a'; g.fillRect(0, 0, s, 6); g.fillRect(0, s - 6, s, 6); g.fillRect(0, 0, 6, s); g.fillRect(s - 6, 0, 6, s);
    g.fillStyle = '#ffe28a'; g.fillRect(s / 2 - 5, s / 2 - 7, 10, 14);
  });
  TEX.locker = canvasTex(64, (g, s) => {
    g.fillStyle = '#ffffff'; g.fillRect(0, 0, s, s);
    g.fillStyle = '#cccccc'; for (let i = 0; i < 4; i++) g.fillRect(14, 6 + i * 5, s - 28, 2);
    g.fillStyle = '#999999'; g.fillRect(s - 14, s / 2 - 6, 4, 12);
    g.strokeStyle = '#aaaaaa'; g.lineWidth = 2; g.strokeRect(1, 1, s - 2, s - 2);
  });
}

function makeMaterials() {
  makeTextures();
  const L = (o) => new THREE.MeshLambertMaterial(o);
  MATS.build = { wood: L({ map: TEX.wood }), brick: L({ map: TEX.brick }), metal: L({ map: TEX.metal }) };
  MATS.buildGhost = new THREE.MeshBasicMaterial({ color: 0x4fb3ff, transparent: true, opacity: 0.35, depthWrite: false });
  MATS.buildGhostBad = new THREE.MeshBasicMaterial({ color: 0xff4f4f, transparent: true, opacity: 0.3, depthWrite: false });
  // Marvel landmarks: Castle Doom stone, Latverian red roofs, Avengers Tower glass, Doom's airships
  MATS.castle = L({ map: TEX.metal, color: 0xa4a7b0 });
  MATS.castleRoof = L({ color: 0x2c3170 });
  MATS.redRoof = L({ map: TEX.roof, color: 0xc0462f });
  MATS.creamBrick = L({ map: TEX.brick, color: 0xf3e3c8 });
  MATS.glass = L({ map: TEX.metal, color: 0x7fb6f0, emissive: 0x0a1a33 });
  MATS.aSign = L({ color: 0xffffff, emissive: 0x2a5cff });
  MATS.airship = L({ color: 0x3f5b3c });
  MATS.doomGreen = L({ color: 0x1f4d26 });
  MATS.supplyChest = L({ color: 0x2f7bd6, emissive: 0x0a2a55 });
  MATS.vaultChest = L({ color: 0xffd23a, emissive: 0x4a3200 });
  MATS.doomGold = L({ color: 0xc9971f, emissive: 0x1a1000 });
  MATS.carpet = L({ color: 0x6e1414 });
  MATS.doorway = L({ color: 0x141418 });
  MATS.throneStone = L({ color: 0x6d6a72 });
  MATS.castleFloor = L({ color: 0x5d5960 });
  // v1.5 POIs: the prison and the flying aircraft carrier
  MATS.concrete = L({ map: TEX.metal, color: 0xb9b6ae });
  MATS.prisonOrange = L({ color: 0xe8772e });
  MATS.hull = L({ map: TEX.metal, color: 0x67707c });
  MATS.deck = L({ color: 0x3a3e45 });
  MATS.stripe = L({ color: 0xffd23a, emissive: 0x332200 });
  MATS.rotor = L({ color: 0x2b2f36 });
  MATS.airshipDark = L({ color: 0x2b2b30 });
  MATS.houseWalls = [0xf4d58d, 0x9ad1d4, 0xf2a7a7, 0xc5e1a5, 0xffffff, 0xd7b9f0, 0xffc58a].map(c => L({ map: TEX.siding, color: c }));
  MATS.houseBrick = [0xffffff, 0xe0c0b0, 0xc8a090].map(c => L({ map: TEX.brick, color: c }));
  MATS.houseMetal = L({ map: TEX.metal, color: 0xdde4ee });
  MATS.roofs = [0x8d3b2f, 0x3b5d8d, 0x4a6b3a, 0x5b4636, 0x7d2f5c].map(c => L({ map: TEX.roof, color: c }));
  MATS.floorWood = L({ map: TEX.wood, color: 0xd9b48a });
  MATS.foundation = L({ color: 0x9c968c });
  MATS.chest = L({ map: TEX.chest, emissive: 0x3a2400 });
  MATS.chestOpen = L({ color: 0x6b4a1e });
  MATS.locker = [0x3f6fd8, 0xd83f3f, 0x3fb36f, 0xe0b030].map(c => L({ map: TEX.locker, color: c }));
  MATS.trunk = L({ color: 0x7a4f2a });
  MATS.leaves = L({ color: 0xffffff });
  MATS.rock = L({ color: 0xffffff, flatShading: true });
  MATS.dark = L({ color: 0x222428 });
  MATS.gunMetal = L({ color: 0x3a3d42 });
}

// Fortnite landscape layers (grass / sand / rock / dirt) from dist/ground.js
async function loadGround() {
  if (typeof GROUND_TEX === 'undefined') return;
  const load = (src) => new Promise((res) => { const img = new Image(); img.onload = () => res(img); img.onerror = () => res(null); img.src = src; });
  const out = {};
  for (const k in GROUND_TEX) {
    const img = await load(GROUND_TEX[k]);
    if (!img) return;
    const t = new THREE.Texture(img); t.wrapS = t.wrapT = THREE.RepeatWrapping; t.anisotropy = 4; t.needsUpdate = true;
    const cv = document.createElement('canvas'); cv.width = cv.height = 16; const g = cv.getContext('2d'); g.drawImage(img, 0, 0, 16, 16);
    const d = g.getImageData(0, 0, 16, 16).data; let L = 0; for (let i = 0; i < d.length; i += 4) L += (d[i] * 0.3 + d[i + 1] * 0.59 + d[i + 2] * 0.11) / 255;
    t.userData = { lum: L / 256 };
    out[k] = t;
  }
  TEX.ground = out;
}

// ---- physics.js ----
'use strict';
// ===== Collision world: spatial grid of solids, character movement, raycasts =====
// Solid shapes:
//  box : x0,y0,z0,x1,y1,z1
//  cyl : x,z,r,y0,y1        (bounds filled in automatically)
//  ramp: x0,z0,x1,z1,y0,y1,dir  (dir 0:+x rises, 1:+z, 2:-x, 3:-z)
//  cone: x0,z0,x1,z1,y0,y1  (pyramid, apex y1)
const GRAVITY = 28;
const STEP_UP = 0.65;

const PHYS = {
  CELL: 16,
  grid: new Map(),
  stamp: 1,
  _arr: [],
  _arr2: [],

  key(cx, cz) { return (cx + 512) * 1024 + (cz + 512); },
  clear() { this.grid.clear(); this.byKey = new Map(); this._nk = 0; },
  byKey: new Map(), _nk: 0, keying: false,

  add(s) {
    if (s.type === 'cyl') { s.x0 = s.x - s.r; s.x1 = s.x + s.r; s.z0 = s.z - s.r; s.z1 = s.z + s.r; }
    s._stamp = 0; s.alive = true;
    if (this.keying && !s.netKey) { s.netKey = 'w' + (this._nk++); this.byKey.set(s.netKey, s); }
    const C = this.CELL;
    const cx0 = Math.floor(s.x0 / C), cx1 = Math.floor(s.x1 / C);
    const cz0 = Math.floor(s.z0 / C), cz1 = Math.floor(s.z1 / C);
    s._cells = [];
    for (let cx = cx0; cx <= cx1; cx++) for (let cz = cz0; cz <= cz1; cz++) {
      const k = this.key(cx, cz);
      let a = this.grid.get(k);
      if (!a) { a = []; this.grid.set(k, a); }
      a.push(s); s._cells.push(k);
    }
    return s;
  },
  remove(s) {
    if (!s._cells) return;
    for (const k of s._cells) {
      const a = this.grid.get(k);
      if (!a) continue;
      const i = a.indexOf(s);
      if (i >= 0) { a[i] = a[a.length - 1]; a.pop(); }
    }
    s._cells = null; s.alive = false;
  },
  // Fills `out` with unique solids overlapping the xz rectangle.
  query(x0, z0, x1, z1, out) {
    out.length = 0;
    const st = ++this.stamp, C = this.CELL;
    const cx0 = Math.floor(x0 / C), cx1 = Math.floor(x1 / C);
    const cz0 = Math.floor(z0 / C), cz1 = Math.floor(z1 / C);
    for (let cx = cx0; cx <= cx1; cx++) for (let cz = cz0; cz <= cz1; cz++) {
      const a = this.grid.get(this.key(cx, cz));
      if (!a) continue;
      for (let i = 0; i < a.length; i++) {
        const s = a[i];
        if (s._stamp === st) continue;
        s._stamp = st;
        if (s.x1 < x0 || s.x0 > x1 || s.z1 < z0 || s.z0 > z1) continue;
        out.push(s);
      }
    }
    return out;
  },

  rampH(s, x, z) {
    let u;
    switch (s.dir) {
      case 0: u = (x - s.x0) / (s.x1 - s.x0); break;
      case 1: u = (z - s.z0) / (s.z1 - s.z0); break;
      case 2: u = (s.x1 - x) / (s.x1 - s.x0); break;
      default: u = (s.z1 - z) / (s.z1 - s.z0);
    }
    return s.y0 + clamp(u, 0, 1) * (s.y1 - s.y0) + 0.15;
  },
  coneH(s, x, z) {
    const cx = (s.x0 + s.x1) / 2, cz = (s.z0 + s.z1) / 2, h = (s.x1 - s.x0) / 2;
    const d = clamp(Math.max(Math.abs(x - cx), Math.abs(z - cz)) / h, 0, 1);
    return s.y1 - (s.y1 - s.y0) * d;
  },

  // Highest walkable surface under (x,z) that is reachable from feetY.
  groundAt(x, z, r, feetY, arr) {
    let g = WORLD.heightAt(x, z);
    if (g < WORLD.WATER - 1.1) g = WORLD.WATER - 1.1;
    if (!arr) arr = this.query(x - r, z - r, x + r, z + r, this._arr2);
    const rr = r * 0.6;
    for (let i = 0; i < arr.length; i++) {
      const s = arr[i];
      let h = -1e9;
      if (s.type === 'box') {
