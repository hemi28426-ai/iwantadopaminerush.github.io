  // ---------- sim space <-> the island ----------
  map(p) { const D = this.D, K = this.K; return new THREE.Vector3(D.x + p.x * K, 0, D.z + p.z * K).setY(D.y + p.y * K); },
  tr(a, b, col, beam) {
