    return g;
  },
  itemMesh(item) {
    if (item.kind === 'crown') { const g = CROWN.mesh(); g.scale.setScalar(2.2); return g; }
    if (item.kind === 'power' && !PROPS.scenes['item_' + item.id]) { const g = new THREE.Group(); g.add(new THREE.Mesh(new THREE.SphereGeometry(0.32, 16, 12), new THREE.MeshLambertMaterial({ color: 0xe8701e, emissive: 0x3a1500 }))); return g; } // LeBron's basketball
    if (item.kind === 'power') {
      // the boss's own pickup model (keycard, repulsor glove, gauntlet, Seven slider), sized to ~0.7 m
      const g = new THREE.Group(), m = PROPS.scenes['item_' + item.id].clone(), bb = new THREE.Box3().setFromObject(m), sz = bb.getSize(new THREE.Vector3());
      m.scale.setScalar(0.7 / Math.max(sz.x, sz.y, sz.z, 0.01)); m.position.sub(bb.getCenter(new THREE.Vector3()).multiplyScalar(m.scale.x));
      g.add(m); return g;
    }
    if (item.kind === 'card') { const g = new THREE.Group(), m = new THREE.Mesh(GEO.box, new THREE.MeshLambertMaterial({ color: 0x3d9bff, emissive: 0x0a2a55 })); m.scale.set(0.5, 0.7, 0.05); g.add(m); return g; }
    if (item.kind === 'weapon') { const g = this.gunMesh(item.id, item.rarity); g.scale.setScalar(g.userData.real ? (item.id === 'frag' ? 2.2 : g.userData.saber ? 2.4 : 1.1) : 1.4); g.rotation.z = g.userData.saber ? Math.PI / 2 : 0.15; return g; }
    const g = new THREE.Group();
    const box = (w, h, d, color, y = 0) => { const m = new THREE.Mesh(GEO.box, new THREE.MeshLambertMaterial({ color, emissive: color, emissiveIntensity: 0.15 })); m.scale.set(w, h, d); m.position.y = y; g.add(m); return m; };
    if (item.kind === 'cons') {
      if (item.id === 'bandage') { box(0.5, 0.2, 0.3, 0xf2efe6); box(0.52, 0.08, 0.1, 0xd94848, 0.02); }
      else if (item.id === 'medkit') { box(0.6, 0.45, 0.25, 0xf4f4f4); box(0.12, 0.3, 0.27, 0xe53935); box(0.3, 0.1, 0.27, 0xe53935); }
      else {
        const big = item.id === 'big';
        const m = new THREE.Mesh(new THREE.CylinderGeometry(big ? 0.2 : 0.13, big ? 0.24 : 0.15, big ? 0.55 : 0.32, 10), new THREE.MeshLambertMaterial({ color: 0x3ea6ff, emissive: 0x2070ff, emissiveIntensity: 0.4 }));
        g.add(m); box(0.08, 0.12, 0.08, 0xffffff, big ? 0.33 : 0.21);
      }
    } else if (item.kind === 'ammo') { box(0.45, 0.3, 0.3, 0x3d4b2e); box(0.47, 0.08, 0.32, AMMO[item.type].color, 0.05); }
    else if (item.kind === 'mats') { for (let i = 0; i < 3; i++) box(0.6, 0.12, 0.35, MAT_INFO[item.type].color, i * 0.13); }
    return g;
  },

  // ---------- pickups ----------
  spawnPickup(item, x, y, z, pop = true, netId = null) {
    const mesh = new THREE.Group();
    const inner = this.itemMesh(item);
    inner.position.y = 0.45;
    mesh.add(inner);
    const rar = this.rarityOf(item);
    // the glow ring and light beam are shared by every pickup of that rarity (they used to be made,
    // and leaked, per pickup: a 500-player match drops thousands)
    if (!this._ringGeo) {
      this._ringGeo = new THREE.RingGeometry(0.35, 0.55, 20); this._beamGeo = new THREE.CylinderGeometry(0.05, 0.25, 4, 8, 1, true);
      this._ringMat = RARITY.map(R => new THREE.MeshBasicMaterial({ color: R.hex, transparent: true, opacity: 0.55, side: THREE.DoubleSide, depthWrite: false }));
      this._beamMat = RARITY.map(R => new THREE.MeshBasicMaterial({ color: R.hex, transparent: true, opacity: 0.18, depthWrite: false, side: THREE.DoubleSide }));
      this._shared = new Set([...this._ringMat, ...this._beamMat]);
    }
    const ring = new THREE.Mesh(this._ringGeo, this._ringMat[rar]);
    ring.rotation.x = -Math.PI / 2; ring.position.y = 0.03; mesh.add(ring);
    if (item.kind === 'weapon' && rar >= 2) {
      const beam = new THREE.Mesh(this._beamGeo, this._beamMat[rar]);
      beam.position.y = 2; mesh.add(beam);
    }
    mesh.position.set(x, y, z);
    GFX.scene.add(mesh);
    const p = { item, mesh, inner, pos: new THREE.Vector3(x, y, z), vel: new THREE.Vector3(), settled: !pop, t: Math.random() * 10 };
    if (pop) p.vel.set(rand(-2.2, 2.2), rand(5, 7), rand(-2.2, 2.2));
    // network id: loot made the same way on every peer (the island, events) counts up in step;
    // loot only one peer makes (chests they open, things they drop) is announced to the party
    let send = false;
    if (netId) p.id = netId;
    else if (NET.inMatch && !this.quiet) { p.id = NET.me + ':' + (this._pid = (this._pid || 0) + 1); send = true; }
    else p.id = 'g' + (this._gid = (this._gid || 0) + 1);
    if (send) NET.ev({ t: 'ps', id: p.id, it: item, p: [x, y, z], v: [p.vel.x, p.vel.y, p.vel.z], pop: pop ? 1 : 0 });
    this.pickups.push(p);
    return p;
  },
  removePickup(p, remote) {
    if (!remote && !p.dead && NET.inMatch && p.id) NET.ev({ t: 'pr', id: p.id });
    const i = this.pickups.indexOf(p);
    if (i >= 0) this.pickups.splice(i, 1);
    GFX.scene.remove(p.mesh);
    p.mesh.traverse(o => { if (o.material && o.material !== MATS.gunMetal && o.material !== MATS.dark && o.material !== MATS.trunk && !(this._shared && this._shared.has(o.material))) o.material.dispose(); });
    p.dead = true;
  },
  nearestPickup(pos, maxD, filter) {
    let best = null, bd = maxD * maxD;
    for (const p of this.pickups) {
      if (filter && !filter(p)) continue;
      const dx = p.pos.x - pos.x, dy = p.pos.y - pos.y, dz = p.pos.z - pos.z;
      const d2 = dx * dx + dz * dz + dy * dy * 0.5;
      if (d2 < bd) { bd = d2; best = p; }
    }
    return best;
  },
  spawnFloorLoot(x, y, z) {
    const r = WRNG();
    if (r < 0.55) {
      const w = this.rollWeapon(false);
      this.spawnPickup(w, x, y, z, false);
      if (WEAPONS[w.id].ammo) this.spawnPickup({ kind: 'ammo', type: WEAPONS[w.id].ammo, count: AMMO[WEAPONS[w.id].ammo].give }, x + 0.8, y, z + 0.4, false);
    } else if (r < 0.62) this.spawnPickup(this.makeWeapon('frag'), x, y, z, false);
    else if (r < 0.8) this.spawnPickup(this.rollCons(), x, y, z, false);
    else { const t = wpick(['light', 'medium', 'heavy', 'shells', 'light', 'medium']); this.spawnPickup({ kind: 'ammo', type: t, count: AMMO[t].give }, x, y, z, false); }
  },

  // ---------- chests ----------
  addChest(x, y, z, ry) {
    const g = new THREE.Group();
    const base = new THREE.Mesh(GEO.box, MATS.chest); base.scale.set(1.3, 0.6, 0.8); base.position.y = 0.3;
    const lid = new THREE.Group(); lid.position.set(0, 0.6, 0.4);
    const lidM = new THREE.Mesh(GEO.box, MATS.chest); lidM.scale.set(1.3, 0.3, 0.8); lidM.position.set(0, 0.15, -0.4);
    lid.add(lidM); g.add(base, lid);
    g.position.set(x, y, z); g.rotation.y = ry;
    base.castShadow = true;
    WORLD.group.add(g);
    const ch = { pos: new THREE.Vector3(x, y, z), mesh: g, lid, base, lidM, opened: false, cid: this.chests.length };
    if (PROPS.has('fn_chest')) { base.visible = lid.visible = false; this.chestModel(ch, 'fn_chest'); } // the real Fortnite chest
    ch.solid = PHYS.add({ type: 'box', kind: 'chest', x0: x - 0.6, x1: x + 0.6, z0: z - 0.6, z1: z + 0.6, y0: y, y1: y + 0.75, mesh: g, chest: ch });
    this.chests.push(ch);
    return ch;
  },
  // swap a chest's Fortnite model (closed / opened, gold / blue Rare Chest)
  chestModel(ch, id) {
    if (!PROPS.has(id)) return;
    if (ch.model) ch.mesh.remove(ch.model);
    ch.model = PROPS.scenes[id].clone(); ch.model.scale.setScalar(1.35);
    ch.model.traverse((o) => { if (o.isMesh) o.castShadow = true; });
    ch.mesh.add(ch.model);
  },
  // supply drops and blue chests use Fortnite's blue Rare Chest
  makeBlue(ch) { ch.kind = 'rare'; ch.base.material = ch.lidM.material = MATS.supplyChest; this.chestModel(ch, 'fn_rare'); },
  // supply drops land as Fortnite's gold chest
  makeGold(ch) { ch.kind = 'gold'; ch.base.material = ch.lidM.material = MATS.supplyChest; this.chestModel(ch, 'fn_gold'); },
  // blue chests: rare spots (Latveria, the top of Avengers Tower) with supply-drop loot
  addBlueChest(x, y, z, ry) {
    const ch = this.addChest(x, y, z, ry);
    ch.loot = [this.makeWeapon(pick(['ar', 'smg', 'shotgun']), 4), this.makeWeapon(pick(['sniper', 'handcannon', 'minigun', 'quad']), 4), this.makeCons('big', 2), this.makeCons('mini', 3), { kind: 'mats', type: 'brick', count: 100 }, { kind: 'ammo', type: 'medium', count: 60 }];
    this.makeBlue(ch);
    return ch;
  },
  openChest(ch, by, remote) {
    if (ch.opened) return;
    ch.opened = true;
    ch.lid.rotation.x = -1.9;
    ch.base.material = MATS.chestOpen; ch.lidM.material = MATS.chestOpen;
    if (ch.model) this.chestModel(ch, ch.kind === 'rare' ? 'fn_rare_open' : ch.kind === 'gold' ? 'fn_gold_open' : 'fn_chest_open');
    SFX.play('chest', 0.8, by && by.isPlayer ? null : ch.pos);
    if (ch.beam) { WORLD.group.remove(ch.beam); ch.beam = null; }
    // someone else in the party opened it: their loot arrives as pickups over the network
    if (remote) return;
    if (NET.inMatch) NET.ev({ t: 'co', i: ch.cid });
    if (by && by.isPlayer) STATS.event('chest');
    const p = ch.pos;
    // supply drops, vaults and Mythic chests carry fixed loot
    if (ch.loot) { for (const it of ch.loot) this.spawnPickup(it, p.x, p.y + 0.8, p.z, true); FX.sparkle(new THREE.Vector3(p.x, p.y + 0.8, p.z), 0xffd75a); return; }
    const w = this.rollWeapon(true);
    this.spawnPickup(w, p.x, p.y + 0.8, p.z, true);
    const at = WEAPONS[w.id].ammo;
    if (at) this.spawnPickup({ kind: 'ammo', type: at, count: AMMO[at].give }, p.x, p.y + 0.8, p.z, true);
    if (Math.random() < 0.25) this.spawnPickup(this.makeWeapon('frag'), p.x, p.y + 0.8, p.z, true);
    this.spawnPickup(Math.random() < 0.7 ? this.rollCons() : { kind: 'ammo', type: pick(['light', 'medium', 'shells', 'heavy']), count: 20 }, p.x, p.y + 0.8, p.z, true);
    if (Math.random() < 0.6) this.spawnPickup({ kind: 'mats', type: 'wood', count: 30 }, p.x, p.y + 0.8, p.z, true);
    FX.sparkle(new THREE.Vector3(p.x, p.y + 0.8, p.z), 0xffd75a);
  },
  nearestChest(pos, maxD, filter) {
    let best = null, bd = maxD * maxD;
    for (const c of this.chests) {
      if (c.opened || (filter && !filter(c))) continue;
      const dx = c.pos.x - pos.x, dy = c.pos.y - pos.y, dz = c.pos.z - pos.z;
      const d2 = dx * dx + dz * dz + dy * dy;
      if (d2 < bd) { bd = d2; best = c; }
    }
    return best;
  },

  // Drop a character's whole inventory where they fell
  dropAll(c) {
    // in a party only the peer that knows this inventory drops it (the host for bots, you for yourself)
    if (NET.inMatch && !c.isPlayer && (NET.role !== 'host' || c.human)) { for (let i = 0; i < c.slots.length; i++) c.slots[i] = null; return; }
    const p = c.pos;
    for (let i = 0; i < c.slots.length; i++) if (c.slots[i]) { if (!c.slots[i].special) this.spawnPickup(c.slots[i], p.x, p.y + 1, p.z, true); c.slots[i] = null; }
    for (const k in c.ammo) {
      const n = c.isPlayer ? c.ammo[k] : (c.slots.some(s => s && s.kind === 'weapon' && WEAPONS[s.id].ammo === k) ? AMMO[k].give : 0);
      if (n > 0) this.spawnPickup({ kind: 'ammo', type: k, count: Math.min(n, 999) }, p.x, p.y + 1, p.z, true);
    }
    for (const k in c.mats) if (c.mats[k] >= 10) this.spawnPickup({ kind: 'mats', type: k, count: Math.min(c.mats[k], 200) }, p.x, p.y + 1, p.z, true);
    if (c.pw && !c.ultronForm) for (const id of c.pw.kits) this.spawnPickup({ kind: 'power', id }, p.x, p.y + 1.2, p.z, true);
  },

  update(dt) {
    const pulse = 0.25 + 0.2 * Math.sin(G.time * 4);
    MATS.chest.emissiveIntensity = pulse;
    // distant loot and chests are invisible specks: skip drawing (and animating) them
    const cam = GFX.camera.position;
    if ((this._chestT = (this._chestT || 0) - dt) <= 0) {
      this._chestT = 0.25;
      for (const ch of this.chests) ch.mesh.visible = ch.pos.distanceToSquared(cam) < 150 * 150;
    }
    for (const p of this.pickups) {
      const vis = p.pos.distanceToSquared(cam) < 70 * 70;
      // out of range: take it out of the scene entirely so three.js doesn't walk it every frame
      if (vis !== !!p.mesh.parent) { if (vis) GFX.scene.add(p.mesh); else GFX.scene.remove(p.mesh); }
      if (!vis && p.settled) continue;
      p.t += dt;
      if (!p.settled) {
        p.vel.y -= 22 * dt;
        p.pos.addScaledVector(p.vel, dt);
        const g = PHYS.groundAt(p.pos.x, p.pos.z, 0.2, p.pos.y + 0.3);
        if (p.pos.y <= g) { p.pos.y = g; p.settled = true; p.vel.set(0, 0, 0); }
      }
      p.mesh.position.copy(p.pos);
      p.inner.position.y = 0.45 + Math.sin(p.t * 2.5) * 0.08;
      p.inner.rotation.y += dt * 1.4;
    }
  },
  clear() {
    for (const p of this.pickups.slice()) this.removePickup(p, true);
    this.pickups = []; this.chests = []; this._pid = 0; this._gid = 0; this.quiet = false;
  },
};

// ---- build.js ----
'use strict';
// ===== Building: walls, floors, ramps, cones on a 4-unit grid =====
const BUILD = {
  pieces: new Map(),
  growing: [],
  ghost: null,
  MAX_HP: { wood: 150, brick: 250, metal: 350 },
  TIME: { wood: 1.1, brick: 1.7, metal: 2.4 },
  growMats: {},

  init() {
    this.ghost = new THREE.Mesh(GEO.floor, MATS.buildGhost);
    this.ghost.visible = false;
    this.ghost.renderOrder = 5;
    for (const k of ['wood', 'brick', 'metal']) {
      this.growMats[k] = MATS.build[k].clone();
      this.growMats[k].transparent = true; this.growMats[k].opacity = 0.55;
    }
  },
  attachGhost() { if (this.ghost.parent !== GFX.scene) GFX.scene.add(this.ghost); },

  pickMat(c) {
    if (c.mats[c.buildMat] >= 10) return c.buildMat;
    for (const m of ['wood', 'brick', 'metal']) if (c.mats[m] >= 10) return m;
    return null;
  },

  plan(c, type) {
    const fx = -Math.sin(c.yaw), fz = -Math.cos(c.yaw);
    const pitch = c.pitch;
    const base = Math.floor(c.pos.y / 4 + 0.35) * 4;
    const majorX = Math.abs(fx) > Math.abs(fz);
    const p = { type };
    if (type === 'wall') {
      const ix = Math.floor(c.pos.x / 4), iz = Math.floor(c.pos.z / 4);
      const y = base + (pitch > 0.6 ? 4 : 0);
      p.lvl = Math.round(y / 4);
      if (majorX) {
        const ex = ix + (fx > 0 ? 1 : 0);
        p.key = 'W:x:' + ex + ':' + iz + ':' + p.lvl;
        p.solid = { type: 'box', x0: ex * 4 - 0.15, x1: ex * 4 + 0.15, z0: iz * 4, z1: iz * 4 + 4, y0: y, y1: y + 4 };
        p.geo = GEO.wallAlongZ; p.pos = new THREE.Vector3(ex * 4, y + 2, iz * 4 + 2);
      } else {
        const ez = iz + (fz > 0 ? 1 : 0);
        p.key = 'W:z:' + ix + ':' + ez + ':' + p.lvl;
        p.solid = { type: 'box', x0: ix * 4, x1: ix * 4 + 4, z0: ez * 4 - 0.15, z1: ez * 4 + 0.15, y0: y, y1: y + 4 };
        p.geo = GEO.wallAlongX; p.pos = new THREE.Vector3(ix * 4 + 2, y + 2, ez * 4);
      }
      p.check = { x: p.pos.x, z: p.pos.z, top: y + 4 };
      return p;
    }
    let ix, iz;
    if (type === 'floor' && pitch < -1.0) { ix = Math.floor(c.pos.x / 4); iz = Math.floor(c.pos.z / 4); }
    else { ix = Math.floor((c.pos.x + fx * 2.8) / 4); iz = Math.floor((c.pos.z + fz * 2.8) / 4); }
    const cx = ix * 4 + 2, cz = iz * 4 + 2;
    if (type === 'floor') {
      const y = base + (pitch > 0.3 ? 4 : 0);
      p.key = 'F:' + ix + ':' + Math.round(y / 4) + ':' + iz;
      p.solid = { type: 'box', x0: ix * 4, x1: ix * 4 + 4, z0: iz * 4, z1: iz * 4 + 4, y0: y - 0.15, y1: y + 0.15 };
      p.geo = GEO.floor; p.pos = new THREE.Vector3(cx, y, cz);
      p.check = { x: cx, z: cz, top: y + 0.15 };
    } else if (type === 'ramp') {
      const y = base;
      const dir = majorX ? (fx > 0 ? 0 : 2) : (fz > 0 ? 1 : 3);
      p.key = 'R:' + ix + ':' + Math.round(y / 4) + ':' + iz;
      p.solid = { type: 'ramp', x0: ix * 4, x1: ix * 4 + 4, z0: iz * 4, z1: iz * 4 + 4, y0: y, y1: y + 4, dir };
      p.geo = GEO.ramp; p.pos = new THREE.Vector3(cx, y + 2, cz); p.ry = RAMP_RY[dir]; p.rz = Math.PI / 4;
      p.check = { x: cx, z: cz, top: y + 4 };
    } else {
      const y = base + (pitch < -0.3 ? 0 : 4);
      p.key = 'C:' + ix + ':' + Math.round(y / 4) + ':' + iz;
      p.solid = { type: 'cone', x0: ix * 4, x1: ix * 4 + 4, z0: iz * 4, z1: iz * 4 + 4, y0: y, y1: y + 2 };
      p.geo = GEO.cone; p.pos = new THREE.Vector3(cx, y + 1, cz);
      p.check = { x: cx, z: cz, top: y + 2 };
    }
    return p;
  },
  valid(p) {
    if (this.pieces.has(p.key)) return false;
    if (p.check.top < WORLD.heightAt(p.check.x, p.check.z) + 0.3) return false;
    return true;
  },

  place(c, type) {
    const mat = this.pickMat(c);
    if (!mat) return null;
    const p = this.plan(c, type);
    if (!this.valid(p)) return null;
    c.mats[mat] -= 10;
    const mesh = new THREE.Mesh(p.geo, this.growMats[mat]);
    mesh.position.copy(p.pos);
    if (p.ry !== undefined) mesh.rotation.set(0, p.ry, p.rz);
    mesh.castShadow = SETTINGS.quality === 'high'; mesh.receiveShadow = true;
    WORLD.group.add(mesh);
    const s = p.solid;
    s.kind = 'build'; s.mat = mat; s.mesh = mesh; s.key = p.key; s.owner = c;
    s.maxHp = this.MAX_HP[mat]; s.hp = s.maxHp * 0.2; s.destructible = true; s.buildT = 0;
    PHYS.add(s);
    PHYS.byKey.set('b:' + p.key, s);
    this.pieces.set(p.key, s);
    this.growing.push(s);
    if (NET.inMatch) NET.ev({ t: 'bp', key: p.key, mat, pos: [p.pos.x, p.pos.y, p.pos.z], ry: p.ry, rz: p.rz, s: { type: s.type, x0: s.x0, x1: s.x1, z0: s.z0, z1: s.z1, y0: s.y0, y1: s.y1, dir: s.dir } });
    SFX.play('build', c.isPlayer ? 0.7 : 0.5, c.isPlayer ? null : p.pos);
    if (c.isPlayer) STATS.event('build');
    return s;
  },
  // a piece someone else in the party built
  placeRemote(m) {
    if (this.pieces.has(m.key)) return;
    const k = m.key[0], geo = k === 'W' ? (m.key[2] === 'x' ? GEO.wallAlongZ : GEO.wallAlongX) : k === 'F' ? GEO.floor : k === 'R' ? GEO.ramp : GEO.cone;
    const mesh = new THREE.Mesh(geo, this.growMats[m.mat] || this.growMats.wood);
    mesh.position.set(m.pos[0], m.pos[1], m.pos[2]);
    if (m.ry !== undefined && m.ry !== null) mesh.rotation.set(0, m.ry, m.rz || 0);
    mesh.castShadow = SETTINGS.quality === 'high'; mesh.receiveShadow = true;
    WORLD.group.add(mesh);
    const s = Object.assign({}, m.s);
    s.kind = 'build'; s.mat = m.mat; s.mesh = mesh; s.key = m.key; s.owner = null;
    s.maxHp = this.MAX_HP[m.mat] || 150; s.hp = s.maxHp * 0.2; s.destructible = true; s.buildT = 0;
    PHYS.add(s); PHYS.byKey.set('b:' + m.key, s);
    this.pieces.set(m.key, s);
    this.growing.push(s);
    SFX.play('build', 0.5, mesh.position);
  },
  onDamaged(s) { /* hp shown via HUD when aimed at */ },
  removePiece(s) {
    if (this.pieces.get(s.key) === s) this.pieces.delete(s.key);
    const i = this.growing.indexOf(s);
    if (i >= 0) this.growing.splice(i, 1);
  },

  updateGhost(c, type) {
    if (!type) { this.ghost.visible = false; return; }
    const p = this.plan(c, type);
    const ok = this.valid(p) && !!this.pickMat(c);
    this.ghost.geometry = p.geo;
    this.ghost.material = ok ? MATS.buildGhost : MATS.buildGhostBad;
    this.ghost.position.copy(p.pos);
    this.ghost.rotation.set(0, p.ry || 0, p.rz || 0);
    this.ghost.visible = true;
  },

  update(dt) {
    for (let i = this.growing.length - 1; i >= 0; i--) {
      const s = this.growing[i];
      const T = this.TIME[s.mat];
      s.buildT += dt;
      s.hp = Math.min(s.maxHp, s.hp + s.maxHp * 0.8 * dt / T);
      if (s.buildT >= T) { s.mesh.material = MATS.build[s.mat]; this.growing.splice(i, 1); }
    }
  },
  clear() { this.pieces.clear(); this.growing = []; if (this.ghost) this.ghost.visible = false; },
};

// ---- fx.js ----
'use strict';
// ===== Visual effects: tracers, particles, explosions, damage numbers, rockets =====
const FX = {
  tracers: [], parts: [], numbers: [], rockets: [], blasts: [], grenades: [], orbs: [],
  matCache: new Map(),
  numPool: [],

  mat(color, additive) {
    const k = color + (additive ? 'a' : '');
    let m = this.matCache.get(k);
    if (!m) {
      m = new THREE.MeshBasicMaterial({ color, transparent: true, opacity: 1, depthWrite: !additive, blending: additive ? THREE.AdditiveBlending : THREE.NormalBlending });
      this.matCache.set(k, m);
    }
    return m;
  },

  tracer(a, b, color = 0xfff2a8, beam) {
    if (beam) {
      // a glowing beam: thin additive cylinder between the two points
      const len = a.distanceTo(b);
      const m = new THREE.Mesh(new THREE.CylinderGeometry(0.04, 0.04, len, 6, 1, true), new THREE.MeshBasicMaterial({ color, transparent: true, opacity: 0.9, blending: THREE.AdditiveBlending, depthWrite: false }));
      m.position.copy(a).add(b).multiplyScalar(0.5);
      m.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), b.clone().sub(a).normalize());
      GFX.scene.add(m);
      this.tracers.push({ obj: m, life: 0.06, max: 0.06 });
      return;
    }
    const geo = new THREE.BufferGeometry().setFromPoints([a.clone(), b.clone()]);
    const line = new THREE.Line(geo, new THREE.LineBasicMaterial({ color, transparent: true, opacity: 0.85 }));
    GFX.scene.add(line);
    this.tracers.push({ obj: line, life: 0.07, max: 0.07 });
  },
  flash(p, color = 0xffd36b, size = 0.35) {
    const m = new THREE.Mesh(GEO.box, this.mat(color, true));
    m.position.copy(p); m.scale.setScalar(size);
    GFX.scene.add(m);
    this.parts.push({ obj: m, vel: new THREE.Vector3(), life: 0.05, max: 0.05, grav: 0, shrink: false });
  },
  burst(p, color, n, speed, life, size, grav = 18, additive = false) {
    if (this.parts.length > 400) return;
    for (let i = 0; i < n; i++) {
      const m = new THREE.Mesh(GEO.box, this.mat(color, additive));
      m.position.copy(p);
      const s = size * rand(0.6, 1.3); m.scale.setScalar(s);
      m.rotation.set(rand(0, 3), rand(0, 3), rand(0, 3));
      GFX.scene.add(m);
      const v = new THREE.Vector3(rand(-1, 1), rand(-0.2, 1), rand(-1, 1)).normalize().multiplyScalar(speed * rand(0.4, 1));
      const l = life * rand(0.7, 1.2);
      this.parts.push({ obj: m, vel: v, life: l, max: l, grav, shrink: true, base: s });
    }
  },
  impact(p, kind) {
    const color = kind === 'char' ? 0xffffff : kind === 'terrain' ? 0x8a7a5a : 0xd8c8a8;
    this.burst(p, color, 4, 4, 0.3, 0.08);
  },
  debris(p, color, n = 8) { this.burst(p, color, n, 7, 0.8, 0.35); },
  sparkle(p, color) { this.burst(p, color, 14, 5, 0.9, 0.12, -1, true); },

  explosion(p, radius) {
    const m = new THREE.Mesh(new THREE.SphereGeometry(1, 14, 10), new THREE.MeshBasicMaterial({ color: 0xffa040, transparent: true, opacity: 0.9, blending: THREE.AdditiveBlending, depthWrite: false }));
    m.position.copy(p); GFX.scene.add(m);
    this.blasts.push({ obj: m, t: 0, r: radius });
    this.burst(p, 0xff7a1a, 16, 12, 0.7, 0.4, 4, true);
    this.burst(p, 0x555555, 12, 6, 1.4, 0.7, -2);
    SFX.play('explode', 1, p);
    if (G.player) { const d = p.distanceTo(G.player.pos); if (d < 40) G.shake = Math.max(G.shake, (1 - d / 40) * 0.8); }
  },

  // ---------- damage numbers (DOM) ----------
  dmgNumber(pos, amount, type) {
    const host = document.getElementById('dmgnums');
    if (!host) return;
    let el = this.numPool.pop();
    if (!el) { el = document.createElement('div'); el.className = 'dmgnum'; }
    el.textContent = Math.round(amount);
    el.className = 'dmgnum ' + type;
    host.appendChild(el);
    this.numbers.push({ el, pos: pos.clone().add(new THREE.Vector3(rand(-0.4, 0.4), 0, rand(-0.4, 0.4))), life: 0.9 });
  },

  // ---------- rockets ----------
  grenade(owner, origin, vel, W) {
    const m = GUNS.mesh('frag') || new THREE.Mesh(new THREE.SphereGeometry(0.12, 8, 6), new THREE.MeshLambertMaterial({ color: 0x2e4a1e }));
    if (m.userData.real === undefined) m.scale.setScalar(1.6);
    m.position.copy(origin);
    GFX.scene.add(m);
    this.grenades.push({ owner, obj: m, pos: origin.clone(), vel: vel.clone(), life: W.fuse, W });
  },
  rocket(owner, origin, dir, item) {
    const W = WEAPONS[item.id];
    const col = item.color || 0xd04040; // boss blasts are tinted (Doom green, Thanos purple, Iron Man gold)
    const m = new THREE.Mesh(new THREE.CylinderGeometry(0.1, 0.14, 0.7, 8), new THREE.MeshLambertMaterial({ color: col, emissive: item.color ? col : 0x401010 }));
    m.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), dir);
    m.position.copy(origin);
    GFX.scene.add(m);
    this.rockets.push({ owner, obj: m, pos: origin.clone(), vel: dir.clone().multiplyScalar(W.speed), life: 6, dmg: W.dmg[item.rarity], splash: W.splash, buildDmg: W.buildDmg, smokeT: 0 });
  },
  // glowing energy orbs (boss attacks, LeBron's basketballs): o = { color, size, dmg, splash, gravity, home, turn, life, ball }
  orb(owner, origin, vel, o) {
    const g = new THREE.Group(), sz = o.size || 0.35;
    if (o.ball) g.add(new THREE.Mesh(new THREE.SphereGeometry(sz, 14, 10), new THREE.MeshLambertMaterial({ color: 0xe8701e })));
    else {
      g.add(new THREE.Mesh(new THREE.SphereGeometry(sz, 12, 8), new THREE.MeshBasicMaterial({ color: 0xffffff })));
      g.add(new THREE.Mesh(new THREE.SphereGeometry(sz * 1.9, 12, 8), new THREE.MeshBasicMaterial({ color: o.color, transparent: true, opacity: 0.45, depthWrite: false })));
    }
    g.position.copy(origin); GFX.scene.add(g);
    this.orbs.push({ owner, obj: g, pos: origin.clone(), vel: vel.clone(), life: o.life || 5, trailT: 0, o });
  },
  explodeAt(p, owner, dmg, radius, buildDmg) {
    this.explosion(p, radius);
    for (const c of G.chars) {
      if (!c.alive || c.state === 'bus') continue;
      const d = Math.hypot(c.pos.x - p.x, c.pos.y + 0.9 - p.y, c.pos.z - p.z);
      if (d > radius) continue;
      let amt = dmg * (1 - (d / radius) * 0.55) * (owner && owner.dmgMult || 1);
      if (c === owner) { if (owner.isBoss || owner.isSmasher) continue; amt *= 0.5; }
      const push = 9 * (1 - d / radius), hx = c.pos.x - p.x, hz = c.pos.z - p.z, hl = Math.hypot(hx, hz) || 1;
      c.vel.x += hx / hl * push * 1.6; c.vel.z += hz / hl * push * 1.6;
      c.knockT = 0.45 * (1 - d / radius); // briefly lose control so the blast actually throws you
      CHARS.damage(c, amt, owner, { weapon: 'Boom Tube', explosive: true });
      c.vel.y += 6 * (1 - d / radius);
    }
    const arr = PHYS.query(p.x - radius, p.z - radius, p.x + radius, p.z + radius, []);
    for (const s of arr) {
      if (!s.destructible || !s.alive) continue;
      const cx = clamp(p.x, s.x0, s.x1), cz = clamp(p.z, s.z0, s.z1);
      const cy = clamp(p.y, s.y0 !== undefined ? s.y0 : p.y, s.y1 !== undefined ? s.y1 : p.y);
      if (Math.hypot(cx - p.x, cy - p.y, cz - p.z) <= radius * 0.8) WORLD.hitSolid(s, buildDmg, owner, false);
    }
  },

  update(dt) {
    for (let i = this.tracers.length - 1; i >= 0; i--) {
      const t = this.tracers[i]; t.life -= dt;
      t.obj.material.opacity = Math.max(0, t.life / t.max) * 0.85;
      if (t.life <= 0) { GFX.scene.remove(t.obj); t.obj.geometry.dispose(); t.obj.material.dispose(); this.tracers.splice(i, 1); }
    }
    for (let i = this.parts.length - 1; i >= 0; i--) {
      const p = this.parts[i]; p.life -= dt;
      if (p.life <= 0) { GFX.scene.remove(p.obj); if (p.grow) { p.obj.geometry.dispose(); p.obj.material.dispose(); } this.parts.splice(i, 1); continue; }
      p.vel.y -= p.grav * dt;
      p.obj.position.addScaledVector(p.vel, dt);
      // a ring that widens and fades as it flies (Force Push)
      if (p.grow) { const k = 1 - p.life / p.max; p.obj.scale.setScalar(1 + k * p.grow); p.obj.material.opacity = 0.55 * (1 - k); continue; }
      p.obj.rotation.x += dt * 5;
      if (p.shrink) p.obj.scale.setScalar(p.base * Math.max(0.05, p.life / p.max));
    }
    for (let i = this.blasts.length - 1; i >= 0; i--) {
      const b = this.blasts[i]; b.t += dt;
      const k = b.t / 0.45;
      b.obj.scale.setScalar(b.r * (0.3 + k * 0.9));
      b.obj.material.opacity = Math.max(0, 0.9 * (1 - k));
      if (k >= 1) { GFX.scene.remove(b.obj); b.obj.geometry.dispose(); b.obj.material.dispose(); this.blasts.splice(i, 1); }
    }
    for (let i = this.orbs.length - 1; i >= 0; i--) {
      const r = this.orbs[i], o = r.o; r.life -= dt;
      if (o.gravity) r.vel.y -= o.gravity * dt;
      // homing: bend toward the target's chest a little each frame
      if (o.home && o.home.alive) {
        const want = new THREE.Vector3(o.home.pos.x - r.pos.x, o.home.pos.y + 1.1 - r.pos.y, o.home.pos.z - r.pos.z).normalize().multiplyScalar(r.vel.length());
        r.vel.lerp(want, Math.min(1, (o.turn || 2) * dt));
      }
      const step = r.vel.length() * dt, dir = r.vel.clone().normalize();
      const hit = PHYS.raycast(r.pos, dir, step + (o.size || 0.35), { ignore: r.owner });
      if (hit || r.life <= 0) {
        const p = hit ? hit.point : r.pos;
        if (o.ball) { FX.impact(p, 'char'); if (hit && hit.kind === 'char') { CHARS.damage(hit.char, o.dmg * (r.owner && r.owner.dmgMult || 1), r.owner, { weapon: o.name || 'basketball' }); hit.char.vel.addScaledVector(dir.setY(0), 7); hit.char.vel.y = 5; } SFX.play('hit', 0.6, p); }
        else this.explodeAt(p, r.owner, o.dmg, o.splash || 3, o.buildDmg || 120);
        if (o.splash && o.ball) this.explodeAt(p, r.owner, o.dmg * 0.5, o.splash, 60);
        GFX.scene.remove(r.obj); r.obj.traverse((m) => { if (m.geometry) { m.geometry.dispose(); m.material.dispose(); } });
        this.orbs.splice(i, 1);
        continue;
      }
      r.pos.addScaledVector(r.vel, dt);
      r.obj.position.copy(r.pos); if (o.ball) r.obj.rotation.x += dt * 10;
      r.trailT -= dt;
      if (r.trailT <= 0 && !o.ball) { r.trailT = 0.025; this.burst(r.pos, o.color, 1, 0.4, 0.4, 0.2 * (o.size || 0.35) / 0.35, 0, true); }
    }
    for (let i = this.rockets.length - 1; i >= 0; i--) {
      const r = this.rockets[i]; r.life -= dt;
      const step = r.vel.length() * dt;
      const dir = r.vel.clone().normalize();
      const hit = PHYS.raycast(r.pos, dir, step + 0.3, { ignore: r.owner });
      if (hit || r.life <= 0) {
        const p = hit ? hit.point : r.pos;
        this.explodeAt(p, r.owner, r.dmg, r.splash, r.buildDmg);
        GFX.scene.remove(r.obj); r.obj.geometry.dispose(); r.obj.material.dispose();
        this.rockets.splice(i, 1);
        continue;
      }
      r.pos.addScaledVector(r.vel, dt);
      r.obj.position.copy(r.pos);
      r.smokeT -= dt;
      if (r.smokeT <= 0) { r.smokeT = 0.03; this.burst(r.pos, 0xcccccc, 1, 0.5, 0.6, 0.25, -1); }
    }
    // grenades: arc, bounce off the ground and walls, explode when the fuse runs out
    for (let i = this.grenades.length - 1; i >= 0; i--) {
      const g = this.grenades[i]; g.life -= dt;
      if (g.life <= 0) {
        this.explodeAt(g.pos, g.owner, g.W.dmg[0], g.W.splash, g.W.buildDmg);
        GFX.scene.remove(g.obj); this.grenades.splice(i, 1); continue;
      }
      g.vel.y -= 22 * dt;
      const sp = g.vel.length() * dt;
      if (sp > 0.001) {
        const dir = g.vel.clone().normalize();
        const hit = PHYS.raycast(g.pos, dir, sp + 0.15, { chars: false, terrain: false });
        if (hit) { g.vel.multiplyScalar(-0.35); g.vel.y = Math.abs(g.vel.y); }
        else g.pos.addScaledVector(g.vel, dt);
      }
      const ground = PHYS.groundAt(g.pos.x, g.pos.z, 0.1, g.pos.y + 0.2);
      if (g.pos.y < ground + 0.1) { g.pos.y = ground + 0.1; g.vel.y = Math.abs(g.vel.y) * 0.35; g.vel.x *= 0.6; g.vel.z *= 0.6; }
      g.obj.position.copy(g.pos);
      g.obj.rotation.x += dt * 8;
    }
    // damage numbers
    const cam = GFX.camera, w = window.innerWidth, h = window.innerHeight, v = new THREE.Vector3();
    for (let i = this.numbers.length - 1; i >= 0; i--) {
      const n = this.numbers[i]; n.life -= dt;
      if (n.life <= 0) { n.el.remove(); this.numPool.push(n.el); this.numbers.splice(i, 1); continue; }
      n.pos.y += dt * 1.6;
      v.copy(n.pos).project(cam);
      if (v.z > 1) { n.el.style.display = 'none'; continue; }
      n.el.style.display = 'block';
      n.el.style.transform = `translate(${(v.x * 0.5 + 0.5) * w}px, ${(-v.y * 0.5 + 0.5) * h}px) translate(-50%,-50%) scale(${0.8 + n.life * 0.4})`;
      n.el.style.opacity = Math.min(1, n.life * 2.5);
    }
  },
  clear() {
    for (const t of this.tracers) GFX.scene.remove(t.obj);
    for (const p of this.parts) GFX.scene.remove(p.obj);
    for (const b of this.blasts) GFX.scene.remove(b.obj);
    for (const r of this.rockets) GFX.scene.remove(r.obj);
    for (const g of this.grenades) GFX.scene.remove(g.obj);
    this.grenades = [];
    for (const r of this.orbs) GFX.scene.remove(r.obj);
    this.orbs = [];
    for (const n of this.numbers) n.el.remove();
    this.tracers = []; this.parts = []; this.blasts = []; this.rockets = []; this.numbers = [];
  },
};

// ---- travel.js ----
'use strict';
// ===== Getting around the big island: cars, launch pads and ziplines =====
// Cars: E to get in or out, W/S throttle, A/D steer, Space handbrake. They knock trees over, run
//   people down, can be shot to pieces and blow up. The driver's game drives the car; in a party the
//   car follows its driver on everyone else's screen.
// Launch pads: step on one to be thrown high into the sky, then skydive and glide.
// Ziplines: E near a cable to ride it, Space to let go.
const CAR = { len: 4.2, wid: 2.1, max: 34, rev: 10, accel: 15, brake: 30, drag: 3, grip: 1.9 };

const VEH = {
  list: [],
  reset() { this.list = []; },

  // a parked car (built during world generation, so every player gets the same cars)
  spawn(x, z, yaw, color) {
    const g = new THREE.Group();
    const body = new THREE.Mesh(GEO.box, new THREE.MeshLambertMaterial({ color }));
    body.scale.set(2.1, 0.9, 4.2); body.position.y = 0.85; body.castShadow = true;
    const cab = new THREE.Mesh(GEO.box, new THREE.MeshLambertMaterial({ color: 0x9fd3ff }));
    cab.scale.set(1.8, 0.7, 2.0); cab.position.set(0, 1.6, 0.2);
    const lights = new THREE.Mesh(GEO.box, new THREE.MeshBasicMaterial({ color: 0xfff3b0 }));
    lights.scale.set(1.7, 0.18, 0.06); lights.position.set(0, 0.95, -2.12);
    g.add(body, cab, lights);
    const wheels = [];
    for (const [wx, wz] of [[-1, -1.3], [1, -1.3], [-1, 1.3], [1, 1.3]]) { const w = new THREE.Mesh(GEO.wheel, MATS.dark); w.position.set(wx, 0.4, wz); g.add(w); wheels.push(w); }
    WORLD.group.add(g); WORLD.props.push(g);
    const car = { id: this.list.length, mesh: g, wheels, pos: new THREE.Vector3(x, WORLD.heightAt(x, z), z), yaw, speed: 0, steer: 0, driver: null, hp: 400, hitCd: new Map(), alive: true };
    car.solid = PHYS.add({ type: 'box', kind: 'prop', x0: 0, x1: 0, z0: 0, z1: 0, y0: 0, y1: 0, mesh: g, mat: 'metal', hp: 400, maxHp: 400, destructible: true, vehicle: car });
    this.place(car);
    this.list.push(car);
    return car;
  },
  // move the mesh and the collision box to the car's position (tilted to the ground)
  place(car) {
    const p = car.pos, fw = this.fwd(car.yaw), rt = { x: -fw.z, z: fw.x };
    const hF = WORLD.heightAt(p.x + fw.x * 1.6, p.z + fw.z * 1.6), hB = WORLD.heightAt(p.x - fw.x * 1.6, p.z - fw.z * 1.6);
    const hL = WORLD.heightAt(p.x - rt.x * 0.9, p.z - rt.z * 0.9), hR = WORLD.heightAt(p.x + rt.x * 0.9, p.z + rt.z * 0.9);
    p.y = Math.max(WORLD.WATER, (hF + hB + hL + hR) / 4);
    const m = car.mesh;
    m.position.set(p.x, p.y, p.z);
    m.rotation.set(Math.atan2(hF - hB, 3.2), car.yaw, -Math.atan2(hR - hL, 1.8), 'YXZ');
    const c = Math.abs(Math.cos(car.yaw)), s = Math.abs(Math.sin(car.yaw));
    const hx = c * CAR.wid / 2 + s * CAR.len / 2, hz = s * CAR.wid / 2 + c * CAR.len / 2;
    const S = car.solid;
    if (S.alive) PHYS.remove(S);
    S.x0 = p.x - hx; S.x1 = p.x + hx; S.z0 = p.z - hz; S.z1 = p.z + hz; S.y0 = p.y - 0.5; S.y1 = p.y + 1.95;
    if (car.alive) PHYS.add(S);
  },
  fwd(yaw) { return { x: -Math.sin(yaw), z: -Math.cos(yaw) }; },
  nearest(pos, r) {
    let best = null, bd = r * r;
    for (const car of this.list) { if (!car.alive || car.driver) continue; const d = car.pos.distanceToSquared(pos); if (d < bd) { bd = d; best = car; } }
    return best;
  },

  enter(c, car) {
    car.driver = c; c.vehicle = car; c.buildType = null; c.using = null; c.reloading = false; c.ads = false;
    if (c.isPlayer) { PC.camYaw = car.yaw; SFX.play('build', 0.6); }
  },
  exit(c) {
    const car = c.vehicle;
    if (!car) return;
    car.driver = null; c.vehicle = null;
    const fw = this.fwd(car.yaw);
    // step out on the driver's side
    const x = car.pos.x - fw.z * 2.2, z = car.pos.z + fw.x * 2.2;
    c.pos.set(x, Math.max(WORLD.heightAt(x, z), car.pos.y) + 0.6, z);
    c.vel.set(fw.x * car.speed * 0.3, 2, fw.z * car.speed * 0.3);
    c.state = 'ground';
  },

  // the driver's input: f in [-1, 1] throttle, s in [-1, 1] steer, brake on/off
  drive(c, f, s, brake, dt) {
    const car = c.vehicle;
    if (!car || !car.alive) { c.vehicle = null; return; }
    if (brake) car.speed = car.speed > 0 ? Math.max(0, car.speed - CAR.brake * dt) : Math.min(0, car.speed + CAR.brake * dt);
    else if (f > 0) car.speed = Math.min(CAR.max, car.speed + (car.speed < 0 ? CAR.brake : CAR.accel) * dt);
    else if (f < 0) car.speed = Math.max(-CAR.rev, car.speed - (car.speed > 0 ? CAR.brake : CAR.accel * 0.7) * dt);
    else car.speed -= Math.sign(car.speed) * Math.min(Math.abs(car.speed), CAR.drag * dt);
    car.steer = lerp(car.steer, s, Math.min(1, dt * 6));
    const turn = car.steer * CAR.grip * clamp(Math.abs(car.speed) / 10, 0, 1) * Math.sign(car.speed || 1) * (brake ? 1.5 : 1);
    car.yaw = wrapAngle(car.yaw - turn * dt);
    this.move(car, dt);
    c.pos.set(car.pos.x, car.pos.y + 0.6, car.pos.z);
    c.vel.set(0, 0, 0); c.onGround = true; c.state = 'ground';
    c.yaw = car.yaw;
  },
  move(car, dt) {
    if (Math.abs(car.speed) < 0.05) { car.speed = 0; return; }
    const fw = this.fwd(car.yaw), step = car.speed * dt, dir = Math.sign(car.speed);
    const nx = car.pos.x + fw.x * step, nz = car.pos.z + fw.z * step;
    // the nose: water, cliffs and solid things stop the car; trees and wooden builds get flattened
    const px = nx + fw.x * dir * CAR.len / 2, pz = nz + fw.z * dir * CAR.len / 2;
    const hNose = WORLD.heightAt(px, pz);
    if (hNose < 0.4 || hNose - car.pos.y > 2.2) { car.speed *= -0.25; return; }
    const hits = PHYS.query(px - 1.1, pz - 1.1, px + 1.1, pz + 1.1, []);
    for (const s of hits) {
      if (s === car.solid || !s.alive || s.y1 < car.pos.y + 0.3 || s.y0 > car.pos.y + 1.8) continue;
      const inside = px > s.x0 - 0.9 && px < s.x1 + 0.9 && pz > s.z0 - 0.9 && pz < s.z1 + 0.9;
      if (!inside) continue;
      if (s.destructible && (s.kind === 'tree' || s.mat === 'wood') && Math.abs(car.speed) > 9) { WORLD.hitSolid(s, 9999, car.driver, false); car.speed *= 0.7; continue; }
      if (s.vehicle) { this.damage(s.vehicle, Math.abs(car.speed) * 4, car.driver); }
      this.damage(car, Math.abs(car.speed) * 2, null);
      car.speed *= -0.3;
      return;
    }
    car.pos.x = nx; car.pos.z = nz;
    for (const w of car.wheels) w.rotation.x -= step / 0.4;
    this.place(car);
    // run people over
    if (Math.abs(car.speed) > 6 && car.driver) {
      for (const o of G.chars) {
        if (o === car.driver || !o.alive || o.dormant || o.vehicle || o.state !== 'ground') continue;
        if ((car.driver.team && o.team === car.driver.team) || dist2D(o.pos.x, o.pos.z, car.pos.x, car.pos.z) > 2.6 || Math.abs(o.pos.y - car.pos.y) > 2.5) continue;
        if ((car.hitCd.get(o) || 0) > G.time) continue;
        car.hitCd.set(o, G.time + 0.8);
        CHARS.damage(o, Math.abs(car.speed) * 2.4, car.driver, { weapon: 'a car', direct: false });
        o.vel.x += fw.x * car.speed * 0.8; o.vel.z += fw.z * car.speed * 0.8; o.vel.y = 7; o.onGround = false; o.knockT = 0.6;
        SFX.play('destroy', 0.5, o.pos);
      }
    }
  },
  damage(car, amount, by) {
    if (!car.alive) return;
    car.solid.hp -= amount;
    if (car.solid.hp <= 0) this.explode(car, by);
  },
  explode(car, by) {
    if (!car.alive) return;
    car.alive = false; car.solid.alive = false;
    PHYS.remove(car.solid);
    const d = car.driver;
    if (d) { this.exit(d); }
    FX.explodeAt(new THREE.Vector3(car.pos.x, car.pos.y + 1, car.pos.z), by || null, 55, 6, 200);
    if (car.mesh.parent) car.mesh.parent.remove(car.mesh);
  },
  // cars nobody drives roll to a stop; cars driven by friends follow them
  update(dt) {
    for (const car of this.list) {
      if (!car.alive) continue;
      const d = car.driver;
      if (d && (!d.alive || d.vehicle !== car)) { car.driver = null; continue; }
      if (!d && car.speed !== 0) { car.speed -= Math.sign(car.speed) * Math.min(Math.abs(car.speed), 12 * dt); this.move(car, dt); }
      // engine hum for the car you're in
      if (d && d.isPlayer && Math.abs(car.speed) > 1 && (this._hum = (this._hum || 0) - dt) <= 0) { this._hum = 0.18; SFX.play('engine', 0.15 + Math.abs(car.speed) / CAR.max * 0.2); }
    }
  },
  // a remote driver's car follows their character (multiplayer)
  follow(c, id) {
    const car = this.list[id];
    if (!car || !car.alive) return;
    if (car.driver !== c) { if (car.driver) car.driver.vehicle = null; car.driver = c; c.vehicle = car; }
    car.pos.set(c.pos.x, car.pos.y, c.pos.z); car.yaw = c.yaw;
    this.place(car);
  },
};

const PADS = {
  list: [],
  reset() { this.list = []; },
  add(x, z) {
    const y = WORLD.heightAt(x, z);
    const g = new THREE.Group();
    const base = new THREE.Mesh(new THREE.CylinderGeometry(1.6, 1.8, 0.3, 20), new THREE.MeshLambertMaterial({ color: 0x5a2fb8 })); base.position.y = 0.15; base.userData.ownGeo = true;
    const top = new THREE.Mesh(new THREE.CylinderGeometry(1.3, 1.3, 0.06, 20), new THREE.MeshBasicMaterial({ color: 0xb98bff })); top.position.y = 0.33; top.userData.ownGeo = true;
    const arrow = new THREE.Mesh(new THREE.ConeGeometry(0.5, 0.9, 4), new THREE.MeshBasicMaterial({ color: 0xffffff })); arrow.position.y = 1.2; arrow.userData.ownGeo = true;
    g.add(base, top, arrow);
    g.position.set(x, y, z);
    WORLD.group.add(g);
    this.list.push({ x, z, y, arrow });
  },
  update(dt) {
    for (const p of this.list) { p.arrow.position.y = 1.2 + Math.sin(G.time * 3) * 0.2; p.arrow.rotation.y += dt * 2; }
    const c = G.player;
    if (!c || !c.alive || c.state !== 'ground' || c.vehicle || c.zip) return;
    for (const p of this.list) {
      if (dist2D(c.pos.x, c.pos.z, p.x, p.z) < 1.5 && Math.abs(c.pos.y - p.y) < 1.5) { this.launch(c); break; }
    }
  },
  // straight up, then you skydive and glide wherever you like
  launch(c) {
    c.vel.y = 48; c.onGround = false; c.launching = true;
    SFX.play('shield', 0.7);
    FX.sparkle(new THREE.Vector3(c.pos.x, c.pos.y + 0.5, c.pos.z), 0xb98bff);
  },
};

const ZIPS = {
  list: [],
  reset() { this.list = []; },
  // a cable from a to b (pole tops), sagging a little in the middle
  add(a, b) {
    const pole = (p) => { const m = new THREE.Mesh(GEO.box, MATS.dark); m.scale.set(0.35, p.h, 0.35); m.position.set(p.x, p.y + p.h / 2, p.z); WORLD.group.add(m); };
    const A = { x: a.x, z: a.z, y: WORLD.heightAt(a.x, a.z), h: 7 }, B = { x: b.x, z: b.z, y: WORLD.heightAt(b.x, b.z), h: 7 };
    pole(A); pole(B);
    const z = { a: new THREE.Vector3(A.x, A.y + A.h, A.z), b: new THREE.Vector3(B.x, B.y + B.h, B.z) };
    z.len = z.a.distanceTo(z.b);
    const pts = [];
    for (let i = 0; i <= 24; i++) pts.push(this.at(z, i / 24));
    const line = new THREE.Line(new THREE.BufferGeometry().setFromPoints(pts), new THREE.LineBasicMaterial({ color: 0x222222 }));
    line.userData.ownGeo = true;
    WORLD.group.add(line);
    this.list.push(z);
  },
  at(z, t) { const p = z.a.clone().lerp(z.b, t); p.y -= Math.sin(t * Math.PI) * z.len * 0.04; return p; },
  // nearest point on any cable within reach of a character
  near(pos, r = 3) {
    let best = null, bd = r;
    for (const z of this.list) {
      for (let i = 0; i <= 40; i++) {
        const t = i / 40, p = this.at(z, t);
        const d = Math.hypot(p.x - pos.x, (p.y - 1.9) - pos.y, p.z - pos.z);
        if (d < bd) { bd = d; best = { z, t }; }
      }
    }
    return best;
  },
  grab(c, hit) {
    const toB = this.at(hit.z, Math.min(1, hit.t + 0.01)).sub(this.at(hit.z, hit.t));
    const look = new THREE.Vector3(-Math.sin(PC.camYaw), 0, -Math.cos(PC.camYaw));
    // near an end you always ride toward the other end; in the middle, the way you're looking
    const dir = hit.t < 0.15 ? 1 : hit.t > 0.85 ? -1 : (toB.x * look.x + toB.z * look.z >= 0 ? 1 : -1);
    c.zip = { z: hit.z, t: hit.t, dir };
    c.buildType = null;
    SFX.play('pickup', 0.5);
  },
  ride(c, dt) {
    const Z = c.zip, speed = 24 / Z.z.len;
    Z.t += Z.dir * speed * dt;
    const end = Z.t <= 0 || Z.t >= 1;
    Z.t = clamp(Z.t, 0, 1);
    const p = this.at(Z.z, Z.t);
    c.pos.set(p.x, p.y - 1.9, p.z);
    const d = Z.z.b.clone().sub(Z.z.a).multiplyScalar(Z.dir).normalize();
    c.vel.set(d.x * 24, 0, d.z * 24);
    c.yaw = Math.atan2(-d.x, -d.z);
    if (end) this.drop(c);
  },
  drop(c) { c.zip = null; c.vel.y = 5; c.onGround = false; c.state = 'ground'; },
};

// ---- crowns.js ----
'use strict';
// ===== Victory Crowns and Reboot Vans =====
// Crowns: win a match and you start the next one wearing a Victory Crown. If you're eliminated it
//   drops for anyone to grab. Win while wearing one for a Crowned Victory Royale.
// Reboot (Duos / Squads): when a teammate is eliminated they leave a Reboot Card for 90 s. Pick it up,
//   take it to a Reboot Van and hold E for 5 s: they drop back in from the sky with a pistol.

const CROWN = {
  mesh() {
    const g = new THREE.Group(), gold = MATS.doomGold;
    const band = new THREE.Mesh(new THREE.CylinderGeometry(0.2, 0.22, 0.14, 12, 1, true), gold); band.userData.ownGeo = true; g.add(band);
    for (let i = 0; i < 5; i++) {
      const a = (i / 5) * TAU, p = new THREE.Mesh(new THREE.ConeGeometry(0.05, 0.16, 4), gold);
      p.position.set(Math.cos(a) * 0.19, 0.14, Math.sin(a) * 0.19); p.userData.ownGeo = true; g.add(p);
    }
    const gem = new THREE.Mesh(GEO.box, new THREE.MeshBasicMaterial({ color: 0x3d9bff })); gem.scale.setScalar(0.06); gem.position.set(0, 0.02, -0.22); g.add(gem);
    return g;
  },
  // put the crown on (it floats just above the head)
  wear(c) {
    if (c.crownMesh || !c.model) { c.crown = true; return; }
    c.crown = true;
    const m = this.mesh(); m.position.y = 1.98; c.model.root.add(m); c.crownMesh = m;
  },
  remove(c) { c.crown = false; if (c.crownMesh) { c.crownMesh.parent && c.crownMesh.parent.remove(c.crownMesh); c.crownMesh = null; } },
  // match start: whoever won last time is crowned (in a party, each friend's crown comes from the roster)
  begin() {
    for (const c of G.chars) {
      if (!c.human) continue;
      const crowned = c.isPlayer ? PROFILE.data.crowned : !!(NET.roster.find((r) => r.pid === c.peerId) || {}).crowned;
      if (crowned) this.wear(c);
    }
    if (G.player && G.player.crown) setTimeout(() => HUD.toast('You are wearing a Victory Crown. Win again for a Crowned Victory Royale!'), 4500);
  },
  // eliminated while crowned: it drops
  onElim(c) {
    if (!c.crown) return;
    this.remove(c); return;
    this.remove(c);
    ITEMS.spawnPickup({ kind: 'crown' }, c.pos.x, c.pos.y + 0.8, c.pos.z, true);
    if (c.isPlayer) { PROFILE.data.crowned = false; PROFILE.save(); }
  },
};

const REBOOT = {
  vans: [], cards: [],
  reset() { this.vans = []; this.cards = []; },
  // world generation: a van at the edge of about half the named places
  addVan(x, z, ry) {
    const y = WORLD.heightAt(x, z), g = new THREE.Group();
    const body = new THREE.Mesh(GEO.box, new THREE.MeshLambertMaterial({ color: 0x2f6fd6 })); body.scale.set(2.4, 2.2, 5); body.position.y = 1.4; body.castShadow = true; g.add(body);
    const stripe = new THREE.Mesh(GEO.box, new THREE.MeshLambertMaterial({ color: 0xffffff })); stripe.scale.set(2.45, 0.3, 5.05); stripe.position.y = 1.5; g.add(stripe);
    const dish = new THREE.Mesh(new THREE.CylinderGeometry(0.7, 0.2, 0.3, 12), MATS.houseMetal); dish.position.set(0, 2.8, 1); dish.rotation.x = -0.6; dish.userData.ownGeo = true; g.add(dish);
    const light = new THREE.Mesh(GEO.box, new THREE.MeshBasicMaterial({ color: 0x5cff7a })); light.scale.set(0.3, 0.3, 0.3); light.position.set(0, 2.65, -1.6); g.add(light);
    for (const [wx, wz] of [[-1.1, -1.7], [1.1, -1.7], [-1.1, 1.7], [1.1, 1.7]]) { const w = new THREE.Mesh(GEO.wheel, MATS.dark); w.position.set(wx, 0.4, wz); g.add(w); }
    g.position.set(x, y, z); g.rotation.y = ry;
    WORLD.group.add(g);
    PHYS.add({ type: 'box', kind: 'prop', x0: x - 1.6, x1: x + 1.6, z0: z - 1.6, z1: z + 1.6, y0: y - 0.5, y1: y + 2.6 });
    this.vans.push({ id: this.vans.length, x, y, z, light, readyAt: 0 });
  },
  // a squad teammate went down: their card drops (on every peer, from the elimination)
  onElim(c) {
    if (!G.squad || !c.human || !c.team) return;
    const card = { kind: 'card', nid: c.nid, team: c.team, name: c.name, until: G.time + 90 };
    const p = ITEMS.spawnPickup(card, c.pos.x, c.pos.y + 0.6, c.pos.z, true, 'card' + c.nid);
    this.cards.push({ card, pickup: p });
  },
  update(dt) {
    for (const v of this.vans) v.light.material.color.setHex(G.time >= v.readyAt ? 0x5cff7a : 0xff5a5a);
    // cards fade after 90 s
    for (let i = this.cards.length - 1; i >= 0; i--) {
      const k = this.cards[i];
      if (G.time > k.card.until) { if (k.pickup && ITEMS.pickups.includes(k.pickup)) ITEMS.removePickup(k.pickup); this.cards.splice(i, 1); }
    }
  },
  nearVan(pos) { return this.vans.find((v) => dist2D(v.x, v.z, pos.x, pos.z) < 4.5 && Math.abs(v.y - pos.y) < 3); },
  // you held E long enough at a van: bring everyone whose card you carry back
  reboot(c, van) {
    van.readyAt = G.time + 90;
    const ids = c.cards.splice(0);
    SFX.play('chest', 0.8);
    for (const nid of ids) {
      if (NET.client) NET.sendReboot(nid, van.id);
      else this.revive(nid, van.id);
    }
  },
  // (host / solo) a squadmate comes back: they drop in above the van
  revive(nid, vanId) {
    const c = NET.inMatch ? NET.byNid[nid] : G.chars.find((x) => x.nid === nid);
    const van = this.vans[vanId];
    if (!c || c.alive || !van) return;
    if (NET.host) NET.broadcast({ t: 'revive', n: nid, v: vanId });
    this.bringBack(c, van);
  },
  bringBack(c, van) {
    c.alive = true; c.state = 'fall'; c.deathT = 0; c.hp = 100; c.shield = 0; c.netDeadSent = 0;
    c.pos.set(van.x + rand(-3, 3), van.y + 70, van.z + rand(-3, 3)); c.vel.set(0, 0, 0);
    c.slots = [ITEMS.makeWeapon('pistol', 0), null, null, null, null]; c.sel = 0; c.ammo.light = Math.max(c.ammo.light, 48);
    if (c.model) c.model.root.visible = true;
    HUD.killfeedText(`<b>${esc(c.name)}</b> was rebooted`);
    if (c.isPlayer) {
      G.phase = 'playing'; G.awaitReboot = false; PC.spectating = null;
      show('endscreen', false); show('spectate', false);
      HUD.banner('YOU WERE REBOOTED', 'Your team brought you back. Glide down and get a gun!');
      SFX.play('victory', 0.5);
    }
  },
};

// ---- skins.js ----
'use strict';
// ===== Character skins: rigged glTF models (embedded), cloned per player and animated through their bones =====
// Works with any humanoid rig (Unreal/Fortnite, Mixamo, Rigify): it finds the limb bones by name, works out
// which way the model faces and how tall it is, pulls T-posed arms down, then applies the game's limb
// rotations in the character's own space so every skeleton animates the same way.
// The rest of the game rotates simple controller objects (legL, armR, ...) exactly as it did for the old
// block characters; SKINS.sync() turns those rotations into bone rotations each frame.
// (bip01... = Source engine 'ValveBiped' skeletons)
const SKIN_ROLES = {
  thighL: ['thighl', 'leftupleg', 'legleftthigh', 'bip001lthigh', 'bip01lthigh'], thighR: ['thighr', 'rightupleg', 'legrightthigh', 'bip001rthigh', 'bip01rthigh'],
  calfL: ['calfl', 'shinl', 'leftleg', 'legleftknee', 'bip001lcalf', 'bip01lcalf'], calfR: ['calfr', 'shinr', 'rightleg', 'legrightknee', 'bip001rcalf', 'bip01rcalf'],
  upperL: ['upperarml', 'leftarm', 'armleftshoulder02', 'bip001lupperarm', 'bip01lupperarm'], upperR: ['upperarmr', 'rightarm', 'armrightshoulder02', 'bip001rupperarm', 'bip01rupperarm'],
  foreL: ['lowerarml', 'forearml', 'leftforearm', 'armleftelbow', 'bip001lforearm', 'bip01lforearm'], foreR: ['lowerarmr', 'forearmr', 'rightforearm', 'armrightelbow', 'bip001rforearm', 'bip01rforearm'],
  handR: ['handr', 'righthand', 'armrightwrist', 'bip001rhand', 'bip01rhand'], head: ['head', 'spine006', 'headneckupper', 'bip001head', 'bip01head1'],
};
const SKIN_PARENT = { calfL: 'thighL', calfR: 'thighR', foreL: 'upperL', foreR: 'upperR' };
const SKIN_ORDER = ['thighL', 'thighR', 'calfL', 'calfR', 'upperL', 'upperR', 'foreL', 'foreR', 'head'];

// one loader setup for every embedded model: meshopt-compressed geometry needs the decoder
function gltfLoader() { const l = new THREE.GLTFLoader(); if (typeof MeshoptDecoder !== 'undefined') l.setMeshoptDecoder(MeshoptDecoder); return l; }

// Unreal -> glTF bone-local rotation for finger deltas: signs for x/y/z, then which source axis feeds each
const FINGER_CONV = [1, 1, 1, 2, 0, 1];
const SKINS = {
  ready: false, defs: {}, matCache: new Map(),

  async init() {
    if (!THREE.GLTFLoader || !THREE.SkeletonUtils) return false;
    const sources = {};
    if (typeof SKIN_GLB !== 'undefined') for (const id in SKIN_GLB) sources[id] = SKIN_GLB[id];
    if (typeof V1_GLB !== 'undefined') sources.v1 = { hi: V1_GLB };
    for (const id in sources) {
      try {
        const hi = await this.parse(sources[id].hi);
        const lo = sources[id].lo ? await this.parse(sources[id].lo) : null;
        this.defs[id] = this.setup(id, hi, lo);
      } catch (e) { console.warn('skin failed', id, e); }
    }
    this.ready = Object.keys(this.defs).length > 0;
    return this.ready;
  },
  parse(b64) {
    return new Promise((resolve, reject) => {
      const bin = atob(b64), buf = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i++) buf[i] = bin.charCodeAt(i);
      gltfLoader().parse(buf.buffer, '', (g) => resolve(g.scene), reject);
    });
  },
  norm(name) { return name.replace(/_\d+$/, '').toLowerCase().replace(/[^a-z0-9]/g, ''); },
  findBones(root) {
    const all = [];
    root.traverse((o) => { if (o.isBone) all.push(o); });
    const out = {};
    for (const role in SKIN_ROLES) {
      for (const pat of SKIN_ROLES[role]) {
        const exact = all.find((b) => this.norm(b.name) === pat) || all.find((b) => this.norm(b.name).endsWith(pat));
        if (exact) { out[role] = exact.name; break; }
      }
    }
    return out;
  },

  // Measure the template once: facing, scale, and the rest pose in character space.
  setup(id, hiScene, loScene) {
    hiScene.traverse((o) => {
      if (!o.isMesh) return;
      const m = o.material;
      o.userData.matName = m.name || 'mat';
      if (m.map) { m.map.encoding = THREE.LinearEncoding; m.map.needsUpdate = true; }
    });
    const maps = {};
    hiScene.traverse((o) => { if (o.isMesh && o.material.map) maps[o.userData.matName] = o.material.map; });
    if (loScene) loScene.traverse((o) => { if (o.isMesh) o.userData.matName = o.material.name || 'mat'; });
    const boneNames = this.findBones(hiScene);
    // a temporary body -> container -> model stack, like the one each character gets
    const body = new THREE.Group(), container = new THREE.Group();
    body.add(container); container.add(hiScene);
    body.updateMatrixWorld(true);
    const B = {}; hiScene.traverse((o) => { if (o.isBone) B[o.name] = o; });
    const wp = (role) => { const v = new THREE.Vector3(); B[boneNames[role]].getWorldPosition(v); return v; };
    // facing: the model's right is thighR - thighL; forward = up x right
    let yaw = 0;
    if (boneNames.thighL && boneNames.thighR) {
      const right = wp('thighR').sub(wp('thighL')).setY(0).normalize();
      const fwd = new THREE.Vector3(0, 1, 0).cross(right);
      yaw = -Math.atan2(-fwd.x, -fwd.z);
    }
    container.rotation.y = yaw;
    // height from the skinned vertices
    body.updateMatrixWorld(true);
    let minY = 1e9, maxY = -1e9; const v = new THREE.Vector3();
    hiScene.traverse((o) => {
      if (!o.isSkinnedMesh) return;
      // compressed skin weights are normalized integers too; boneTransform() would read them raw
      const sw = o.geometry.attributes.skinWeight;
      if (sw && sw.normalized) {
        const f = new Float32Array(sw.count * 4);
        for (let i = 0; i < sw.count; i++) { let t = 0; for (let k = 0; k < 4; k++) t += (f[i * 4 + k] = sw.getComponent ? sw.getComponent(i, k) : [sw.getX(i), sw.getY(i), sw.getZ(i), sw.getW(i)][k]); if (t > 0) for (let k = 0; k < 4; k++) f[i * 4 + k] /= t; }
        o.geometry.setAttribute('skinWeight', new THREE.BufferAttribute(f, 4));
      }
      const p = o.geometry.attributes.position, step = Math.max(1, Math.floor(p.count / 1500));
      // compressed models store positions as normalized integers; this three.js version reads them raw
      const a = p.array, div = !p.normalized ? 1 : a instanceof Int16Array ? 32767 : a instanceof Uint16Array ? 65535 : a instanceof Int8Array ? 127 : 255;
      for (let i = 0; i < p.count; i += step) { v.fromBufferAttribute(p, i).divideScalar(div); o.boneTransform(i, v); v.applyMatrix4(o.matrixWorld); minY = Math.min(minY, v.y); maxY = Math.max(maxY, v.y); }
    });
    const scale = 1.85 / Math.max(0.01, maxY - minY);
    container.scale.setScalar(scale);
    container.position.y = -minY * scale;
    body.updateMatrixWorld(true);
    // rest orientation of each role bone and of its parent, in character (body) space
    const bodyInv = new THREE.Quaternion();
    const wq = (o) => o.getWorldQuaternion(new THREE.Quaternion()).premultiply(bodyInv);
    const rest = {};
    for (const role of SKIN_ORDER) {
      const b = B[boneNames[role]]; if (!b) continue;
      rest[role] = { local: b.quaternion.clone(), world: wq(b), parent: wq(b.parent) };
    }
    // pose fixes: bring T-posed arms down by the sides and straighten legs
    const fix = {};
    const dirTo = (a, b) => wp(b).sub(wp(a)).normalize();
    const legFix = (thigh, calf, target) => {
      if (!boneNames[thigh] || !boneNames[calf]) return;
