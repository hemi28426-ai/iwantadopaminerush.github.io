    this.ov.style.cssText = 'position:fixed;inset:0;pointer-events:none;z-index:9999;opacity:0;display:grid;place-items:center;text-align:center;font:900 46px system-ui;color:#111;background:#fff';
    document.body.appendChild(this.ov);
    this.bar = document.createElement('div');
    this.bar.style.cssText = 'position:fixed;top:64px;left:50%;transform:translateX(-50%);width:min(520px,84vw);z-index:60;pointer-events:none;font:800 14px system-ui;color:#fff;text-align:center;text-shadow:0 2px 3px #000;display:none';
    this.bar.innerHTML = '<div>INFINITY ULTRON</div><div style="height:12px;margin-top:4px;background:#0008;border-radius:3px;overflow:hidden;border:1px solid #fff4"><div class="fb" style="height:100%;background:linear-gradient(#ff5a5a,#c01818)"></div></div>';
    document.body.appendChild(this.bar);
    this.evacEl = document.createElement('div');
    this.evacEl.style.cssText = 'position:fixed;top:120px;left:50%;transform:translateX(-50%);z-index:60;pointer-events:none;font:900 26px system-ui;color:#ffd84a;text-align:center;text-shadow:0 3px 6px #000;display:none';
    document.body.appendChild(this.evacEl);
    HANG.jetpack = true;
  },
  stop() {
    if (!this.on) return;
    this.on = false; HANG.jetpack = false;
    for (const c of this.all || []) CHARS.removeModel(c);
    for (const g of [this.deathStar, ...(this.destroyers || []), ...(this.pelicans || []), this.gem, this.shield, this.beamMesh, this.blastMesh, this.glow]) if (g) GFX.scene.remove(g);
