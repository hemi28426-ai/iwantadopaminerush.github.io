          if (tint) {
            if (tint.flat) o.material.map = null;
            o.material.color.setRGB(...tint.c);
            if (tint.tile && o.material.map) { o.material.map.wrapS = o.material.map.wrapT = THREE.RepeatWrapping; o.material.map.repeat.set(tint.tile, tint.tile); }
          }
