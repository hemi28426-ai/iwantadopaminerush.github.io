    this.doom = actor('doom', 1.3, -9, 0, 'Doctor Doom', (c) => this.doomPlan(c));
    this.heroes = [actor('ironman', 1.15, 9, 5, 'Iron Man', (c) => this.heroPlan(c, 'laser', 0x9fe9ff)), actor('cap', 1.2, -8, 6, 'Captain America', (c) => this.heroPlan(c, 'combo')),
      actor('hulk', 1.7, 7, -7, 'Hulk', (c) => this.heroPlan(c, 'leap')), actor('strange', 1.15, -7, -7, 'Doctor Strange', (c) => this.heroPlan(c, 'laser', 0xffa030))];
    this.lebron = actor('lebron', 1.25, 0, 13, 'LeBron James', () => [this.face(this.lebron, 0.5)]);
    this.all = [this.ultron, this.doom, ...this.heroes, this.lebron];
    this.ultron.fly = this.ultron.flyTo = 40; this.ultron.away = false; this.ultron.foe = this.doom; this.doom.foe = this.ultron;
