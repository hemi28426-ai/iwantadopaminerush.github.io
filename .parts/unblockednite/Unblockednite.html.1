    }
  },

  // ---------- the sky ----------
  SKY: { top: 0x6a3fb4, horizon: 0xffbfd4, hemiSky: 0xffd8e8, hemiGround: 0x9a4a62, sun: 0xffe6dc },
  sky(on) {
