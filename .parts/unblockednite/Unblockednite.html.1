  },
  damageFrom(attacker, storm) {
    if (!attacker || storm || attacker === PC.c) return;
    const el = document.createElement('div');
    el.className = 'dmgarc';
    this.el.dmgdir.appendChild(el);
    this.dmgDirs.push({ el, src: attacker.pos.clone(), t: 1.2 });
