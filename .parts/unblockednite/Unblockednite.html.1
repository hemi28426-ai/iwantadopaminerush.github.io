  },

  // ---------- move sets ----------
  doomPlan(c) {
    const m = this.pick(c, [['circle', 3], ['combo', 3], ['bolt', 3], ['leap', 2]]);
    if (m === 'circle') return [this.circle(c, 1 + this.rnd() * 0.8, 7), this.face(c, 0.2)];
    if (m === 'combo') return [this.charge(c, 1.6, 11), this.punch(c, 'R'), this.punch(c, 'L', true), this.roll(c, this.rnd() < 0.5 ? 1 : -1)];
