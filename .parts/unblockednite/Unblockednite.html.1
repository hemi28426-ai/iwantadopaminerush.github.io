    if (!this.base) this.base = { top: U.top.value.clone(), horizon: GFX.scene.background.clone(), hemiSky: GFX.hemi.color.clone(), hemiGround: GFX.hemi.groundColor.clone(), sun: GFX.sun.color.clone() };
    const c = on ? Object.fromEntries(Object.entries(this.SKY).map(([k, v]) => [k, new THREE.Color(v)])) : this.base;
