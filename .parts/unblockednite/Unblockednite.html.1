        tree.solid = PHYS.add({ type: 'cyl', kind: 'tree', x: p.x, z: p.z, r: Math.max(0.35, r), y0: p.y - 1, y1: p.y + Math.min(h * 0.6, 9), mat: 'wood', hp: Math.round(90 + h * 6), destructible: true, tree });
