      }
    } else if (yardKind < 0.75 && PROPS.has('hs_hedge')) {
      for (let i = 0; i < nx; i++) {
        if (i === doorI) continue;
        const lx = -hx + G / 2 + i * G, [x, z] = W(lx, hz + 1.6);
