  scatterTrees() {
    const pts = [];
    for (let t = 0; t < 20000 && pts.length < (PERF.on ? 1100 : 3000) * this.AK; t++) {
      const x = wr(-this.HALF, this.HALF), z = wr(-this.HALF, this.HALF);
      const h = this.heightAt(x, z);
