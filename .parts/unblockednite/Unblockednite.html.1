    }
    const L = this.pois.find((p) => p.type === 'latveria');
    if (L) {
      const back = L.roadA + Math.PI, dx = Math.cos(back), dz = Math.sin(back);
      ZIPS.add({ x: L.x + dx * 78, z: L.z + dz * 78 }, { x: L.x + dx * 40, z: L.z + dz * 40 });
    }
    for (let n = 0, t = 0; n < (this.small ? 0 : 5) && t < 400; t++) {
