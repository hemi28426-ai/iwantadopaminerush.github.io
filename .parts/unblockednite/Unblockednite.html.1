  },
  TREE_SCALE: { tree_large: [0.5, 0.68], tree_cherry: [0.5, 0.62], tree_pine_dark: [0.55, 0.8], tree_willow: [0.85, 1.15] },
  scatterFortniteTrees(pts) {
