    const me = G.player;
    if (me && me.pos.y < -3) { const p = WORLD.randomLandPoint(this.center.x, this.center.z, 10); me.pos.set(p.x, WORLD.heightAt(p.x, p.z) + 1, p.z); me.vel.set(0, 0, 0); }
