    this.pelicans = [0, 1, 2].map(() => { const g = prop('sw_pelican', 3.6); if (!g) return null; const w = new THREE.Group(); g.visible = true; g.rotation.x = Math.PI / 2; w.add(g); w.visible = false; GFX.scene.add(w); return w; });
