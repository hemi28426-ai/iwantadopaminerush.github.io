    const m = new THREE.Mesh(geo, new THREE.MeshBasicMaterial({ map: tex, transparent: true, side: THREE.DoubleSide, depthWrite: false, fog: false }));
    m.rotation.set(-Math.PI / 2 + 0.75, 0.3, 0); m.position.y = -420; m.renderOrder = -1; // (centered well below you, so you see its face, not its edge)
