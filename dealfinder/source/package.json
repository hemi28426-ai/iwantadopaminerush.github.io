{
  "name": "deal-finder",
  "productName": "Deal Finder",
  "version": "1.0.0",
  "description": "Finds Facebook Marketplace listings within 125 miles and prices them against eBay, Mercari, OfferUp, Swappa and more.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.landh.dealfinder",
    "productName": "Deal Finder",
    "files": [
      "main.js",
      "scrapers.js",
      "pricing.js",
      "groups.js",
      "ui/**/*"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "DealFinder.exe"
    },
    "directories": {
      "output": "release"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
